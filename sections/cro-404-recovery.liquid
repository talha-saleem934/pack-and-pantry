    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
