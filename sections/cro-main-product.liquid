{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign current = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign start_index = 0
  if current.featured_media
    for m in product.media
      if m.id == current.featured_media.id
        assign start_index = forloop.index0
      endif
    endfor
  endif
  assign info_width = 100 | minus: s.media_width
  assign wa_number = settings.cro_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign on_sale = false
  if current.compare_at_price > current.price
    assign on_sale = true
  endif
  assign first_ratio = product.featured_media.aspect_ratio | default: 1
  if s.gallery_ratio == 'square'
    assign first_ratio = 1
  elsif s.gallery_ratio == 'portrait'
    assign first_ratio = 0.8
  endif
-%}
{{ 'cro-components.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cro-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cro-commerce.js' | asset_url }}" defer="defer"></script>
{% style %}
  #cro-{{ sid }} {
    --cro-accent: {{ s.accent_color }};
    --cro-heading: {{ s.heading_color }};
    --cro-text: {{ s.text_color }};
    --cro-border: {{ s.border_color }};
    --cro-card-bg: {{ s.box_bg }};
    --cro-icon: {{ s.icon_color }};
    --cro-link-hover: {{ s.accent_color }};
    --cro-urgent: {{ s.urgency_color }};
    --cro-badge-bg: {{ s.badge_bg }};
    --cro-badge-text: {{ s.badge_text }};
    --cro-price-color: {{ s.heading_color }};
    --cro-price-sale: {{ s.sale_price_color }};
    --cro-save-bg: {{ s.badge_bg }};
    --cro-save-text: {{ s.badge_text }};
    --cro-star-color: {{ s.star_color }};
    --cro-cd-box-bg: {{ s.cd_box_bg }};
    --cro-cd-digit: {{ s.cd_digit }};
    --cro-cd-label: {{ s.cd_label }};
    --cro-cd-sep: {{ s.cd_digit }};
    --cro-cd-urgent: {{ s.urgency_color }};
    --cro-cd-radius: 10px;
    padding-block: {{ s.padding_top_mobile }}px {{ s.padding_bottom_mobile }}px;
  }
  #cro-{{ sid }} .product__info > div + div { margin-block-start: {{ s.block_gap }}px; }
  #cro-{{ sid }} .product__title { margin: 0; color: var(--cro-heading); font-size: {{ s.title_size_mobile }}px; line-height: 1.15; }
  {%- for block in section.blocks -%}
    {%- if block.type == 'title' %}
  #cro-{{ sid }} .cro-title-{{ block.id }} {
    font-size: {{ block.settings.size_mobile }}px; line-height: {{ block.settings.line_height | divided_by: 100.0 }};
    font-weight: {{ block.settings.weight }}; letter-spacing: {{ block.settings.letter_spacing }}px;
    margin-block: {{ block.settings.margin_top }}px {{ block.settings.margin_bottom }}px;
    {%- if block.settings.color != blank %} color: {{ block.settings.color }};{% endif %}
    {%- if block.settings.uppercase %} text-transform: uppercase;{% endif %}
  }
  @media (min-width: 750px) { #cro-{{ sid }} .cro-title-{{ block.id }} { font-size: {{ block.settings.size_desktop }}px; } }
    {%- endif -%}
  {%- endfor %}

  /* Gallery */
  #cro-{{ sid }} .cro-gallery { display: grid; gap: 12px; min-inline-size: 0; }
  #cro-{{ sid }} .cro-gallery__main { position: relative; min-inline-size: 0; }
  #cro-{{ sid }} .cro-gallery__track { position: relative; display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: var(--radius, 16px); background: {{ s.media_bg }}; }
  #cro-{{ sid }} .cro-gallery__track::-webkit-scrollbar { display: none; }
  #cro-{{ sid }} .cro-gallery__slide { position: relative; flex: 0 0 100%; aspect-ratio: {{ first_ratio }}; overflow: hidden; scroll-snap-align: center; }
  #cro-{{ sid }} .cro-gallery__slide img, #cro-{{ sid }} .cro-gallery__slide video, #cro-{{ sid }} .cro-gallery__slide iframe, #cro-{{ sid }} .cro-gallery__slide model-viewer { display: block; inline-size: 100%; block-size: 100%; object-fit: {{ s.gallery_fit }}; }
  #cro-{{ sid }} .cro-gallery__zoom { display: block; inline-size: 100%; block-size: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; overflow: hidden; }
  #cro-{{ sid }} .cro-gallery__zoom img { transition: transform .25s ease; }
  #cro-{{ sid }} .cro-gallery__zoom.is-zoomed img { transform: scale(2); }
  #cro-{{ sid }} .cro-gallery__nav { position: absolute; inset-block-start: 50%; display: inline-flex; align-items: center; justify-content: center; inline-size: 44px; block-size: 44px; margin-block-start: -22px; padding: 0; border: 0; border-radius: 50%; background: rgba(255, 253, 248, .92); color: #18231F; box-shadow: 0 4px 14px rgba(15, 47, 39, .15); cursor: pointer; }
  #cro-{{ sid }} .cro-gallery__nav[disabled] { opacity: 0; pointer-events: none; }
  #cro-{{ sid }} .cro-gallery__nav--prev { inset-inline-start: 10px; }
  #cro-{{ sid }} .cro-gallery__nav--next { inset-inline-end: 10px; }
  #cro-{{ sid }} .cro-gallery__counter { position: absolute; inset-block-end: 10px; inset-inline-end: 10px; padding: 4px 10px; border-radius: 999px; background: rgba(24, 35, 31, .72); color: #fff; font-size: 12px; font-weight: 700; pointer-events: none; }
  #cro-{{ sid }} .cro-gallery__thumbs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: thin; position: relative; padding-block-end: 2px; }
  #cro-{{ sid }} .cro-gallery__thumb { flex: 0 0 auto; inline-size: 68px; block-size: 68px; padding: 0; border: 2px solid transparent; border-radius: 10px; background: {{ s.media_bg }}; overflow: hidden; cursor: pointer; }
  #cro-{{ sid }} .cro-gallery__thumb img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
  #cro-{{ sid }} .cro-gallery__thumb.is-active { border-color: var(--cro-accent); }
  #cro-{{ sid }} .cro-gallery__thumb-icon { position: absolute; }
  @media (prefers-reduced-motion: reduce) { #cro-{{ sid }} .cro-gallery__zoom img { transition: none; } }

  /* New info blocks */
  #cro-{{ sid }} .cro-badges { display: flex; flex-wrap: wrap; gap: 6px; }
  #cro-{{ sid }} .cro-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; background: var(--cro-badge-bg); color: var(--cro-badge-text); font-size: 12px; font-weight: 700; letter-spacing: .03em; }
  #cro-{{ sid }} .cro-badge--new { background: {{ s.new_badge_bg }}; color: {{ s.new_badge_text }}; }
  #cro-{{ sid }} .cro-badge--best { background: {{ s.best_badge_bg }}; color: {{ s.best_badge_text }}; }
  #cro-{{ sid }} .cro-badge--custom { background: {{ s.custom_badge_bg }}; color: {{ s.custom_badge_text }}; }
  #cro-{{ sid }} .cro-rating { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; color: var(--cro-text); font-size: 14px; text-decoration: none; }
  #cro-{{ sid }} a.cro-rating:hover { color: var(--cro-link-hover); }
  #cro-{{ sid }} .cro-rating .cro-stars { --cro-star-size: 18px; }
  #cro-{{ sid }} .cro-cdbox {
    position: relative; isolation: isolate; overflow: hidden; display: grid; gap: 12px; padding: 16px 18px;
    border-radius: 18px; border: 1px solid rgba(255, 255, 255, .18);
    background: linear-gradient(135deg, {{ s.cd_panel_bg }} 0%, {{ s.cd_panel_bg_2 }} 100%);
    color: {{ s.cd_panel_text }}; box-shadow: 0 14px 34px {{ s.cd_panel_bg | color_modify: 'alpha', 0.28 }};
    margin: 10px 0px;
  }
  #cro-{{ sid }} .cro-cdbox::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(110deg, transparent 35%, rgba(255, 255, 255, .16) 50%, transparent 65%);
    background-size: 250% 100%; animation: cro-shine 3.8s ease-in-out infinite;
  }
  #cro-{{ sid }} .cro-cdbox__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; }
  #cro-{{ sid }} .cro-cdbox__label { margin: 0; display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  #cro-{{ sid }} .cro-cdbox__label .cro-icon, #cro-{{ sid }} .cro-cdbox__label .cro-icon-text { color: {{ s.cd_label }}; animation: cro-flicker 1.6s ease-in-out infinite; }
  #cro-{{ sid }} .cro-cdbox__badge { padding: 5px 12px; border-radius: 999px; background: {{ s.cd_badge_bg }}; color: {{ s.cd_badge_text }}; font-size: 13px; font-weight: 800; letter-spacing: .04em; box-shadow: 0 4px 12px rgba(0, 0, 0, .18); }
  #cro-{{ sid }} .cro-cdbox__sub { margin: 0; font-size: 13px; opacity: .9; }
  #cro-{{ sid }} .cro-cdbox .cro-cd { font-size: 15px; }
  #cro-{{ sid }} .cro-cdbox .cro-cd--boxes .cro-cd__unit, #cro-{{ sid }} .cro-cdbox .cro-cd--circular .cro-cd__unit { min-inline-size: 3.7em; padding: .55em .4em; box-shadow: inset 0 -3px 0 rgba(0, 0, 0, .12), 0 6px 14px rgba(0, 0, 0, .16); }
  #cro-{{ sid }} .cro-cdbox .cro-cd--boxes .cro-cd__num, #cro-{{ sid }} .cro-cdbox .cro-cd--circular .cro-cd__num { font-size: 1.75em; letter-spacing: .02em; }
  #cro-{{ sid }} .cro-cdbox .cro-cd__label { text-transform: uppercase; letter-spacing: .08em; font-size: .68em; font-weight: 700; }
  #cro-{{ sid }} .cro-cdbox .cro-cd__sep { font-size: 1.4em; opacity: .85; }
  @media (prefers-reduced-motion: reduce) { #cro-{{ sid }} .cro-cdbox::before, #cro-{{ sid }} .cro-cdbox__label .cro-icon { animation: none; } }
  #cro-{{ sid }} .cro-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  #cro-{{ sid }} .cro-list li { display: flex; align-items: flex-start; gap: 10px; color: var(--cro-text); }
  #cro-{{ sid }} .cro-list .cro-icon, #cro-{{ sid }} .cro-list .cro-icon-text { color: var(--cro-icon); margin-block-start: 2px; }
  #cro-{{ sid }} .cro-scarcity { display: grid; gap: 6px; color: var(--cro-urgent); font-size: 14px; font-weight: 700; }
  #cro-{{ sid }} .cro-scarcity__bar { block-size: 6px; border-radius: 999px; background: {{ s.scarcity_track }}; overflow: hidden; }
  #cro-{{ sid }} .cro-scarcity__fill { block-size: 100%; border-radius: inherit; background: var(--cro-urgent); }
  #cro-{{ sid }} .cro-inline { display: flex; align-items: center; margin: 10px 0px; gap: 8px; margin: 0; color: var(--cro-text); font-size: 14px; }
  #cro-{{ sid }} .cro-inline .cro-icon { color: var(--cro-icon); }
  #cro-{{ sid }} .cro-tbox { padding: 16px;margin: 10px 0px; border-radius: 18px; background: {{ s.tbox_bg }}; border: 1px solid {{ s.tbox_border }}; }
  #cro-{{ sid }} .cro-tbox__head { display: flex; align-items: center; gap: 8px; margin: 0 0 12px; color: var(--cro-heading); font-size: 15px; font-weight: 800; letter-spacing: .02em; }
  #cro-{{ sid }} .cro-tbox__head .cro-icon { color: {{ s.tbox_icon_color }}; }
  #cro-{{ sid }} .cro-tbox__grid { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  #cro-{{ sid }} .cro-tbox__item { position: relative; display: flex; align-items: center; gap: 12px; block-size: 100%; box-sizing: border-box; padding: 12px 14px; border: 1px solid {{ s.tbox_border }}; border-radius: 14px; background: {{ s.tbox_item_bg }}; color: var(--cro-text); text-decoration: none; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  #cro-{{ sid }} .cro-tbox__item--link:hover { transform: translateY(-2px); border-color: var(--cro-accent); box-shadow: 0 8px 20px rgba(15, 47, 39, .10); }
  #cro-{{ sid }} .cro-tbox__ico { display: inline-flex; flex: none; align-items: center; justify-content: center; inline-size: 44px; block-size: 44px; border-radius: 50%; background: {{ s.tbox_icon_bg }}; color: {{ s.tbox_icon_color }}; }
  #cro-{{ sid }} .cro-tbox__body { display: grid; gap: 2px; min-inline-size: 0; flex: 1; }
  #cro-{{ sid }} .cro-tbox__title { color: var(--cro-heading); font-size: 14px; line-height: 1.3; }
  #cro-{{ sid }} .cro-tbox__text { font-size: 13px; line-height: 1.4; opacity: .85; }
  #cro-{{ sid }} .cro-tbox__arrow { display: inline-flex; color: var(--cro-accent); }
  @media (min-width: 480px) { #cro-{{ sid }} .cro-tbox--2 .cro-tbox__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { #cro-{{ sid }} .cro-tbox__item { transition: none; } }
  #cro-{{ sid }} .cro-box { padding: 14px 16px; border: 1px solid var(--cro-border); border-radius: 14px; background: var(--cro-card-bg); }
  #cro-{{ sid }} .cro-box__title { margin: 0 0 10px; color: var(--cro-heading); font-size: 15px; font-weight: 700; }
  #cro-{{ sid }} .cro-delivery { display: grid; gap: 8px; }
  #cro-{{ sid }} .cro-delivery__dates { font-weight: 700; color: var(--cro-heading); }
  #cro-{{ sid }} .cro-delivery:not(.is-ready) [data-cro-delivery-js] { display: none; }
  #cro-{{ sid }} .cro-delivery.is-ready [data-cro-delivery-nojs] { display: none; }
  #cro-{{ sid }} .cro-delivery select, #cro-{{ sid }} .cro-vp__select { min-block-size: 44px; padding: 0 12px; border: 1px solid var(--cro-border); border-radius: 8px; background: #fff; font: inherit; color: var(--cro-heading); }
  #cro-{{ sid }} .cro-qb { display: grid; gap: 8px; }
  #cro-{{ sid }} .cro-qb__tile { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 10px; min-block-size: 52px; padding: 10px 14px; border: 2px solid var(--cro-border); border-radius: 12px; background: #fff; color: var(--cro-heading); font: inherit; text-align: start; cursor: pointer; }
  #cro-{{ sid }} .cro-qb__tile[aria-pressed="true"] { border-color: var(--cro-accent); background: {{ s.box_bg }}; }
  #cro-{{ sid }} .cro-qb__badge { position: absolute; inset-block-start: -10px; inset-inline-end: 12px; padding: 2px 8px; border-radius: 999px; background: var(--cro-badge-bg); color: var(--cro-badge-text); font-size: 11px; font-weight: 700; }
  #cro-{{ sid }} .cro-qb__save { color: var(--cro-price-sale); font-weight: 700; font-size: 14px; }
  #cro-{{ sid }} .cro-vp__options { gap: 8px; }
  #cro-{{ sid }} .cro-vp__opt label { display: inline-flex; align-items: center; gap: 8px; min-block-size: 44px; min-inline-size: 48px; justify-content: center; box-sizing: border-box; }
  #cro-{{ sid }} .cro-vp__opt input:checked + label { border-color: {{ s.option_active_border }}; background: {{ s.option_active_bg }}; color: {{ s.option_active_text }}; }
  #cro-{{ sid }} .cro-vp__opt input:focus-visible + label { outline: 2px solid var(--cro-accent); outline-offset: 2px; }
  #cro-{{ sid }} .cro-vp__opt.is-unavailable label { color: #8A918C; text-decoration: line-through; }
  #cro-{{ sid }} .cro-vp__swatch { inline-size: 28px; block-size: 28px; border-radius: 6px; object-fit: cover; }
  #cro-{{ sid }} .cro-vp__selected { font-weight: 400; color: var(--cro-text); }
  #cro-{{ sid }} .cro-vp__guide { display: inline-flex; align-items: center; min-block-size: 44px; padding: 0; border: 0; background: none; color: var(--cro-heading); font: inherit; text-decoration: underline; cursor: pointer; }
  #cro-{{ sid }} .cro-dialog { inline-size: min(92vw, 720px); max-block-size: 85vh; padding: 24px; border: 0; border-radius: 16px; }
  #cro-{{ sid }} .cro-dialog::backdrop { background: rgba(8, 27, 22, .7); }
  #cro-{{ sid }} .cro-dialog__close { float: inline-end; display: inline-flex; align-items: center; justify-content: center; inline-size: 44px; block-size: 44px; border: 0; border-radius: 50%; background: #F7F1E7; cursor: pointer; }
  #cro-{{ sid }} .cro-buy { display: grid; gap: 10px; }
  #cro-{{ sid }} .cro-buy__atc { display: inline-flex; align-items: center; justify-content: center; gap: 10px; inline-size: 100%; min-block-size: 54px; padding: 0 20px; border: 0; border-radius: {{ s.button_radius }}px; background: {{ s.atc_bg }}; color: {{ s.atc_text }}; font: inherit; font-size: 17px; font-weight: 700; cursor: pointer; transition: background-color .2s ease, transform .2s ease; }
  #cro-{{ sid }} .cro-buy__atc:hover { background: {{ s.atc_hover_bg }}; color: {{ s.atc_hover_text }}; }
  #cro-{{ sid }} .cro-buy__atc[disabled] { opacity: .55; cursor: not-allowed; }
  #cro-{{ sid }} .cro-buy__wa { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-block-size: 50px; padding: 0 20px; border-radius: {{ s.button_radius }}px; background: {{ s.wa_bg }}; color: {{ s.wa_text }}; font-weight: 700; text-decoration: none; }
  #cro-{{ sid }} .cro-buy__wa:hover { background: {{ s.wa_hover_bg }}; }
  #cro-{{ sid }} .cro-buy .shopify-payment-button__button { min-block-size: 50px; border-radius: {{ s.button_radius }}px; }
  #cro-{{ sid }} .cro-share { display: flex; flex-wrap: wrap; align-items: center; margin: 10px 0px; gap: 8px; }
  #cro-{{ sid }} .cro-share__btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-block-size: 44px; padding: 0 14px; border: 1px solid var(--cro-border); border-radius: 999px; background: #fff; color: var(--cro-heading); font: inherit; font-size: 14px; text-decoration: none; cursor: pointer; }
  #cro-{{ sid }} .cro-share__btn:hover { border-color: var(--cro-accent); color: var(--cro-accent); }
  #cro-{{ sid }} .cro-acc { border-block-start: 1px solid var(--cro-border); }
  #cro-{{ sid }} .cro-acc:last-child { border-block-end: 1px solid var(--cro-border); }
  #cro-{{ sid }} .cro-acc summary { display: flex; align-items: center; justify-content: space-between; min-block-size: 52px; color: var(--cro-heading); font-weight: 700; cursor: pointer; list-style: none; }
  #cro-{{ sid }} .cro-acc summary::-webkit-details-marker { display: none; }
  #cro-{{ sid }} .cro-acc summary::after { content: "+"; font-size: 20px; }
  #cro-{{ sid }} .cro-acc[open] summary::after { content: "−"; }
  #cro-{{ sid }} .cro-acc__body { padding-block-end: 16px; }
  #cro-{{ sid }} .cro-ask__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-block-start: 10px; }

  /* Frequently bought together */
  #cro-{{ sid }} .cro-fbt { display: grid; gap: 12px;margin: 10px 0px; padding: 16px; border: 1px solid var(--cro-border); border-radius: 18px; background: {{ s.fbt_bg }}; }
  #cro-{{ sid }} .cro-fbt[hidden] { display: none; }
  #cro-{{ sid }} .cro-fbt__title { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--cro-heading); font-size: 16px; font-weight: 800; }
  #cro-{{ sid }} .cro-fbt__title .cro-icon { color: var(--cro-accent); }
  #cro-{{ sid }} .cro-fbt__items { display: grid; gap: 8px; }
  #cro-{{ sid }} .cro-set__item { display: grid; grid-template-columns: auto 52px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid var(--cro-border); border-radius: 12px; background: #fff; cursor: pointer; }
  #cro-{{ sid }} .cro-set__item:has(input:checked) { border-color: var(--cro-accent); box-shadow: 0 0 0 1px var(--cro-accent) inset; }
  #cro-{{ sid }} .cro-set__item input { inline-size: 20px; block-size: 20px; accent-color: {{ s.atc_bg }}; }
  #cro-{{ sid }} .cro-set__item img { inline-size: 52px; block-size: 52px; border-radius: 8px; object-fit: cover; }
  #cro-{{ sid }} .cro-set__title { color: var(--cro-heading); font-size: 14px; font-weight: 700; text-decoration: none; }
  #cro-{{ sid }} a.cro-set__title:hover { color: var(--cro-accent); }
  #cro-{{ sid }} .cro-set__tag { display: block; font-size: 12px; font-weight: 700; color: var(--cro-accent); }
  #cro-{{ sid }} .cro-set__price { color: var(--cro-heading); font-size: 14px; font-weight: 700; white-space: nowrap; }
  #cro-{{ sid }} .cro-fbt__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  #cro-{{ sid }} .cro-fbt__total { color: var(--cro-heading); font-size: 18px; }
  #cro-{{ sid }} .cro-fbt__btn { min-block-size: 46px; padding: 0 20px; border: 0; border-radius: {{ s.button_radius }}px; background: {{ s.fbt_btn_bg }}; color: {{ s.fbt_btn_text }}; font: inherit; font-weight: 800; cursor: pointer; }
  #cro-{{ sid }} .cro-fbt__btn:hover { filter: brightness(.92); }
  #cro-{{ sid }} .cro-fbt__btn[disabled] { opacity: .5; cursor: not-allowed; }

  /* Sticky add to cart */
  #cro-{{ sid }} .cro-satc { position: fixed; inset-inline: 0; inset-block-end: 0; z-index: 45; padding: 10px var(--gutter, 16px) calc(10px + env(safe-area-inset-bottom, 0px)); background: {{ s.satc_bg }}; color: {{ s.satc_text }}; box-shadow: 0 -8px 24px rgba(15, 47, 39, .14); transform: translateY(110%); transition: transform .3s ease; }
  #cro-{{ sid }} .cro-satc.is-visible { transform: none; }
  #cro-{{ sid }} .cro-satc__inner { display: flex; align-items: center; gap: 12px; max-inline-size: var(--page-width, 1300px); margin-inline: auto; }
  #cro-{{ sid }} .cro-satc__img { inline-size: 48px; block-size: 48px; border-radius: 8px; object-fit: cover; flex: none; }
  #cro-{{ sid }} .cro-satc__info { display: none; min-inline-size: 0; flex: 1; }
  #cro-{{ sid }} .cro-satc__title { display: block; overflow: hidden; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
  #cro-{{ sid }} .cro-satc__variant { display: block; font-size: 13px; opacity: .8; }
  #cro-{{ sid }} .cro-satc__price { font-weight: 700; white-space: nowrap; }
  #cro-{{ sid }} .cro-satc__qty { display: none; align-items: center; border: 1px solid {{ s.satc_border }}; border-radius: 8px; }
  #cro-{{ sid }} .cro-satc__qty button { inline-size: 40px; block-size: 44px; border: 0; background: none; color: inherit; cursor: pointer; }
  #cro-{{ sid }} .cro-satc__qty input { inline-size: 44px; border: 0; background: none; color: inherit; text-align: center; font: inherit; -moz-appearance: textfield; }
  #cro-{{ sid }} .cro-satc__btn { flex: 1; min-block-size: 48px; padding: 0 18px; border: 0; border-radius: {{ s.button_radius }}px; background: {{ s.satc_btn_bg }}; color: {{ s.satc_btn_text }}; font: inherit; font-weight: 700; cursor: pointer; }
  #cro-{{ sid }} .cro-satc__btn:hover { background: {{ s.satc_btn_hover_bg }}; }
  #cro-{{ sid }} .cro-satc__btn[disabled] { opacity: .55; }
  @media (prefers-reduced-motion: reduce) { #cro-{{ sid }} .cro-satc { transition: none; } }
  @media (min-width: 750px) {
    #cro-{{ sid }} { padding-block: {{ s.padding_top_desktop }}px {{ s.padding_bottom_desktop }}px; }
    #cro-{{ sid }} .product__title { font-size: {{ s.title_size_desktop }}px; }
    #cro-{{ sid }} .cro-satc__info { display: block; }
    #cro-{{ sid }} .cro-satc__qty { display: inline-flex; }
    #cro-{{ sid }} .cro-satc__btn { flex: 0 0 auto; min-inline-size: 220px; }
  }
  @media (min-width: 990px) {
    #cro-{{ sid }} .product { grid-template-columns: minmax(0, {{ s.media_width }}fr) minmax(0, {{ info_width }}fr); gap: {{ s.column_gap }}px; }
    #cro-{{ sid }} .product { align-items: start; }
    #cro-{{ sid }} .product__info { position: {% if s.sticky_mode == 'auto' or s.sticky_mode == 'info' %}sticky{% else %}static{% endif %}; top: {{ s.sticky_offset }}px; align-self: start; max-inline-size: {{ s.info_max_width }}px; }
    {%- if s.sticky_mode == 'auto' or s.sticky_mode == 'gallery' %}
    #cro-{{ sid }} .product > .cro-gallery, #cro-{{ sid }} .product > .product__media-grid { position: sticky; top: {{ s.sticky_offset }}px; align-self: start; }
    {%- endif %}
    {%- if s.thumbs_position == 'start' %}
    #cro-{{ sid }} .cro-gallery { grid-template-columns: 76px minmax(0, 1fr); align-items: start; }
    #cro-{{ sid }} .cro-gallery__thumbs { order: -1; flex-direction: column; max-block-size: 640px; overflow-y: auto; overflow-x: hidden; }
    {%- endif %}
    {%- unless s.satc_desktop %}
    #cro-{{ sid }} .cro-satc { display: none; }
    {%- endunless %}
  }
  {%- unless s.satc_mobile %}
  @media (max-width: 749px) { #cro-{{ sid }} .cro-satc { display: none; } }
  {%- endunless %}
{% endstyle %}
{% render 'breadcrumbs' %}
<section id="cro-{{ sid }}" class="section section--compact page-width" data-main-product data-section-id="{{ section.id }}">
  <div class="product">
    {%- if s.gallery_style == 'grid' -%}
      <div class="product__media-grid" aria-label="{{ s.gallery_label | escape }}">
        {%- if media_count > 0 -%}
          {%- for media in product.media -%}
            {%- liquid
              assign media_loading = 'lazy'
              if forloop.first
                assign media_loading = 'eager'
              endif
            -%}
            <div class="product__media-item" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}<button class="product__media-button" type="button" data-media-open data-src="{{ media | image_url: width: 2400 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="{{ s.enlarge_label | escape }} {{ media.alt | default: product.title | escape }}">{{ media | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 55vw, 90vw', loading: media_loading, alt: media.alt | default: product.title }}</button>
                {%- when 'video' -%}{{ media | video_tag: controls: true, preload: 'metadata' }}
                {%- when 'external_video' -%}{{ media | external_video_tag }}
                {%- when 'model' -%}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}<div class="product__media-item placeholder-media">{{ 'product-1' | placeholder_svg_tag }}</div>{%- endif -%}
      </div>
    {%- else -%}
      <div class="cro-gallery" data-cro-gallery data-start="{{ start_index }}" data-zoom="{{ s.enable_zoom }}">
        <div class="cro-gallery__main">
          <div class="cro-gallery__track" data-cro-gallery-track tabindex="0" role="region" aria-label="{{ s.gallery_label | escape }}">
            {%- if media_count > 0 -%}
              {%- for media in product.media -%}
                {%- liquid
                  assign media_loading = 'lazy'
                  assign media_priority = 'auto'
                  if forloop.index0 == start_index
                    assign media_loading = 'eager'
                    assign media_priority = 'high'
                  endif
                -%}
                <div class="cro-gallery__slide" data-cro-gallery-slide data-media-id="{{ media.id }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <button class="cro-gallery__zoom" type="button" data-cro-zoom data-media-open data-src="{{ media | image_url: width: 2400 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="{{ s.enlarge_label | escape }} {{ media.alt | default: product.title | escape }}">
                        {{ media | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', loading: media_loading, fetchpriority: media_priority, alt: media.alt | default: product.title }}
                      </button>
                    {%- when 'video' -%}{{ media | video_tag: controls: true, preload: 'metadata', playsinline: true }}
                    {%- when 'external_video' -%}{{ media | external_video_tag }}
                    {%- when 'model' -%}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="cro-gallery__slide placeholder-media" data-cro-gallery-slide>{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          {%- if media_count > 1 -%}
            <button class="cro-gallery__nav cro-gallery__nav--prev" type="button" data-cro-gallery-prev aria-label="{{ s.prev_label | escape }}">{% render 'cro-icon', icon: 'chevron-left', size: 20 %}</button>
            <button class="cro-gallery__nav cro-gallery__nav--next" type="button" data-cro-gallery-next aria-label="{{ s.next_label | escape }}">{% render 'cro-icon', icon: 'chevron-right', size: 20 %}</button>
            {%- if s.show_counter -%}<span class="cro-gallery__counter" aria-hidden="true"><span data-cro-gallery-current>{{ start_index | plus: 1 }}</span> / {{ media_count }}</span>{%- endif -%}
          {%- endif -%}
        </div>
        {%- if media_count > 1 and s.show_thumbs -%}
          <div class="cro-gallery__thumbs">
            {%- for media in product.media -%}
              <button class="cro-gallery__thumb{% if forloop.index0 == start_index %} is-active{% endif %}" type="button" data-cro-thumb aria-label="{% echo s.thumb_label | replace: '{n}', forloop.index | escape %}">
                {{ media.preview_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', alt: '', width: 80, height: 80 }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="product__info">
      {%- form 'product', product, class: 'product__form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when '@app' -%}{% render block %}
              {%- when 'vendor' -%}{%- if product.vendor != blank -%}<p class="eyebrow">{{ product.vendor }}</p>{%- endif -%}
              {%- when 'title' -%}<h1 class="product__title cro-title-{{ block.id }}">{{ product.title }}</h1>
              {%- when 'price' -%}<div class="price" aria-live="polite"><span class="price__current" data-product-price>{{ current.price | money }}</span>{%- if current.compare_at_price > current.price -%}<s class="price__compare">{{ current.compare_at_price | money }}</s>{%- endif -%}</div>
              {%- when 'sku' -%}
                {%- liquid
                  assign show_sku_line = false
                  if b.show_sku and current.sku != blank
                    assign show_sku_line = true
                  endif
                  if b.show_barcode and current.barcode != blank
                    assign show_sku_line = true
                  endif
                -%}
                {%- if show_sku_line -%}
                  <div class="product__meta">{%- if b.show_sku and current.sku != blank -%}<span>{{ 'products.product.sku' | t }}: <span data-sku>{{ current.sku }}</span></span>{%- endif -%}{%- if b.show_barcode and current.barcode != blank -%}<span>Barcode: {{ current.barcode }}</span>{%- endif -%}</div>
                {%- endif -%}
              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}{%- for option in product.options_with_values -%}<fieldset class="variant-group" data-option-group><legend>{{ option.name }}</legend><div class="variant-options">{%- for value in option.values -%}<div class="variant-option"><input type="radio" id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}><label for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value }}</label></div>{%- endfor -%}</div></fieldset>{%- endfor -%}{%- endunless -%}
              {%- when 'quantity' -%}<label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label><div class="quantity" data-quantity><button type="button" data-quantity-button="minus" aria-label="{{ s.qty_minus_label | escape }}">{% render 'icon', icon: 'minus' %}</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"><button type="button" data-quantity-button="plus" aria-label="{{ s.qty_plus_label | escape }}">{% render 'icon', icon: 'plus' %}</button></div>
              {%- when 'buy_buttons' -%}<div class="product__buttons"><button class="button button--full" type="submit" name="add" data-cro-main-atc data-add="{{ 'products.product.add_to_cart' | t }}" data-sold="{{ 'products.product.sold_out' | t }}" data-unavailable="{{ 'products.product.unavailable' | t }}"{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>{%- if b.dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}</div>
              {%- when 'description' -%}{%- if product.description != blank -%}<div class="rte">{{ product.description }}</div>{%- endif -%}
              {%- when 'trust' -%}{%- if b.text != blank -%}<div class="feature"><strong>{{ b.heading }}</strong><p class="muted">{{ b.text }}</p></div>{%- endif -%}
              {%- when 'accordion' -%}{%- if b.page != blank or b.content != blank -%}<div class="product__accordions"><details class="product__accordion"><summary>{{ b.heading }}</summary><div class="product__accordion-content rte">{%- if b.page != blank -%}{{ b.page.content }}{%- else -%}{{ b.content }}{%- endif -%}</div></details></div>{%- endif -%}
              {%- when 'bulk' -%}{%- if b.text != blank or b.link != blank -%}<div class="bulk-callout" style="grid-template-columns:1fr;padding:1.5rem"><div><h3>{{ b.heading }}</h3>{%- if b.text != blank -%}<p>{{ b.text }}</p>{%- endif -%}</div>{%- if b.label != blank and b.link != blank -%}<a class="button button--accent" href="{{ b.link }}">{{ b.label }}</a>{%- endif -%}</div>{%- endif -%}
              {%- when 'custom_liquid' -%}{{ b.custom_liquid }}
              {%- when 'curlear_showcase_snippet' -%}
                {% render 'curlear-showcase-snippet', heading: b.heading, visible_desktop: b.visible_desktop, auto_slide_speed: b.auto_slide_speed, item_height_desktop: b.item_height_desktop, item_height_mobile: b.item_height_mobile, wider_desktop: b.wider_desktop, media_1_image: b.media_1_image, media_1_video: b.media_1_video, media_2_image: b.media_2_image, media_2_video: b.media_2_video, media_3_image: b.media_3_image, media_3_video: b.media_3_video, media_4_image: b.media_4_image, media_4_video: b.media_4_video, media_5_image: b.media_5_image, media_5_video: b.media_5_video, media_6_image: b.media_6_image, media_6_video: b.media_6_video, media_7_image: b.media_7_image, media_7_video: b.media_7_video, media_8_image: b.media_8_image, media_8_video: b.media_8_video %}

              {%- when 'cro_badges' -%}
                {%- liquid
                  assign show_best = false
                  if b.show_best
                    if product.metafields.custom.best_seller.value == true or product.tags contains 'best-seller' or product.tags contains 'Best Seller'
                      assign show_best = true
                    endif
                  endif
                  assign show_custom = false
                  if b.custom_text != blank
                    assign show_custom = true
                    if b.custom_only_on_sale and on_sale == false
                      assign show_custom = false
                    endif
                  endif
                  assign show_sale_badge = false
                  if b.show_sale and on_sale
                    assign show_sale_badge = true
                  endif
                  assign show_new = false
                  if b.show_new and product.metafields.custom.new_arrival.value == true
                    assign show_new = true
                  endif
                  assign any_badge = false
                  if show_sale_badge or show_best or show_custom or show_new
                    assign any_badge = true
                  endif
                -%}
                {%- if any_badge -%}
                  <div class="cro-badges">
                    {%- if show_sale_badge -%}
                      {%- assign bd_pct = current.compare_at_price | minus: current.price | times: 100.0 | divided_by: current.compare_at_price | round -%}
                      <span class="cro-badge">{% echo b.sale_label | replace: '{value}', bd_pct | escape %}</span>
                    {%- endif -%}
                    {%- if show_custom -%}<span class="cro-badge cro-badge--custom">{{ b.custom_text | escape }}</span>{%- endif -%}
                    {%- if show_best -%}<span class="cro-badge cro-badge--best">{{ b.best_label | escape }}</span>{%- endif -%}
                    {%- if show_new -%}<span class="cro-badge cro-badge--new">{{ b.new_label | escape }}</span>{%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'cro_rating' -%}
                {%- liquid
                  assign rt = blank
                  if product.metafields.reviews.rating.value != blank
                    assign rt = product.metafields.reviews.rating.value.rating | round: 1
                    assign rt_max = product.metafields.reviews.rating.value.scale_max | default: 5
                    assign rt_count = product.metafields.reviews.rating_count.value | default: 0
                  elsif product.metafields.custom.rating.value != blank
                    assign rt = product.metafields.custom.rating.value | round: 1
                    assign rt_max = 5
                    assign rt_count = product.metafields.custom.review_count.value | default: 0
                  endif
                -%}
                {%- if rt != blank -%}
                  {%- assign rt_pct = rt | times: 100.0 | divided_by: rt_max -%}
                  {%- capture rt_inner -%}<span class="cro-stars" style="--cro-stars:{{ rt_pct }}%" aria-hidden="true"></span><strong>{{ rt }}</strong>{%- if rt_count > 0 -%}<span>{% echo b.count_label | replace: '{count}', rt_count | escape %}</span>{%- endif -%}<span class="cro-vh">{% echo b.sr_label | replace: '{rating}', rt | replace: '{max}', rt_max | escape %}</span>{%- endcapture -%}
                  {%- if b.anchor != blank -%}<a class="cro-rating" href="{{ b.anchor | escape }}">{{ rt_inner }}</a>{%- else -%}<div class="cro-rating">{{ rt_inner }}</div>{%- endif -%}
                {%- endif -%}

              {%- when 'cro_price' -%}
                {% render 'cro-price', product: product, pdp: true, size: 'lg', savings: b.savings, save_label: b.save_label, tax_note: b.tax_note, sale_label: b.sale_label_sr, regular_label: b.regular_label_sr %}

              {%- when 'cro_countdown' -%}
                {%- unless b.only_on_sale and on_sale == false -%}
                  <div class="cro-cdbox"{% if b.expire_action == 'hide' %} data-cro-expire-scope="hide"{% endif %}>
                    {%- if b.heading != blank or b.badge != blank -%}
                      <div class="cro-cdbox__top">
                        {%- if b.heading != blank -%}<p class="cro-cdbox__label">{% render 'cro-icon', icon: b.icon, image: b.icon_image, text: b.icon_text, size: 20 %}{{ b.heading | escape }}</p>{%- endif -%}
                        {%- if b.badge != blank -%}<span class="cro-cdbox__badge">{{ b.badge | escape }}</span>{%- endif -%}
                      </div>
                    {%- endif -%}
                    {% render 'cro-countdown', id: block.id, mode: b.mode, end: b.end, hours: b.evergreen_hours, prefix: b.prefix, suffix: b.suffix, suffix_later: b.suffix_later, expire_action: b.expire_action, expired_message: b.expired_message, style: b.style, show_days: b.show_days, pad: true, separator: b.separator, label_d: b.label_days, label_h: b.label_hours, label_m: b.label_minutes, label_s: b.label_seconds, urgent: b.urgent, fallback: b.fallback %}
                    {%- if b.subtext != blank -%}<p class="cro-cdbox__sub">{{ b.subtext | escape }}</p>{%- endif -%}
                  </div>
                {%- endunless -%}

              {%- when 'cro_benefits' -%}
                {%- liquid
                  assign bl_lines = ''
                  assign bl_mf = product.metafields.custom.key_benefits
                  if bl_mf != blank
                    if bl_mf.type contains 'list.'
                      assign bl_lines = bl_mf.value | join: '|~|'
                    else
                      assign bl_lines = bl_mf.value | newline_to_br | replace: '<br />', '|~|' | strip_newlines
                    endif
                  else
                    assign bl_lines = b.line_1 | append: '|~|' | append: b.line_2 | append: '|~|' | append: b.line_3 | append: '|~|' | append: b.line_4 | append: '|~|' | append: b.line_5 | append: '|~|' | append: b.line_6
                  endif
                  assign bl_arr = bl_lines | split: '|~|'
                  assign bl_has = false
                  for l in bl_arr
                    assign lt = l | strip
                    if lt != blank
                      assign bl_has = true
                    endif
                  endfor
                -%}
                {%- if bl_has -%}
                  <ul class="cro-list" role="list">
                    {%- for l in bl_arr -%}{%- assign lt = l | strip -%}{%- if lt != blank -%}<li>{% render 'cro-icon', icon: b.icon, image: b.icon_image, text: b.icon_text, size: 18 %}<span>{{ lt | escape }}</span></li>{%- endif -%}{%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'cro_scarcity' -%}
                {%- liquid
                  assign sc_threshold = b.threshold
                  if sc_threshold == 0
                    assign sc_threshold = settings.cro_low_stock_threshold | default: 5
                  endif
                  assign sc_qty = current.inventory_quantity
                -%}
                {%- if current.available and current.inventory_management == 'shopify' and current.inventory_policy == 'deny' and sc_qty > 0 and sc_qty <= sc_threshold -%}
                  {%- assign sc_pct = sc_qty | times: 100 | divided_by: sc_threshold -%}
                  <div class="cro-scarcity" role="status">
                    <span>{% echo b.text | replace: '{count}', sc_qty | escape %}</span>
                    {%- if b.show_bar -%}<span class="cro-scarcity__bar" aria-hidden="true"><span class="cro-scarcity__fill" style="inline-size:{{ sc_pct }}%"></span></span>{%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'cro_sold' -%}
                {%- assign sold = product.metafields.custom.sold_count.value -%}
                {%- if sold != blank and sold > 0 -%}
                  <p class="cro-inline">{% render 'cro-icon', icon: b.icon, image: b.icon_image, text: b.icon_text, size: 18 %}{% echo b.text | replace: '{count}', sold | escape %}</p>
                {%- endif -%}

              {%- when 'cro_delivery' -%}
                {%- liquid
                  assign dv_min = b.min_days | default: settings.cro_delivery_min_days | default: 2
                  assign dv_max = b.max_days | default: settings.cro_delivery_max_days | default: 5
                  assign dv_cut = settings.cro_dispatch_cutoff_hour | default: 14
                  assign dv_hol = settings.cro_holidays | newline_to_br | replace: '<br />', ',' | strip_newlines
                  assign dv_cities = b.cities | newline_to_br | split: '<br />'
                -%}
                <div class="cro-delivery cro-box" data-cro-delivery data-min="{{ dv_min }}" data-max="{{ dv_max }}" data-cutoff="{{ dv_cut }}" data-tz="{{ settings.cro_timezone | default: 'Asia/Karachi' | escape }}" data-skip="{{ settings.cro_excluded_weekdays | escape }}" data-holidays="{{ dv_hol | escape }}" data-template="{{ b.date_template | escape }}">
                  <p class="cro-inline">{% render 'cro-icon', icon: b.icon, image: b.icon_image, text: b.icon_text, size: 20 %}<span>{{ b.label | escape }} <span class="cro-delivery__dates" data-cro-delivery-js data-cro-delivery-dates></span><span data-cro-delivery-nojs>{% echo b.fallback | replace: '{min}', dv_min | replace: '{max}', dv_max | escape %}</span></span></p>
                  {%- if b.cities != blank -%}
                    <label class="cro-vh" for="CroCity-{{ block.id }}">{{ b.city_label | escape }}</label>
                    <select id="CroCity-{{ block.id }}" data-cro-delivery-city data-cro-delivery-js>
                      <option value="">{{ b.city_label | escape }}</option>
                      {%- for line in dv_cities -%}
                        {%- assign city_parts = line | strip_newlines | split: '|' -%}
                        {%- assign city = city_parts[0] | strip -%}
                        {%- if city != blank -%}<option value="{{ city | escape }}" data-min="{{ city_parts[1] | strip }}" data-max="{{ city_parts[2] | strip }}" data-note="{{ city_parts[3] | strip | escape }}">{{ city | escape }}</option>{%- endif -%}
                      {%- endfor -%}
                    </select>
                    <p class="cro-inline" data-cro-delivery-extra aria-live="polite"></p>
                  {%- endif -%}
                </div>

              {%- when 'cro_trust_box' -%}
                {%- capture tb_rows -%}
                  {%- for n in (1..4) -%}
                    {%- assign t_title = 'row_' | append: n | append: '_title' -%}
                    {%- assign t_text = 'row_' | append: n | append: '_text' -%}
                    {%- assign t_icon = 'row_' | append: n | append: '_icon' -%}
                    {%- assign t_link = 'row_' | append: n | append: '_link' -%}
                    {%- if b[t_title] != blank -%}
                      <li class="cro-tbox__cell">
                        {%- capture tb_inner -%}<span class="cro-tbox__ico">{% render 'cro-icon', icon: b[t_icon], size: 22 %}</span><span class="cro-tbox__body"><strong class="cro-tbox__title">{{ b[t_title] | escape }}</strong>{%- if b[t_text] != blank -%}<span class="cro-tbox__text">{{ b[t_text] | escape }}</span>{%- endif -%}</span>{%- endcapture -%}
                        {%- if b[t_link] != blank -%}<a class="cro-tbox__item cro-tbox__item--link" href="{{ b[t_link] }}">{{ tb_inner }}<span class="cro-tbox__arrow" aria-hidden="true">{% render 'cro-icon', icon: 'chevron-right', size: 16 %}</span></a>{%- else -%}<div class="cro-tbox__item">{{ tb_inner }}</div>{%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endcapture -%}
                {%- if tb_rows != blank -%}
                  <div class="cro-tbox cro-tbox--{{ b.columns }}">
                    {%- if b.heading != blank -%}<p class="cro-tbox__head">{% render 'cro-icon', icon: 'shield', size: 20 %}{{ b.heading | escape }}</p>{%- endif -%}
                    <ul class="cro-tbox__grid" role="list">{{ tb_rows }}</ul>
                  </div>
                {%- endif -%}

              {%- when 'cro_payment' -%}
                <div class="cro-paybox">
                  {%- if b.heading != blank -%}<p class="cro-inline">{% render 'cro-icon', icon: 'lock', size: 16 %}{{ b.heading | escape }}</p>{%- endif -%}
                  {% render 'cro-payment-icons', aria_label: b.heading %}
                </div>

              {%- when 'cro_qty_breaks' -%}
                <div class="cro-qb" data-cro-qty-breaks data-target="Quantity-{{ section.id }}" role="group" aria-label="{{ b.heading | escape }}">
                  {%- if b.heading != blank -%}<p class="cro-box__title">{{ b.heading | escape }}</p>{%- endif -%}
                  {%- for n in (1..3) -%}
                    {%- assign q_key = 'tile_' | append: n | append: '_qty' -%}
                    {%- assign l_key = 'tile_' | append: n | append: '_label' -%}
                    {%- assign p_key = 'tile_' | append: n | append: '_percent' -%}
                    {%- assign g_key = 'tile_' | append: n | append: '_badge' -%}
                    {%- assign q = b[q_key] -%}
                    {%- if q > 0 -%}
                      {%- assign pct = b[p_key] -%}
                      <button class="cro-qb__tile" type="button" data-qty="{{ q }}" data-default="{% if b.default_tile == n %}true{% else %}false{% endif %}" aria-pressed="false">
                        {%- if b[g_key] != blank -%}<span class="cro-qb__badge">{{ b[g_key] | escape }}</span>{%- endif -%}
                        <span><strong>{{ b[l_key] | default: q | escape }}</strong></span>
                        {%- assign q_total = current.price | times: q -%}
                        {%- if pct > 0 -%}
                          {%- assign q_disc = q_total | times: pct | divided_by: 100 -%}
                          {%- assign q_final = q_total | minus: q_disc -%}
                          <span><span class="cro-qb__save">{% echo b.save_label | replace: '{value}', pct | escape %}</span> · {{ q_final | money }}</span>
                        {%- else -%}
                          <span>{{ q_total | money }}</span>
                        {%- endif -%}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'cro_variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign vp_style = b.style
                      assign vp_swatch = false
                      if vp_style == 'swatch'
                        assign opt_name = option.name | downcase
                        assign want = b.swatch_option | downcase
                        if want == blank and option.position == 1
                          assign vp_swatch = true
                        elsif want != blank and opt_name == want
                          assign vp_swatch = true
                        endif
                      endif
                    -%}
                    <fieldset class="variant-group cro-vp" data-option-group>
                      <legend>{{ option.name }}{% if b.show_selected %}: <span class="cro-vp__selected">{{ option.selected_value }}</span>{% endif %}</legend>
                      {%- if vp_style == 'dropdown' -%}
                        <select class="cro-vp__select" data-cro-select-sync aria-label="{{ option.name | escape }}">
                          {%- for value in option.values -%}
                            <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}{% if value.available == false %} — {{ b.unavailable_label }}{% endif %}</option>
                          {%- endfor -%}
                        </select>
                        <div class="cro-vh" aria-hidden="true">
                          {%- for value in option.values -%}<input type="radio" tabindex="-1" name="option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>{%- endfor -%}
                        </div>
                      {%- else -%}
                        <div class="variant-options cro-vp__options">
                          {%- for value in option.values -%}
                            <div class="variant-option cro-vp__opt{% if value.available == false %} is-unavailable{% endif %}">
                              <input type="radio" id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                              <label for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">
                                {%- if vp_swatch and value.variant.featured_media -%}{{ value.variant.featured_media | image_url: width: 80, height: 80, crop: 'center' | image_tag: class: 'cro-vp__swatch', alt: '', loading: 'lazy', width: 28, height: 28 }}{%- endif -%}
                                <span>{{ value }}</span>
                                {%- if value.available == false -%}<span class="cro-vh">{{ b.unavailable_label | escape }}</span>{%- endif -%}
                              </label>
                            </div>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </fieldset>
                  {%- endfor -%}
                {%- endunless -%}
                {%- if b.size_guide != blank -%}
                  <button class="cro-vp__guide" type="button" data-cro-dialog-open="CroGuide-{{ block.id }}">{{ b.size_guide_label | escape }}</button>
                  <dialog class="cro-dialog" id="CroGuide-{{ block.id }}" data-cro-dialog aria-label="{{ b.size_guide.title | escape }}">
                    <button class="cro-dialog__close" type="button" data-cro-dialog-close aria-label="{{ s.close_label | escape }}">{% render 'cro-icon', icon: 'close', size: 18 %}</button>
                    <h2>{{ b.size_guide.title }}</h2>
                    <div class="rte">{{ b.size_guide.content }}</div>
                  </dialog>
                {%- endif -%}

              {%- when 'cro_buy_buttons' -%}
                {%- liquid
                  assign atc_label = b.atc_label
                  if atc_label == blank
                    assign atc_label = 'products.product.add_to_cart' | t
                  endif
                -%}
                <div class="cro-buy">
                  <button class="cro-buy__atc" type="submit" name="add" data-cro-main-atc data-add="{{ atc_label | escape }}" data-sold="{{ 'products.product.sold_out' | t }}" data-unavailable="{{ 'products.product.unavailable' | t }}"{% unless current.available %} disabled{% endunless %}>
                    {%- if current.available -%}{{ atc_label | escape }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                  </button>
                  {%- if b.dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}
                  {%- if b.show_whatsapp and wa_number != blank -%}
                    {%- liquid
                      assign wa_msg = b.whatsapp_message | replace: '{product}', product.title | replace: '{url}', canonical_url
                      if product.has_only_default_variant
                        assign wa_msg = wa_msg | replace: '{variant}', ''
                      else
                        assign wa_msg = wa_msg | replace: '{variant}', current.title
                      endif
                    -%}
                    <a class="cro-buy__wa" href="https://wa.me/{{ wa_number }}?text={% echo wa_msg | replace: '{qty}', '1' | url_encode %}" target="_blank" rel="noopener" data-cro-wa-order data-number="{{ wa_number }}" data-message="{{ wa_msg | escape }}">{% render 'cro-icon', icon: 'whatsapp', size: 22 %}{{ b.whatsapp_label | escape }}</a>
                  {%- endif -%}
                </div>

              {%- when 'cro_fbt' -%}
                {%- liquid
                  assign fbt_manual = false
                  if b.product_1 != blank or b.product_2 != blank or b.product_3 != blank
                    assign fbt_manual = true
                  endif
                  assign fbt_rec = routes.product_recommendations_url | append: '?section_id=cro-pdp-complementary&product_id=' | append: product.id | append: '&limit=' | append: b.limit
                -%}
                {%- if current.available -%}
                <div class="cro-fbt" data-cro-complementary data-money-format="{{ shop.money_format | escape }}"
                  {%- if fbt_manual %} data-cro-fbt-static{% else %} data-url-complementary="{{ fbt_rec }}&intent=complementary" data-url-related="{% if b.fallback_related %}{{ fbt_rec }}&intent=related{% endif %}"{% unless request.design_mode %} hidden{% endunless %}{% endif %}>
                  <p class="cro-fbt__title">{% render 'cro-icon', icon: 'sparkle', size: 18 %}{{ b.heading | escape }}</p>
                  <div class="cro-fbt__items">
                    <label class="cro-set__item">
                      <input type="checkbox" value="{{ current.id }}" data-price="{{ current.price }}" data-cro-set-check data-cro-set-base checked>
                      {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: '', width: 52, height: 52 }}{%- else -%}<span></span>{%- endif -%}
                      <span><span class="cro-set__title">{{ product.title | escape }}</span><span class="cro-set__tag">{{ b.this_item_label | escape }}</span></span>
                      <span class="cro-set__price">{{ current.price | money }}</span>
                    </label>
                    <div class="cro-fbt__items" data-cro-comp-target>
                      {%- if fbt_manual -%}
                        {%- for n in (1..3) -%}
                          {%- assign fk = 'product_' | append: n -%}
                          {%- assign fp = b[fk] -%}
                          {%- if fp != blank and fp.id != product.id and fp.available -%}
                            {%- assign fv = fp.selected_or_first_available_variant -%}
                            <label class="cro-set__item" data-cro-set-item>
                              <input type="checkbox" value="{{ fv.id }}" data-price="{{ fv.price }}" data-cro-set-check{% if b.prechecked %} checked{% endif %}>
                              {%- if fp.featured_media -%}{{ fp.featured_media | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: '', width: 52, height: 52 }}{%- else -%}<span></span>{%- endif -%}
                              <span><a class="cro-set__title" href="{{ fp.url }}">{{ fp.title | escape }}</a>{%- unless fp.has_only_default_variant -%}<span class="cro-set__tag">{{ fv.title | escape }}</span>{%- endunless -%}</span>
                              <span class="cro-set__price">{{ fv.price | money }}</span>
                            </label>
                          {%- endif -%}
                        {%- endfor -%}
                      {%- elsif request.design_mode -%}
                        <p class="cro-inline">{{ b.editor_note | escape }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                  <div class="cro-fbt__foot">
                    <span>{{ b.total_label | escape }} <strong class="cro-fbt__total" data-cro-set-total>{{ current.price | money }}</strong></span>
                    <button class="cro-fbt__btn" type="button" data-cro-set-add data-source="frequently-bought-together" data-success="{{ b.success_label | escape }}" data-loading="{{ b.loading_label | escape }}"><span data-cro-btn-label>{{ b.button_label | escape }}</span></button>
                    <p class="cro-vh" data-cro-error hidden></p>
                  </div>
                </div>
                {%- endif -%}

              {%- when 'cro_guarantee' -%}
                {%- if b.heading != blank or b.text != blank -%}
                  <div class="cro-box">
                    <p class="cro-inline">{% render 'cro-icon', icon: b.icon, image: b.icon_image, text: b.icon_text, size: 22 %}<strong>{{ b.heading | escape }}</strong></p>
                    {%- if b.text != blank -%}<div class="rte">{{ b.text }}</div>{%- endif -%}
                    {%- if b.link != blank and b.link_label != blank -%}<a class="cro-link" href="{{ b.link }}">{{ b.link_label | escape }}</a>{%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'cro_share' -%}
                <div class="cro-share">
                  {%- if b.label != blank -%}<span class="cro-inline"><strong>{{ b.label | escape }}</strong></span>{%- endif -%}
                  <button class="cro-share__btn" type="button" data-cro-copy data-copy="{{ canonical_url | escape }}" data-copied="{{ b.copied_label | escape }}">{% render 'cro-icon', icon: 'tag', size: 16 %}<span data-cro-copy-label>{{ b.copy_label | escape }}</span></button>
                  <span class="cro-vh" aria-live="polite" data-cro-copy-status></span>
                  {%- if b.show_whatsapp -%}<a class="cro-share__btn" href="https://wa.me/?text={{ product.title | append: ' ' | append: canonical_url | url_encode }}" target="_blank" rel="noopener">{% render 'cro-icon', icon: 'whatsapp', size: 16 %}WhatsApp</a>{%- endif -%}
                  {%- if b.show_facebook -%}<a class="cro-share__btn" href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | url_encode }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
                  <button class="cro-share__btn" type="button" data-cro-native-share data-title="{{ product.title | escape }}" data-url="{{ canonical_url | escape }}" hidden>{{ b.more_label | escape }}</button>
                </div>

              {%- when 'cro_ask' -%}
                {%- assign ask_email = b.email | default: shop.email -%}
                <div class="cro-box">
                  {%- if b.heading != blank -%}<p class="cro-box__title">{{ b.heading | escape }}</p>{%- endif -%}
                  {%- if b.text != blank -%}<p class="cro-inline">{{ b.text | escape }}</p>{%- endif -%}
                  <div class="cro-ask__actions">
                    {%- if wa_number != blank and b.show_whatsapp -%}
                      {%- assign ask_msg = b.whatsapp_message | replace: '{product}', product.title | replace: '{url}', canonical_url -%}
                      <a class="cro-share__btn" href="https://wa.me/{{ wa_number }}?text={{ ask_msg | url_encode }}" target="_blank" rel="noopener" data-cro-wa-order data-number="{{ wa_number }}" data-message="{{ ask_msg | escape }}">{% render 'cro-icon', icon: 'whatsapp', size: 16 %}{{ b.whatsapp_label | escape }}</a>
                    {%- endif -%}
                    {%- if ask_email != blank and b.show_email -%}
                      <a class="cro-share__btn" href="mailto:{{ ask_email }}?subject={% echo b.email_subject | replace: '{product}', product.title | url_encode %}">{% render 'cro-icon', icon: 'mail', size: 16 %}{{ b.email_label | escape }}</a>
                    {%- endif -%}
                    {%- if b.contact_link != blank -%}<a class="cro-share__btn" href="{{ b.contact_link }}">{{ b.contact_label | escape }}</a>{%- endif -%}
                  </div>
                </div>

              {%- when 'cro_policies' -%}
                {%- liquid
                  assign pol_ship = b.shipping_page | default: settings.cro_page_shipping
                  assign pol_ret = b.returns_page | default: settings.cro_page_returns
                -%}
                <div class="cro-accs">
                  {%- if b.description_tab and product.description != blank -%}
                    <details class="cro-acc"{% if b.open_first %} open{% endif %}><summary>{{ b.description_label | escape }}</summary><div class="cro-acc__body rte">{{ product.description }}</div></details>
                  {%- endif -%}
                  {%- if pol_ship != blank and pol_ship.content != blank -%}
                    <details class="cro-acc"><summary>{{ b.shipping_label | default: pol_ship.title | escape }}</summary><div class="cro-acc__body rte">{{ pol_ship.content }}</div></details>
                  {%- endif -%}
                  {%- if pol_ret != blank and pol_ret.content != blank -%}
                    <details class="cro-acc"><summary>{{ b.returns_label | default: pol_ret.title | escape }}</summary><div class="cro-acc__body rte">{{ pol_ret.content }}</div></details>
                  {%- endif -%}
                  {%- if b.extra_page != blank and b.extra_page.content != blank -%}
                    <details class="cro-acc"><summary>{{ b.extra_label | default: b.extra_page.title | escape }}</summary><div class="cro-acc__body rte">{{ b.extra_page.content }}</div></details>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- endform -%}
      <script type="application/json" data-variants-json>[{%- for variant in product.variants -%}{"id":{{ variant.id | json }},"title":{{ variant.title | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"price_formatted":{{ variant.price | money | json }},"compare_at_price":{{ variant.compare_at_price | json }},"inventory_quantity":{{ variant.inventory_quantity | json }},"inventory_management":{{ variant.inventory_management | json }},"inventory_policy":{{ variant.inventory_policy | json }},"featured_media_id":{{ variant.featured_media.id | json }},"options":{{ variant.options | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]</script>
      <script type="application/json" data-cro-rv-record>{"id":{{ product.id | json }},"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{{ product.featured_image | image_url: width: 600 | json }},"price":{{ current.price | money | json }},"compare":{% if current.compare_at_price > current.price %}{{ current.compare_at_price | money | json }}{% else %}""{% endif %}}</script>
    </div>
  </div>

  {%- if s.sticky_atc == 'original' -%}
    <div class="sticky-atc"><span><strong>{{ product.title | truncate: 24 }}</strong><br>{{ current.price | money }}</span><button class="button" type="button" data-sticky-add{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button></div>
  {%- elsif s.sticky_atc == 'cro' -%}
    {%- liquid
      assign satc_label = s.satc_label
      if satc_label == blank
        assign satc_label = 'products.product.add_to_cart' | t
      endif
    -%}
    <div class="cro-satc" data-cro-satc aria-hidden="true">
      <div class="cro-satc__inner">
        {%- assign satc_img = current.featured_media | default: product.featured_media -%}
        {%- if satc_img -%}{{ satc_img | image_url: width: 120, height: 120, crop: 'center' | image_tag: class: 'cro-satc__img', loading: 'lazy', alt: '', width: 48, height: 48 }}{%- endif -%}
        <div class="cro-satc__info">
          <span class="cro-satc__title">{{ product.title | escape }}</span>
          {%- unless product.has_only_default_variant -%}<span class="cro-satc__variant">{{ current.title | escape }}</span>{%- endunless -%}
        </div>
        <span class="cro-satc__price">{{ current.price | money }}</span>
        {%- if s.satc_qty -%}
          <div class="cro-satc__qty">
            <button type="button" data-cro-satc-step="-1" aria-label="{{ s.qty_minus_label | escape }}">−</button>
            <input type="number" min="1" value="1" data-cro-satc-qty aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-cro-satc-step="1" aria-label="{{ s.qty_plus_label | escape }}">+</button>
          </div>
        {%- endif -%}
        <button class="cro-satc__btn" type="button" data-sticky-add{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ satc_label | escape }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
      </div>
    </div>
  {%- endif -%}
  {%- if product.featured_image != blank -%}<dialog class="media-dialog" data-media-dialog><button class="icon-button media-dialog__close" type="button" data-media-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button><img src="{{ product.featured_image | image_url: width: 1600 }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" data-media-dialog-image></dialog>{%- endif -%}
</section>

{% schema %}
{
  "name": "Product information (CRO)",
  "tag": "div",
  "class": "cro-section cro-section--main-product",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout",
      "info": "Desktop widths apply from 990px; below that the gallery and information stack."
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Gallery column width",
      "min": 35,
      "max": 70,
      "step": 1,
      "default": 55,
      "unit": "%",
      "info": "The product information column takes the remaining width."
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between columns",
      "min": 16,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "info_max_width",
      "label": "Information column max width",
      "min": 360,
      "max": 900,
      "step": 20,
      "default": 640,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Sticky columns while scrolling",
      "options": [
        {
          "value": "auto",
          "label": "Auto (the shorter column stays in view)"
        },
        {
          "value": "info",
          "label": "Product information"
        },
        {
          "value": "gallery",
          "label": "Gallery"
        },
        {
          "value": "none",
          "label": "Off"
        }
      ],
      "default": "auto",
      "info": "A column can only stay in view if it is shorter than the other one. Auto makes both sticky so whichever is shorter follows the page."
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky offset from top",
      "min": 60,
      "max": 200,
      "step": 4,
      "default": 96,
      "unit": "px",
      "info": "Leave room for the sticky header."
    },
    {
      "type": "range",
      "id": "block_gap",
      "label": "Space between information blocks",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Default title size (desktop)",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 38,
      "unit": "px",
      "info": "The Title block has its own size, weight and spacing settings."
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Default title size (mobile)",
      "min": 18,
      "max": 44,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "select",
      "id": "gallery_style",
      "label": "Gallery style",
      "options": [
        {
          "value": "thumbnails",
          "label": "Slider with thumbnails"
        },
        {
          "value": "grid",
          "label": "Original image grid"
        }
      ],
      "default": "thumbnails"
    },
    {
      "type": "select",
      "id": "thumbs_position",
      "label": "Thumbnails position (desktop)",
      "options": [
        {
          "value": "bottom",
          "label": "Below image"
        },
        {
          "value": "start",
          "label": "Beside image"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "checkbox",
      "id": "show_thumbs",
      "label": "Show thumbnails",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show image counter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Zoom on hover (desktop)",
      "default": true
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "adapt",
          "label": "Match first image"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill (crop)"
        },
        {
          "value": "contain",
          "label": "Fit (no crop)"
