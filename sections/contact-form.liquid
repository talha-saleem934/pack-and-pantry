<section class="section page-width narrow"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p>{%- form 'contact' -%}{%- if form.posted_successfully? -%}<p class="form-message">Thank you. Your message has been sent.</p>{%- endif -%}{%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="grid grid--2"><div class="field"><label for="ContactName">Name</label><input class="input" id="ContactName" name="contact[name]" type="text" autocomplete="name" required></div><div class="field"><label for="ContactEmail">Email</label><input class="input" id="ContactEmail" name="contact[email]" type="email" autocomplete="email" required></div></div><div class="field"><label for="ContactPhone">Phone (optional)</label><input class="input" id="ContactPhone" name="contact[phone]" type="tel" autocomplete="tel"></div><div class="field"><label for="ContactMessage">How can we help?</label><textarea id="ContactMessage" name="contact[body]" required></textarea></div><button class="button" type="submit">Send enquiry</button>{%- endform -%}</section>
{% schema %}{"name":"Contact form","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Contact Pack & Pantry"},{"type":"text","id":"heading","label":"Heading","default":"How can we help?"},{"type":"textarea","id":"text","label":"Text","default":"Ask about products, sizing, availability or your storage requirements."}],"presets":[{"name":"Contact form"}]}{% endschema %}
