      "label": "Accent (eyebrow, focus ring)",
      "default": "#D4623D"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#0F2F27"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#D4623D"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D7CEC1"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#C64F32"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "CRO recently viewed"
    }
  ]
}
