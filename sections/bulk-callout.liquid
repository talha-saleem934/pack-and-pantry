<section class="section scheme--cream" data-reveal><div class="page-width"><div class="business-panel"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><a class="button button--accent" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.label }} <span class="button__icon" aria-hidden="true">→</span></a></div><div class="business-panel__uses" aria-label="Business uses">{%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.label }}</span>{%- endfor -%}</div></div></div></section>
{% schema %}
{"name":"Business packaging","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"For food businesses"},{"type":"text","id":"heading","label":"Heading","default":"Packaging that works as hard as you do"},{"type":"textarea","id":"text","label":"Text","default":"Planning a larger order for a café, bakery, retailer or gifting business? Tell us which products and quantities you are considering."},{"type":"text","id":"label","label":"Button label","default":"Plan a bulk order"},{"type":"url","id":"link","label":"Button link"}],"blocks":[{"type":"use","name":"Business use","settings":[{"type":"text","id":"label","label":"Label","default":"Cafés"}]}],"max_blocks":8,"presets":[{"name":"Business packaging","blocks":[{"type":"use","settings":{"label":"Cafés"}},{"type":"use","settings":{"label":"Bakeries"}},{"type":"use","settings":{"label":"Caterers"}},{"type":"use","settings":{"label":"Retailers"}},{"type":"use","settings":{"label":"Gifting"}}]}]}
{% endschema %}
