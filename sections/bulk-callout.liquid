{{ 'cro-components.css' | asset_url | stylesheet_tag }}
<section class="section scheme--cream" data-reveal><div class="page-width"><div class="business-panel"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p>{%- liquid
  assign bc_num = section.settings.whatsapp_number
  if section.settings.whatsapp_use_theme and bc_num == blank
    assign bc_num = settings.cro_whatsapp_number
  endif
  assign bc_num = bc_num | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign bc_msg = section.settings.whatsapp_message | default: settings.cro_whatsapp_greeting | replace: '{product}', shop.name | replace: '{url}', canonical_url | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"'
  assign bc_enc = bc_msg | url_encode
-%}{%- if bc_num != blank and section.settings.whatsapp_mode == 'replace' -%}<a class="button button--accent" href="https://wa.me/{{ bc_num }}?text={{ bc_enc }}" target="_blank" rel="noopener" data-cro-wa="business">{{ section.settings.label }} <span class="button__icon" aria-hidden="true">→</span></a>{%- else -%}<a class="button button--accent" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.label }} <span class="button__icon" aria-hidden="true">→</span></a>{%- endif -%}{%- if bc_num != blank and section.settings.whatsapp_mode == 'extra' -%} <a class="button button--secondary" style="display:inline-flex;align-items:center;gap:8px;margin-inline-start:10px" href="https://wa.me/{{ bc_num }}?text={{ bc_enc }}" target="_blank" rel="noopener" data-cro-wa="business">{% render 'cro-icon', icon: 'whatsapp', size: 20 %}{{ section.settings.whatsapp_label }}</a>{%- endif -%}</div><div class="business-panel__uses" aria-label="Business uses">{%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.label }}</span>{%- endfor -%}</div></div></div></section>
{% schema %}
{"name":"Business packaging","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"For food businesses"},{"type":"text","id":"heading","label":"Heading","default":"Packaging that works as hard as you do"},{"type":"textarea","id":"text","label":"Text","default":"Planning a larger order for a café, bakery, retailer or gifting business? Tell us which products and quantities you are considering."},{"type":"text","id":"label","label":"Button label","default":"Plan a bulk order"},{"type":"url","id":"link","label":"Button link"},{"type":"header","content":"WhatsApp"},{"type":"text","id":"whatsapp_number","label":"WhatsApp number","info":"Optional. International format, digits only, e.g. 923001234567."},{"type":"checkbox","id":"whatsapp_use_theme","label":"Use the WhatsApp number from Theme settings","default":false},{"type":"select","id":"whatsapp_mode","label":"WhatsApp button","default":"extra","options":[{"value":"extra","label":"Add a second WhatsApp button"},{"value":"replace","label":"Main button opens WhatsApp"}]},{"type":"text","id":"whatsapp_label","label":"WhatsApp button label","default":"Chat on WhatsApp"},{"type":"textarea","id":"whatsapp_message","label":"WhatsApp message","default":"Hi Pack & Pantry, I would like a bulk order quote.","info":"Empty uses the default greeting from Theme settings."}],"blocks":[{"type":"use","name":"Business use","settings":[{"type":"text","id":"label","label":"Label","default":"Cafés"}]}],"max_blocks":8,"presets":[{"name":"Business packaging","blocks":[{"type":"use","settings":{"label":"Cafés"}},{"type":"use","settings":{"label":"Bakeries"}},{"type":"use","settings":{"label":"Caterers"}},{"type":"use","settings":{"label":"Retailers"}},{"type":"use","settings":{"label":"Gifting"}}]}]}
{% endschema %}
