        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ],
      "default": "square"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 16,
      "max": 72,
      "step": 2,
      "default": 38,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
