<section class="section section--compact scheme--{{ section.settings.scheme }}" data-reveal><div class="page-width"><div class="benefit-strip">{%- for block in section.blocks -%}<div class="feature" {{ block.shopify_attributes }}><div class="feature__icon">{% render 'icon', icon: 'check' %}</div><h3>{{ block.settings.heading }}</h3><p class="muted">{{ block.settings.text }}</p></div>{%- endfor -%}</div></div></section>
{% schema %}
{"name":"Service highlights","settings":[{"type":"select","id":"scheme","label":"Colour scheme","default":"cream","options":[{"value":"cream","label":"Oat cream"},{"value":"white","label":"Warm white"},{"value":"sage","label":"Sage"}]}],"max_blocks":4,"blocks":[{"type":"benefit","name":"Highlight","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find the right fit"},{"type":"textarea","id":"text","label":"Text","default":"Compare useful product information where it has been supplied."}]}],"presets":[{"name":"Service highlights","blocks":[{"type":"benefit","settings":{"heading":"Find the right fit","text":"Compare sizes, uses and materials where product data is available."}},{"type":"benefit","settings":{"heading":"For home or business","text":"Browse solutions for pantries, cafés, bakers, gifting and retail."}},{"type":"benefit","settings":{"heading":"Clear product details","text":"See real prices, availability and options from the Shopify catalogue."}},{"type":"benefit","settings":{"heading":"Planning a larger order?","text":"Use the business enquiry route to share your requirements."}}]}]}
{% endschema %}
