<section class="section scheme--{{ section.settings.scheme }}" data-reveal><div class="page-width selection-guide"><div class="selection-guide__intro"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>{%- if section.settings.button_label != blank -%}<p><a class="button button--accent" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} <span class="button__icon" aria-hidden="true">→</span></a></p>{%- endif -%}</div><div class="selection-guide__steps">{%- for block in section.blocks -%}<div class="guide-step" {{ block.shopify_attributes }}><div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></div>{%- endfor -%}</div></div></section>
{% schema %}
{"name":"Product selection guide","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Find your container"},{"type":"text","id":"heading","label":"Heading","default":"Three questions make choosing easier"},{"type":"richtext","id":"text","label":"Text","default":"<p>Begin with the intended use, confirm the size you need, then check the verified material and care details on the product page.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Browse all products"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"scheme","label":"Colour scheme","default":"sage","options":[{"value":"cream","label":"Oat cream"},{"value":"white","label":"Warm white"},{"value":"sage","label":"Sage"}]}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"heading","label":"Heading","default":"What will it hold?"},{"type":"textarea","id":"text","label":"Text","default":"Start with the ingredient, product or item you want to store or package."}]}],"max_blocks":4,"presets":[{"name":"Product selection guide","blocks":[{"type":"step","settings":{"heading":"What will it hold?","text":"Start with the ingredient, product or item you want to store or package."}},{"type":"step","settings":{"heading":"How much space is available?","text":"Check the product capacity and dimensions where they have been supplied."}},{"type":"step","settings":{"heading":"How will it be used?","text":"Review the verified material, closure, care and intended-use information."}}]}]}
{% endschema %}
