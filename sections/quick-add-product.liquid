<div class="quick-add-product">
  <div class="quick-add-product__media">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: 'min(42vw,260px)', loading: 'eager', alt: product.featured_image.alt | default: product.title }}{%- endif -%}</div>
  <div class="quick-add-product__info"><p class="eyebrow">Choose your option</p><h2>{{ product.title }}</h2>{% render 'price', product: product %}{%- form 'product', product, data-product-form: '', class: 'quick-add-product__form' -%}<div class="field"><label for="QuickVariant-{{ section.id }}">Option</label><select id="QuickVariant-{{ section.id }}" name="id">{%- for variant in product.variants -%}<option value="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{%- endfor -%}</select></div><label for="QuickQuantity-{{ section.id }}">Quantity</label><div class="quantity" data-quantity><button type="button" data-quantity-button="minus" aria-label="Decrease quantity">{% render 'icon', icon: 'minus' %}</button><input id="QuickQuantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"><button type="button" data-quantity-button="plus" aria-label="Increase quantity">{% render 'icon', icon: 'plus' %}</button></div><button class="button button--full" type="submit">{{ 'products.product.add_to_cart' | t }}</button>{%- endform -%}<p><a href="{{ product.url }}">View full product details</a></p></div>
</div>
{% schema %}{"name":"Quick add product","settings":[]}{% endschema %}
