{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign count = section.blocks.size
  if count < 1
    assign count = 1
  endif
  case s.align
    when 'start'
      assign justify = 'flex-start'
    when 'end'
      assign justify = 'flex-end'
    else
      assign justify = 'center'
  endcase
-%}
{{ 'cro-components.css' | asset_url | stylesheet_tag }}
{%- if s.display_mode != 'grid' -%}<script src="{{ 'cro-core.js' | asset_url }}" defer="defer"></script>{%- endif -%}
{% style %}
  #cro-{{ sid }} {
    --cro-tb-bg: {{ s.bg_color }};
    --cro-tb-heading: {{ s.heading_color }};
    --cro-tb-title: {{ s.title_color }};
    --cro-tb-text: {{ s.text_color }};
    --cro-tb-icon: {{ s.icon_color }};
    --cro-tb-icon-bg: {{ s.icon_bg }};
    --cro-tb-card-bg: {{ s.card_bg }};
    --cro-tb-border: {{ s.border_color }};
    --cro-tb-link-hover: {{ s.link_hover_color }};
    --cro-tb-radius: {{ s.radius }}px;
    --cro-tb-icon-size: {{ s.icon_size }}px;
    background: var(--cro-tb-bg);
    color: var(--cro-tb-text);
    padding-block: {{ s.padding_top_mobile }}px {{ s.padding_bottom_mobile }}px;
  }
  #cro-{{ sid }} .cro-tb__inner { max-inline-size: {% if s.full_width %}none{% else %}{{ s.container_width }}px{% endif %}; margin-inline: auto; padding-inline: var(--gutter, 16px); }
  #cro-{{ sid }} .cro-tb__head { margin-block-end: 20px; text-align: {{ s.align }}; }
  #cro-{{ sid }} .cro-tb__heading { margin: 0; color: var(--cro-tb-heading); font-family: var(--font-heading); font-size: {{ s.heading_size_mobile }}px; line-height: 1.2; }
  #cro-{{ sid }} .cro-tb__sub { margin: 8px 0 0; font-size: {{ s.text_size_mobile }}px; }
  #cro-{{ sid }} .cro-tb__list { display: grid; gap: {{ s.gap }}px; margin: 0; padding: 0; list-style: none; }
  {%- case s.mobile_layout -%}
    {%- when 'grid' %}
  #cro-{{ sid }} .cro-tb__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    {%- when 'scroll' %}
  #cro-{{ sid }} .cro-tb__list { grid-auto-flow: column; grid-auto-columns: minmax(72%, 1fr); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; padding-block-end: 4px; }
  #cro-{{ sid }} .cro-tb__item { scroll-snap-align: start; }
    {%- else %}
  #cro-{{ sid }} .cro-tb__list { grid-template-columns: minmax(0, 1fr); }
  {%- endcase %}
  #cro-{{ sid }} .cro-tb__item { min-inline-size: 0; }
  #cro-{{ sid }} .cro-tb__card {
    display: flex; {% if s.icon_position == 'top' %}flex-direction: column; align-items: {{ justify }}; text-align: {{ s.align }};{% else %}flex-direction: row; align-items: flex-start; text-align: start;{% endif %}
    gap: 12px; block-size: 100%; box-sizing: border-box; color: inherit; text-decoration: none;
    {%- if s.style == 'cards' %} padding: 16px; background: var(--cro-tb-card-bg); border: 1px solid var(--cro-tb-border); border-radius: var(--cro-tb-radius);{% endif %}
  }
  #cro-{{ sid }} a.cro-tb__card { min-block-size: 48px; transition: border-color .2s ease; }
  #cro-{{ sid }} a.cro-tb__card:hover .cro-tb__title { color: var(--cro-tb-link-hover); }
  #cro-{{ sid }} a.cro-tb__card:focus-visible { outline: 2px solid var(--cro-tb-link-hover); outline-offset: 2px; }
  #cro-{{ sid }} .cro-tb__icon {
    display: inline-flex; flex: none; align-items: center; justify-content: center;
    color: var(--cro-tb-icon);
    {%- if s.icon_bg_show %} inline-size: calc(var(--cro-tb-icon-size) * 2); block-size: calc(var(--cro-tb-icon-size) * 2); background: var(--cro-tb-icon-bg); border-radius: 50%;{% endif %}
  }
  #cro-{{ sid }} .cro-tb__title { display: block; margin: 0; color: var(--cro-tb-title); font-weight: 700; font-size: {{ s.title_size_mobile }}px; line-height: 1.3; }
  #cro-{{ sid }} .cro-tb__text { display: block; margin: 4px 0 0; font-size: {{ s.text_size_mobile }}px; line-height: 1.45; }
  @media (min-width: 750px) {
    #cro-{{ sid }} { padding-block: {{ s.padding_top_desktop }}px {{ s.padding_bottom_desktop }}px; }
    #cro-{{ sid }} .cro-tb__heading { font-size: {{ s.heading_size_desktop }}px; }
    #cro-{{ sid }} .cro-tb__sub, #cro-{{ sid }} .cro-tb__text { font-size: {{ s.text_size_desktop }}px; }
    #cro-{{ sid }} .cro-tb__title { font-size: {{ s.title_size_desktop }}px; }
    #cro-{{ sid }} .cro-tb__list { grid-auto-flow: row; grid-template-columns: repeat({{ count }}, minmax(0, 1fr)); overflow: visible; }
    {%- if s.dividers %}
    #cro-{{ sid }} .cro-tb__item + .cro-tb__item { border-inline-start: 1px solid var(--cro-tb-border); padding-inline-start: {{ s.gap }}px; }
    #cro-{{ sid }} .cro-tb__list { column-gap: {{ s.gap }}px; }
    {%- endif %}
  }
  /* Marquee mode */
  #cro-{{ sid }} .cro-tb__mq { min-block-size: 56px; display: flex; align-items: center; }
  #cro-{{ sid }} .cro-tb__chip { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border: 1px solid var(--cro-tb-border); border-radius: 999px; background: var(--cro-tb-card-bg); color: var(--cro-tb-text); white-space: nowrap; text-decoration: none; }
  #cro-{{ sid }} a.cro-tb__chip:hover { border-color: var(--cro-tb-link-hover); }
  #cro-{{ sid }} .cro-tb__chip .cro-tb__icon { inline-size: auto; block-size: auto; background: none; }
  #cro-{{ sid }} .cro-tb__chip strong { color: var(--cro-tb-title); font-size: {{ s.title_size_mobile }}px; }
  #cro-{{ sid }} .cro-tb__chip-text { font-size: {{ s.text_size_mobile }}px; opacity: .85; }
  {%- case s.display_mode -%}
    {%- when 'marquee' %}
  #cro-{{ sid }} .cro-tb__list { display: none; }
    {%- when 'marquee_mobile' %}
  @media (max-width: 749px) { #cro-{{ sid }} .cro-tb__list { display: none; } }
  @media (min-width: 750px) { #cro-{{ sid }} .cro-tb__mq { display: none; } }
  {%- endcase %}
{% endstyle %}
<section id="cro-{{ sid }}" class="cro-tb" aria-label="{{ s.heading | default: s.region_label | escape }}">
  <div class="cro-tb__inner">
    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="cro-tb__head">
        {%- if s.heading != blank -%}<h2 class="cro-tb__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="cro-tb__sub">{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <ul class="cro-tb__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- liquid
  assign tb_href = b.link
  assign tb_wa = false
  assign cro_wa_num = b.whatsapp_number
  if b.whatsapp_use_theme and cro_wa_num == blank
    assign cro_wa_num = settings.cro_whatsapp_number
  endif
  assign cro_wa_num = cro_wa_num | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign cro_wa_num = cro_wa_num | remove: '.'
  assign cro_wa_first = cro_wa_num | slice: 0, 2
  if cro_wa_first == '00'
    assign cro_wa_num = cro_wa_num | remove_first: '00'
  else
    assign cro_wa_first = cro_wa_num | slice: 0
    if cro_wa_first == '0'
      assign cro_wa_num = cro_wa_num | remove_first: '0' | prepend: '92'
    endif
  endif
  if cro_wa_num != blank
    assign cro_wa_msg = b.whatsapp_message | default: settings.cro_whatsapp_greeting | replace: ' about {product}', '' | replace: '{product}', shop.name | replace: '{url}', canonical_url | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"'
    assign cro_wa_enc = cro_wa_msg | url_encode
    assign tb_href = 'https://wa.me/' | append: cro_wa_num | append: '?text=' | append: cro_wa_enc
    assign tb_wa = true
  endif
-%}
        <li class="cro-tb__item" {{ block.shopify_attributes }}>
          {%- capture card_inner -%}
            {%- if b.icon != 'none' or b.icon_image != blank or b.icon_text != blank -%}
              <span class="cro-tb__icon">{% render 'cro-icon', icon: b.icon, image: b.icon_image, text: b.icon_text, size: s.icon_size %}</span>
            {%- endif -%}
            <span class="cro-tb__body">
              {%- if b.title != blank -%}<span class="cro-tb__title">{{ b.title | escape }}</span>{%- endif -%}
              {%- if b.text != blank -%}<span class="cro-tb__text">{{ b.text | escape }}</span>{%- endif -%}
            </span>
          {%- endcapture -%}
          {%- if tb_href != blank -%}
            <a class="cro-tb__card" href="{{ tb_href }}"{% if tb_wa %} target="_blank" rel="noopener" data-cro-wa="trust"{% endif %}>{{ card_inner }}</a>
          {%- else -%}
            <div class="cro-tb__card">{{ card_inner }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.display_mode != 'grid' -%}
      {%- capture tb_chips -%}
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- liquid
  assign tb_href = b.link
  assign tb_wa = false
  assign cro_wa_num = b.whatsapp_number
  if b.whatsapp_use_theme and cro_wa_num == blank
    assign cro_wa_num = settings.cro_whatsapp_number
  endif
  assign cro_wa_num = cro_wa_num | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign cro_wa_num = cro_wa_num | remove: '.'
  assign cro_wa_first = cro_wa_num | slice: 0, 2
  if cro_wa_first == '00'
    assign cro_wa_num = cro_wa_num | remove_first: '00'
  else
    assign cro_wa_first = cro_wa_num | slice: 0
    if cro_wa_first == '0'
      assign cro_wa_num = cro_wa_num | remove_first: '0' | prepend: '92'
    endif
  endif
  if cro_wa_num != blank
    assign cro_wa_msg = b.whatsapp_message | default: settings.cro_whatsapp_greeting | replace: ' about {product}', '' | replace: '{product}', shop.name | replace: '{url}', canonical_url | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"'
    assign cro_wa_enc = cro_wa_msg | url_encode
    assign tb_href = 'https://wa.me/' | append: cro_wa_num | append: '?text=' | append: cro_wa_enc
    assign tb_wa = true
  endif
-%}
          {%- capture chip_inner -%}
            {%- if b.icon != 'none' or b.icon_image != blank or b.icon_text != blank -%}<span class="cro-tb__icon">{% render 'cro-icon', icon: b.icon, image: b.icon_image, text: b.icon_text, size: s.icon_size %}</span>{%- endif -%}
            <strong>{{ b.title | escape }}</strong>
            {%- if s.marquee_show_text and b.text != blank -%}<span class="cro-tb__chip-text">{{ b.text | escape }}</span>{%- endif -%}
          {%- endcapture -%}
          {%- if tb_href != blank -%}<a class="cro-tb__chip" href="{{ tb_href }}"{% if tb_wa %} target="_blank" rel="noopener" data-cro-wa="trust"{% endif %}>{{ chip_inner }}</a>{%- else -%}<span class="cro-tb__chip">{{ chip_inner }}</span>{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      <div class="cro-tb__mq cro-mq{% if s.marquee_fade %} cro-mq--fade{% endif %}" data-cro-marquee data-speed="{{ s.marquee_speed }}" data-direction="{{ s.marquee_direction }}" data-pause="true" style="--cro-mq-gap:{{ s.gap }}px">
        <div class="cro-mq__track" data-cro-mq-track>
          <div class="cro-mq__group" data-cro-mq-group>{{ tb_chips }}</div>
          <div class="cro-mq__group" data-cro-mq-clone aria-hidden="true" inert>{{ tb_chips }}</div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CRO trust bar",
  "tag": "div",
  "class": "cro-section cro-section--trust",
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "region_label",
      "label": "Screen-reader label (used when there is no heading)",
      "default": "Why shop with us"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Item style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ]
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Beside text"
        },
        {
          "value": "top",
          "label": "Above text"
        }
      ]
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid / cards"
        },
        {
          "value": "marquee",
          "label": "Scrolling marquee"
        },
        {
          "value": "marquee_mobile",
          "label": "Marquee on mobile, grid on desktop"
        }
      ],
      "info": "The marquee stops and wraps into a still row for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee speed",
      "min": 10,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Marquee direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "marquee_show_text",
      "label": "Show item text in marquee",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "marquee_fade",
      "label": "Fade marquee edges",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "grid",
      "options": [
        {
          "value": "stack",
          "label": "Stacked"
        },
        {
          "value": "grid",
          "label": "2 × 2 grid"
        },
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "Dividers between items (desktop)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Item title size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Item title size (mobile)",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Body text size (desktop)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Body text size (mobile)",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "icon_bg_show",
      "label": "Circle behind icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Colours",
      "info": "Keep text at a 4.5:1 contrast ratio or better against the background and card colours (WCAG AA)."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#18231F"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Item title",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#3F4A45"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "icon_bg",
      "label": "Icon circle",
      "default": "#DCE8D8"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#F7F1E7"
    },
    {
