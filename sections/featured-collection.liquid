{%- assign featured_collection = section.settings.collection -%}
<section class="section scheme--{{ section.settings.scheme }}" data-reveal><div class="page-width"><div class="section-heading"><div class="section-heading__text"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading | default: featured_collection.title }}</h2><p>{{ section.settings.text }}</p></div>{%- if featured_collection != blank -%}<a class="button button--secondary" href="{{ featured_collection.url }}">View all products <span class="button__icon" aria-hidden="true">→</span></a>{%- endif -%}</div><div class="product-grid" style="--columns:{{ section.settings.columns }}">{%- if featured_collection != blank -%}{%- for product in featured_collection.products limit: section.settings.limit -%}{% render 'product-card', card_product: product %}{%- else -%}<p>No products are currently available in this collection.</p>{%- endfor -%}{%- elsif request.design_mode -%}{%- for i in (1..4) -%}<article class="product-card card"><div class="media media--portrait placeholder-media">{{ 'product-' | append: i | placeholder_svg_tag }}<span>Select a featured collection</span></div><div class="product-card__content"><h3>Real product title</h3><p class="muted">Shopify product price</p></div></article>{%- endfor -%}{%- endif -%}</div></div></section>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Pantry favourites"},{"type":"text","id":"heading","label":"Heading","default":"Useful pieces, ready to organise"},{"type":"textarea","id":"text","label":"Text","default":"Choose a collection to display real products, prices and availability from Shopify."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","min":2,"max":12,"step":1,"label":"Products","default":4},{"type":"range","id":"columns","min":2,"max":4,"step":1,"label":"Desktop columns","default":4},{"type":"select","id":"scheme","label":"Colour scheme","default":"white","options":[{"value":"cream","label":"Oat cream"},{"value":"white","label":"Warm white"},{"value":"sage","label":"Sage"}]}],"presets":[{"name":"Featured collection"}]}
{% endschema %}
