<section class="section scheme--{{ section.settings.scheme }} decorative-rings" data-reveal>
  <div class="page-width--wide">
    <div class="section-heading"><div class="section-heading__text"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>{%- if section.settings.button_label != blank -%}<a class="button button--secondary" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label }} <span class="button__icon" aria-hidden="true">→</span></a>{%- endif -%}</div>
    <div class="category-rail" style="--columns:{{ section.settings.columns }}">
      {%- for block in section.blocks -%}{%- assign featured_collection = block.settings.collection -%}
        <a class="category-tile" href="{{ featured_collection.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width:1100px) 20vw, (min-width:750px) 33vw, 78vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.title }}
          {%- elsif featured_collection.image != blank -%}{{ featured_collection.image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width:1100px) 20vw, (min-width:750px) 33vw, 78vw', loading: 'lazy', alt: featured_collection.image.alt | default: featured_collection.title }}
          {%- else -%}<img src="{{ 'pantry-editorial.jpg' | asset_url }}" width="1200" height="1500" loading="lazy" alt="Organised jars and containers on kitchen shelving">{%- endif -%}
          <span class="category-tile__arrow" aria-hidden="true">↗</span>
          <div class="category-tile__content"><h3>{{ block.settings.title | default: featured_collection.title | default: 'Storage collection' }}</h3>{%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}</div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Collection navigator","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Start with a category"},{"type":"text","id":"heading","label":"Heading","default":"A place for everything"},{"type":"textarea","id":"text","label":"Text","default":"Browse useful storage and packaging categories, then narrow the choice using real product details."},{"type":"text","id":"button_label","label":"Button label","default":"View all collections"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"scheme","label":"Colour scheme","default":"cream","options":[{"value":"cream","label":"Oat cream"},{"value":"white","label":"Warm white"},{"value":"sage","label":"Sage"}]},{"type":"range","id":"columns","min":3,"max":5,"step":1,"label":"Desktop columns","default":5}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Custom image"},{"type":"text","id":"title","label":"Custom title"},{"type":"text","id":"text","label":"Supporting text"}]}],"max_blocks":8,"presets":[{"name":"Collection navigator","blocks":[{"type":"collection","settings":{"title":"Jars","text":"For ingredients, treats and more"}},{"type":"collection","settings":{"title":"Food storage","text":"Keep everyday essentials in order"}},{"type":"collection","settings":{"title":"Pantry organisation","text":"Make every shelf easier to use"}},{"type":"collection","settings":{"title":"Bottles & containers","text":"Shapes for a range of uses"}},{"type":"collection","settings":{"title":"Packaging","text":"For makers and small businesses"}}]}]}
{% endschema %}
