{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
{%- liquid
  if s.source == 'all'
    assign src = collections.all
  else
    assign src = s.collection
  endif
  assign shown = 0
-%}
{%- capture cards -%}
  {%- if src != blank -%}
    {%- for product in src.products limit: 50 -%}
      {%- if shown < s.limit -%}
        {%- assign v = product.selected_or_first_available_variant -%}
        {%- assign ok = true -%}
        {%- if s.only_discounted -%}{%- unless v.compare_at_price > v.price -%}{%- assign ok = false -%}{%- endunless -%}{%- endif -%}
        {%- if s.hide_sold_out and product.available == false -%}{%- assign ok = false -%}{%- endif -%}
        {%- if ok -%}
          {%- assign shown = shown | plus: 1 -%}
          <div class="cro-deals__cell">{% render 'cro-product-card', card_product: product, add_label: s.add_label, choose_label: s.choose_label, sold_out_label: s.sold_out_label, low_stock_label: s.low_stock_label, show_rating: s.show_rating, show_low_stock: s.show_low_stock %}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{{ 'cro-components.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cro-commerce.js' | asset_url }}" defer="defer"></script>
{%- liquid
  case s.align
    when 'start'
      assign cro_justify = 'flex-start'
    when 'end'
      assign cro_justify = 'flex-end'
    else
      assign cro_justify = 'center'
  endcase
  assign cro_radius = s.radius | default: 16
  assign cro_btn_radius = s.button_radius | default: 10
-%}
{% style %}
#cro-{{ sid }} {
  --cro-bg: {{ s.bg_color | default: '#F7F1E7' }};
  --cro-heading: {{ s.heading_color | default: '#18231F' }};
  --cro-text: {{ s.text_color | default: '#3F4A45' }};
  --cro-accent: {{ s.accent_color | default: '#D4623D' }};
  --cro-btn-bg: {{ s.button_bg | default: '#173F35' }};
  --cro-btn-text: {{ s.button_text | default: '#FFFDF8' }};
  --cro-btn-hover-bg: {{ s.button_hover_bg | default: '#0F2F27' }};
  --cro-btn-hover-text: {{ s.button_hover_text | default: '#FFFFFF' }};
  --cro-link-hover: {{ s.link_hover_color | default: '#D4623D' }};
  --cro-border: {{ s.border_color | default: '#D7CEC1' }};
  --cro-card-bg: {{ s.card_bg | default: '#FFFDF8' }};
  --cro-icon: {{ s.icon_color | default: '#173F35' }};
  --cro-badge-bg: {{ s.badge_bg | default: '#C64F32' }};
  --cro-badge-text: {{ s.badge_text | default: '#FFFFFF' }};
  --cro-radius: {{ cro_radius }}px;
  --cro-justify: {{ cro_justify }};
  background: var(--cro-bg);
  color: var(--cro-text);
  padding-block: {{ s.padding_top_mobile | default: 40 }}px {{ s.padding_bottom_mobile | default: 40 }}px;
}
#cro-{{ sid }}[hidden] { display: none; }
#cro-{{ sid }} .cro-wrap { box-sizing: border-box; max-inline-size: {% if s.full_width %}none{% else %}{{ s.container_width | default: 1300 }}px{% endif %}; margin-inline: auto; padding-inline: var(--gutter, 16px); }
#cro-{{ sid }} .cro-head { display: flex; flex-direction: column; align-items: {{ cro_justify }}; gap: 8px; margin-block-end: 28px; text-align: {{ s.align | default: 'center' }}; }
#cro-{{ sid }} .cro-head--row { flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; text-align: start; }
#cro-{{ sid }} .cro-eyebrow { margin: 0; color: var(--cro-accent); font-weight: 700; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }
#cro-{{ sid }} .cro-h { margin: 0; color: var(--cro-heading); font-family: var(--font-heading); font-weight: var(--font-heading-weight, 700); font-size: {{ s.heading_size_mobile | default: 28 }}px; line-height: 1.15; }
#cro-{{ sid }} .cro-sub { margin: 0; max-inline-size: 680px; font-size: {{ s.text_size_mobile | default: 15 }}px; line-height: 1.55; }
#cro-{{ sid }} .cro-body { font-size: {{ s.text_size_mobile | default: 15 }}px; line-height: 1.55; }
#cro-{{ sid }} .cro-body > :first-child { margin-block-start: 0; }
#cro-{{ sid }} .cro-body > :last-child { margin-block-end: 0; }
#cro-{{ sid }} .cro-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-sizing: border-box;
  min-block-size: 48px; padding: 0 24px; border: 0; border-radius: {{ cro_btn_radius }}px;
  background: var(--cro-btn-bg); color: var(--cro-btn-text); font: inherit; font-weight: 700; line-height: 1.2;
  text-decoration: none; cursor: pointer; transition: background-color .2s ease, color .2s ease, transform .2s ease;
}
#cro-{{ sid }} .cro-btn:hover { background: var(--cro-btn-hover-bg); color: var(--cro-btn-hover-text); }
#cro-{{ sid }} .cro-btn[disabled] { opacity: .55; cursor: not-allowed; }
#cro-{{ sid }} .cro-btn--ghost { background: transparent; color: var(--cro-heading); box-shadow: inset 0 0 0 2px currentColor; }
#cro-{{ sid }} .cro-btn--ghost:hover { background: var(--cro-btn-bg); color: var(--cro-btn-text); box-shadow: none; }
#cro-{{ sid }} .cro-link { color: var(--cro-heading); text-decoration: underline; text-underline-offset: 4px; }
#cro-{{ sid }} .cro-link:hover { color: var(--cro-link-hover); }
#cro-{{ sid }} .cro-card { background: var(--cro-card-bg); border: 1px solid var(--cro-border); border-radius: var(--cro-radius); }
#cro-{{ sid }} .cro-ico { display: inline-flex; flex: none; align-items: center; justify-content: center; color: var(--cro-icon); }
#cro-{{ sid }} .cro-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; background: var(--cro-badge-bg); color: var(--cro-badge-text); font-size: 12px; font-weight: 700; letter-spacing: .03em; }
#cro-{{ sid }} a:focus-visible, #cro-{{ sid }} button:focus-visible, #cro-{{ sid }} summary:focus-visible, #cro-{{ sid }} input:focus-visible, #cro-{{ sid }} select:focus-visible { outline: 2px solid var(--cro-accent); outline-offset: 2px; }
@media (min-width: 750px) {
  #cro-{{ sid }} { padding-block: {{ s.padding_top_desktop | default: 64 }}px {{ s.padding_bottom_desktop | default: 64 }}px; }
  #cro-{{ sid }} .cro-h { font-size: {{ s.heading_size_desktop | default: 38 }}px; }
  #cro-{{ sid }} .cro-sub, #cro-{{ sid }} .cro-body { font-size: {{ s.text_size_desktop | default: 17 }}px; }
}


#cro-{{ sid }} .cro-grid { --cro-cols-d: {{ s.columns_desktop }}; --cro-cols-t: {{ s.columns_tablet }}; --cro-cols-m: {{ s.columns_mobile }}; }
#cro-{{ sid }} { --cro-cd-box-bg: {{ s.cd_box_bg }}; --cro-cd-digit: {{ s.cd_digit }}; --cro-cd-label: {{ s.cd_label }}; --cro-cd-sep: {{ s.cd_digit }}; --cro-cd-urgent: {{ s.cd_urgent }}; }
#cro-{{ sid }} .cro-deals__strip { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 16px; margin-block-end: 24px; padding: 12px 16px; border-radius: var(--cro-radius); background: {{ s.strip_bg }}; color: {{ s.strip_text }}; font-weight: 700; }
#cro-{{ sid }} .cro-deals__more { display: flex; justify-content: center; margin-block-start: 28px; }
#cro-{{ sid }} .cro-car { position: relative; }
#cro-{{ sid }} .cro-car .cro-grid { display: grid; grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: calc((100% - (var(--cro-cols-m) - 1) * 14px) / var(--cro-cols-m) * .92); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
#cro-{{ sid }} .cro-car .cro-grid::-webkit-scrollbar { display: none; }
#cro-{{ sid }} .cro-car .cro-deals__cell { scroll-snap-align: start; }
#cro-{{ sid }} .cro-car__nav { display: none; }
@media (min-width: 750px) { #cro-{{ sid }} .cro-car .cro-grid { grid-auto-columns: calc((100% - (var(--cro-cols-t) - 1) * 20px) / var(--cro-cols-t)); } }
@media (min-width: 990px) {
  #cro-{{ sid }} .cro-car .cro-grid { grid-auto-columns: calc((100% - (var(--cro-cols-d) - 1) * 20px) / var(--cro-cols-d)); }
  #cro-{{ sid }} .cro-car.is-scrollable .cro-car__nav { position: absolute; inset-block-start: 35%; z-index: 2; display: inline-flex; align-items: center; justify-content: center; inline-size: 44px; block-size: 44px; border: 0; border-radius: 50%; background: var(--cro-card-bg); box-shadow: 0 4px 14px rgba(15, 47, 39, .15); cursor: pointer; }
  #cro-{{ sid }} .cro-car__nav--prev { inset-inline-start: -16px; }
  #cro-{{ sid }} .cro-car__nav--next { inset-inline-end: -16px; }
  #cro-{{ sid }} .cro-car__nav[disabled] { opacity: .35; }
}

{% endstyle %}

{%- if cards != blank or request.design_mode -%}
<section id="cro-{{ sid }}" class="cro-deals" aria-labelledby="CroHeading-{{ sid }}"{% if s.countdown_mode == 'fixed' and s.on_expire == 'hide' %} data-cro-expire-scope="hide"{% endif %}>
  <div class="cro-wrap">
    {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
      <div class="cro-head">
        {%- if s.eyebrow != blank -%}<p class="cro-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cro-h" id="CroHeading-{{ sid }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="cro-sub">{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.countdown_mode != 'none' -%}
      <div class="cro-deals__strip">
        {%- if s.strip_text_label != blank -%}<span>{{ s.strip_text_label | escape }}</span>{%- endif -%}
        {% render 'cro-countdown', id: sid, mode: s.countdown_mode, end: s.countdown_end, prefix: '', style: s.countdown_style, show_days: true, separator: ':', label_d: s.label_days, label_h: s.label_hours, label_m: s.label_minutes, label_s: s.label_seconds, urgent: 60, expire_action: 'hide', fallback: s.countdown_fallback %}
      </div>
    {%- endif -%}
    {%- if cards == blank -%}<p>{{ s.editor_note | escape }}</p>{%- endif -%}
    {%- if s.layout == 'carousel' -%}
      <div class="cro-car" data-cro-carousel>
        <button class="cro-car__nav cro-car__nav--prev" type="button" data-cro-carousel-prev aria-label="{{ s.prev_label | escape }}">{% render 'cro-icon', icon: 'chevron-left', size: 20 %}</button>
        <div class="cro-grid" data-cro-carousel-track>{{ cards }}</div>
        <button class="cro-car__nav cro-car__nav--next" type="button" data-cro-carousel-next aria-label="{{ s.next_label | escape }}">{% render 'cro-icon', icon: 'chevron-right', size: 20 %}</button>
      </div>
    {%- else -%}
      <div class="cro-grid">{{ cards }}</div>
    {%- endif -%}
    {%- if s.view_all_label != blank -%}
      <div class="cro-deals__more"><a class="cro-btn" href="{% if s.view_all_link != blank %}{{ s.view_all_link }}{% elsif s.source == 'collection' and s.collection != blank %}{{ s.collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ s.view_all_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CRO deal products",
  "tag": "div",
  "class": "cro-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited-time deals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Today's best prices"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real sale prices, straight from the catalogue."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        {
          "value": "collection",
          "label": "A collection"
        },
        {
          "value": "all",
          "label": "All products"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "only_discounted",
      "label": "Only products with a compare-at (sale) price",
      "default": true,
      "info": "Checks the first 50 products of the source. The section hides itself when nothing matches."
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold-out products",
      "default": true
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all deals"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "text",
      "id": "editor_note",
      "label": "Theme editor note",
      "default": "No matching products yet. Add compare-at prices in Shopify to show deals here."
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous label",
      "default": "Previous products"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next label",
      "default": "Next products"
    },
    {
      "type": "header",
      "content": "Countdown strip"
    },
    {
      "type": "select",
      "id": "countdown_mode",
      "label": "Countdown",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fixed",
          "label": "Offer ends at a date and time"
        },
        {
          "value": "daily",
          "label": "Daily dispatch cut-off"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "End date and time",
      "info": "YYYY-MM-DD HH:MM in the shop timezone.",
      "placeholder": "2026-12-02 23:59"
    },
    {
      "type": "text",
      "id": "strip_text_label",
      "label": "Strip text",
      "default": "Sale ends in"
    },
    {
      "type": "text",
      "id": "countdown_fallback",
      "label": "Text before the timer loads"
    },
    {
      "type": "select",
      "id": "countdown_style",
      "label": "Style",
      "options": [
        {
          "value": "boxes",
          "label": "Boxes"
        },
        {
          "value": "inline",
          "label": "Inline"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "circular",
          "label": "Circular"
        }
      ],
      "default": "inline"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Days label",
      "default": "d"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Hours label",
      "default": "h"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Minutes label",
      "default": "m"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Seconds label",
      "default": "s"
    },
    {
      "type": "select",
      "id": "on_expire",
      "label": "When the countdown ends",
      "options": [
        {
          "value": "hide",
          "label": "Hide the whole section"
        },
        {
          "value": "keep",
          "label": "Keep the products, hide the timer"
        }
      ],
      "default": "keep"
    },
    {
      "type": "header",
      "content": "Product card labels"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "choose_label",
      "label": "Choose options label",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold-out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "low_stock_label",
      "label": "Low-stock label",
      "default": "Only {count} left"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating (real review data only)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_low_stock",
      "label": "Show low-stock note (real inventory only)",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "default": 1300,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns (tablet)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 16,
      "max": 72,
      "step": 2,
      "default": 38,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 56,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Body text size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Body text size (mobile)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colours",
      "info": "Keep text at a 4.5:1 contrast ratio or better against its background (WCAG AA)."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#18231F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3F4A45"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (eyebrow, focus ring)",
      "default": "#D4623D"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#0F2F27"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#D4623D"
    },
    {
      "type": "color",
