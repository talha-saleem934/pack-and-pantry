{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
{%- liquid
  assign rt = blank
  if product.metafields.reviews.rating.value != blank
    assign rt = product.metafields.reviews.rating.value.rating | round: 1
    assign rt_max = product.metafields.reviews.rating.value.scale_max | default: 5
    assign rt_count = product.metafields.reviews.rating_count.value | default: 0
  elsif product.metafields.custom.rating.value != blank
    assign rt = product.metafields.custom.rating.value | round: 1
    assign rt_max = 5
    assign rt_count = product.metafields.custom.review_count.value | default: 0
  endif
-%}
{{ 'cro-components.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-core.js' | asset_url }}" defer="defer"></script>
{%- liquid
  case s.align
    when 'start'
      assign cro_justify = 'flex-start'
    when 'end'
      assign cro_justify = 'flex-end'
    else
      assign cro_justify = 'center'
  endcase
  assign cro_radius = s.radius | default: 16
  assign cro_btn_radius = s.button_radius | default: 10
-%}
{% style %}
#cro-{{ sid }} {
  --cro-bg: {{ s.bg_color | default: '#F7F1E7' }};
  --cro-heading: {{ s.heading_color | default: '#18231F' }};
  --cro-text: {{ s.text_color | default: '#3F4A45' }};
  --cro-accent: {{ s.accent_color | default: '#D4623D' }};
  --cro-btn-bg: {{ s.button_bg | default: '#173F35' }};
  --cro-btn-text: {{ s.button_text | default: '#FFFDF8' }};
  --cro-btn-hover-bg: {{ s.button_hover_bg | default: '#0F2F27' }};
  --cro-btn-hover-text: {{ s.button_hover_text | default: '#FFFFFF' }};
  --cro-link-hover: {{ s.link_hover_color | default: '#D4623D' }};
  --cro-border: {{ s.border_color | default: '#D7CEC1' }};
  --cro-card-bg: {{ s.card_bg | default: '#FFFDF8' }};
  --cro-icon: {{ s.icon_color | default: '#173F35' }};
  --cro-badge-bg: {{ s.badge_bg | default: '#C64F32' }};
  --cro-badge-text: {{ s.badge_text | default: '#FFFFFF' }};
  --cro-radius: {{ cro_radius }}px;
  --cro-justify: {{ cro_justify }};
  background: var(--cro-bg);
  color: var(--cro-text);
  padding-block: {{ s.padding_top_mobile | default: 40 }}px {{ s.padding_bottom_mobile | default: 40 }}px;
}
#cro-{{ sid }}[hidden] { display: none; }
#cro-{{ sid }} .cro-wrap { box-sizing: border-box; max-inline-size: {% if s.full_width %}none{% else %}{{ s.container_width | default: 1300 }}px{% endif %}; margin-inline: auto; padding-inline: var(--gutter, 16px); }
#cro-{{ sid }} .cro-head { display: flex; flex-direction: column; align-items: {{ cro_justify }}; gap: 8px; margin-block-end: 28px; text-align: {{ s.align | default: 'center' }}; }
#cro-{{ sid }} .cro-head--row { flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; text-align: start; }
#cro-{{ sid }} .cro-eyebrow { margin: 0; color: var(--cro-accent); font-weight: 700; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }
#cro-{{ sid }} .cro-h { margin: 0; color: var(--cro-heading); font-family: var(--font-heading); font-weight: var(--font-heading-weight, 700); font-size: {{ s.heading_size_mobile | default: 28 }}px; line-height: 1.15; }
#cro-{{ sid }} .cro-sub { margin: 0; max-inline-size: 680px; font-size: {{ s.text_size_mobile | default: 15 }}px; line-height: 1.55; }
#cro-{{ sid }} .cro-body { font-size: {{ s.text_size_mobile | default: 15 }}px; line-height: 1.55; }
#cro-{{ sid }} .cro-body > :first-child { margin-block-start: 0; }
#cro-{{ sid }} .cro-body > :last-child { margin-block-end: 0; }
#cro-{{ sid }} .cro-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-sizing: border-box;
  min-block-size: 48px; padding: 0 24px; border: 0; border-radius: {{ cro_btn_radius }}px;
  background: var(--cro-btn-bg); color: var(--cro-btn-text); font: inherit; font-weight: 700; line-height: 1.2;
  text-decoration: none; cursor: pointer; transition: background-color .2s ease, color .2s ease, transform .2s ease;
}
#cro-{{ sid }} .cro-btn:hover { background: var(--cro-btn-hover-bg); color: var(--cro-btn-hover-text); }
#cro-{{ sid }} .cro-btn[disabled] { opacity: .55; cursor: not-allowed; }
#cro-{{ sid }} .cro-btn--ghost { background: transparent; color: var(--cro-heading); box-shadow: inset 0 0 0 2px currentColor; }
#cro-{{ sid }} .cro-btn--ghost:hover { background: var(--cro-btn-bg); color: var(--cro-btn-text); box-shadow: none; }
#cro-{{ sid }} .cro-link { color: var(--cro-heading); text-decoration: underline; text-underline-offset: 4px; }
#cro-{{ sid }} .cro-link:hover { color: var(--cro-link-hover); }
#cro-{{ sid }} .cro-card { background: var(--cro-card-bg); border: 1px solid var(--cro-border); border-radius: var(--cro-radius); }
#cro-{{ sid }} .cro-ico { display: inline-flex; flex: none; align-items: center; justify-content: center; color: var(--cro-icon); }
#cro-{{ sid }} .cro-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; background: var(--cro-badge-bg); color: var(--cro-badge-text); font-size: 12px; font-weight: 700; letter-spacing: .03em; }
#cro-{{ sid }} a:focus-visible, #cro-{{ sid }} button:focus-visible, #cro-{{ sid }} summary:focus-visible, #cro-{{ sid }} input:focus-visible, #cro-{{ sid }} select:focus-visible { outline: 2px solid var(--cro-accent); outline-offset: 2px; }
@media (min-width: 750px) {
  #cro-{{ sid }} { padding-block: {{ s.padding_top_desktop | default: 64 }}px {{ s.padding_bottom_desktop | default: 64 }}px; }
  #cro-{{ sid }} .cro-h { font-size: {{ s.heading_size_desktop | default: 38 }}px; }
  #cro-{{ sid }} .cro-sub, #cro-{{ sid }} .cro-body { font-size: {{ s.text_size_desktop | default: 17 }}px; }
}



#cro-{{ sid }} { --cro-star-color: {{ s.star_color }}; }
#cro-{{ sid }} .cro-rh { display: grid; gap: 20px; }
#cro-{{ sid }} .cro-rh__summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: var(--cro-justify); gap: 12px; }
#cro-{{ sid }} .cro-rh__score { color: var(--cro-heading); font-size: 40px; font-weight: 700; font-family: var(--font-heading); }
#cro-{{ sid }} .cro-rh__summary .cro-stars { --cro-star-size: 22px; }
#cro-{{ sid }} .cro-rh__list { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
#cro-{{ sid }} .cro-rh__card { display: grid; gap: 8px; padding: 18px; }
#cro-{{ sid }} .cro-rh__meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; }
#cro-{{ sid }} .cro-rh__name { color: var(--cro-heading); font-weight: 700; }
#cro-{{ sid }} .cro-rh__verified { color: {{ s.verified_color }}; font-weight: 700; display: inline-flex; gap: 4px; align-items: center; }
#cro-{{ sid }} .cro-rh__card .cro-stars { --cro-star-size: 16px; }
#cro-{{ sid }} .cro-rh__photo { inline-size: 64px; block-size: 64px; border-radius: 8px; object-fit: cover; }
@media (min-width: 750px) { #cro-{{ sid }} .cro-rh__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

{% endstyle %}

{%- if rt != blank or section.blocks.size > 0 -%}
<section id="cro-{{ sid }}" class="cro-pdp-reviews" aria-labelledby="CroHeading-{{ sid }}">
  <div class="cro-wrap cro-rh">
    {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
      <div class="cro-head">
        {%- if s.eyebrow != blank -%}<p class="cro-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cro-h" id="CroHeading-{{ sid }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="cro-sub">{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if rt != blank -%}
      {%- assign rt_pct = rt | times: 100.0 | divided_by: rt_max -%}
      <div class="cro-rh__summary">
        <span class="cro-rh__score">{{ rt }}</span>
        <span class="cro-stars" style="--cro-stars:{{ rt_pct }}%" aria-hidden="true"></span>
        <span class="cro-vh">{{ s.sr_label | replace: '{rating}', rt | replace: '{max}', rt_max | escape }}</span>
        {%- if rt_count > 0 -%}<span>{{ s.count_label | replace: '{count}', rt_count | escape }}</span>{%- endif -%}
        {%- if s.anchor != blank -%}<a class="cro-btn cro-btn--ghost" href="{{ s.anchor | escape }}">{{ s.see_all_label | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="cro-rh__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="cro-rh__card cro-card" {{ block.shopify_attributes }}>
            {%- assign b_pct = b.rating | times: 20 -%}
            <span class="cro-stars" style="--cro-stars:{{ b_pct }}%" aria-hidden="true"></span><span class="cro-vh">{{ b.rating }} / 5</span>
            <div class="cro-body">{{ b.text }}</div>
            <div class="cro-rh__meta">
              {%- if b.photo != blank -%}{{ b.photo | image_url: width: 160 | image_tag: class: 'cro-rh__photo', loading: 'lazy', alt: b.photo_alt }}{%- endif -%}
              <span class="cro-rh__name">{{ b.name | escape }}</span>
              {%- if b.city != blank -%}<span>{{ b.city | escape }}</span>{%- endif -%}
              {%- if b.verified -%}<span class="cro-rh__verified">{% render 'cro-icon', icon: 'check', size: 14 %}{{ s.verified_label | escape }}</span>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CRO reviews highlight",
  "tag": "div",
  "class": "cro-section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Rating summary",
      "info": "Uses the real rating from Judge.me / Shopify reviews metafields, else custom.rating and custom.review_count. Review cards below must be real customer reviews."
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Review count text",
      "default": "Based on {count} reviews"
    },
    {
      "type": "text",
      "id": "sr_label",
      "label": "Screen-reader text",
      "default": "Rated {rating} out of {max}"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "See all reviews link",
      "default": "#judgeme_product_reviews"
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "See all label",
      "default": "Read all reviews"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified label",
      "default": "Verified buyer"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "default": 1300,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 16,
      "max": 72,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 56,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Body text size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Body text size (mobile)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colours",
      "info": "Keep text at a 4.5:1 contrast ratio or better against its background (WCAG AA)."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#18231F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#3F4A45"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (eyebrow, focus ring)",
      "default": "#D4623D"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#0F2F27"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover",
      "default": "#D4623D"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D7CEC1"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#C64F32"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars",
      "default": "#E8B44A"
    },
    {
      "type": "color",
      "id": "verified_color",
      "label": "Verified label",
      "default": "#2F6F4E"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Featured review",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "city",
          "label": "City"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Review text",
          "info": "Paste a real review exactly as written."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified purchase",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "photo_alt",
          "label": "Photo alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CRO reviews highlight"
    }
  ]
}
{% endschema %}
