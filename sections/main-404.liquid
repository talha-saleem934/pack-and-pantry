<section class="section page-width narrow text-center"><p class="eyebrow">404</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p><div style="display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem"><a class="button" href="{{ routes.all_products_collection_url }}">View All Products</a><a class="button button--secondary" href="{{ routes.root_url }}">Return home</a></div></section>
{% schema %}{"name":"404 page","settings":[{"type":"text","id":"heading","label":"Heading","default":"This shelf is empty"},{"type":"textarea","id":"text","label":"Text","default":"The page may have moved, but there are plenty of useful storage solutions to explore."}]}{% endschema %}
