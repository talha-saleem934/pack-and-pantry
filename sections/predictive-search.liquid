{%- if predictive_search.performed -%}
  <div id="predictive-search-results">
    {%- if predictive_search.resources.products.size > 0 -%}<p class="eyebrow">Products</p><ul role="listbox">{%- for product in predictive_search.resources.products -%}<li class="predictive-item" role="option"><a href="{{ product.url }}">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 112 | image_tag: width: 56, height: 56, alt: product.featured_image.alt | default: product.title }}{%- endif -%}<span><strong>{{ product.title }}</strong><br>{{ product.price | money }}</span></a></li>{%- endfor -%}</ul>{%- endif -%}
    {%- if predictive_search.resources.collections.size > 0 -%}<p class="eyebrow">Collections</p><ul role="listbox">{%- for collection in predictive_search.resources.collections -%}<li class="predictive-item" role="option"><a href="{{ collection.url }}"><span>{{ collection.title }}</span></a></li>{%- endfor -%}</ul>{%- endif -%}
    <a class="button button--secondary button--full" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}">Search for “{{ predictive_search.terms }}”</a>
  </div>
{%- endif -%}
{% schema %}{"name":"Predictive search","settings":[]}{% endschema %}
