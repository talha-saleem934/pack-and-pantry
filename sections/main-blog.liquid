{% render 'breadcrumbs' %}
<section class="section page-width">
  <header class="section-heading"><div><p class="eyebrow">Ideas and guidance</p><h1>{{ blog.title }}</h1></div></header>
  {%- paginate blog.articles by section.settings.articles_per_page -%}
    <div class="article-list">
      {%- for article in blog.articles -%}
        <article class="article-card card">
          <a class="media media--portrait" href="{{ article.url }}">{%- if article.image -%}{{ article.image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt | default: article.title }}{%- else -%}<div class="placeholder-media">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{%- endif -%}</a>
          <div class="article-card__content"><p class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</p><h2 style="font-size:1.4rem"><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncate: 150 }}</p><a href="{{ article.url }}">Read article</a></div>
        </article>
      {%- else -%}
        <p>No articles have been published yet.</p>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>
{% schema %}{"name":"Blog","settings":[{"type":"range","id":"articles_per_page","min":3,"max":18,"step":3,"label":"Articles per page","default":9}]}{% endschema %}
