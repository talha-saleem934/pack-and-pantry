<section class="section section--compact" data-reveal><div class="page-width narrow text-center"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>{%- if section.settings.button_label != blank -%}<p><a class="button" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label }}</a></p>{%- endif -%}</div></section>
{% schema %}
{"name":"Rich text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Pack & Pantry"},{"type":"text","id":"heading","label":"Heading","default":"Practical storage, thoughtfully presented"},{"type":"richtext","id":"text","label":"Text","default":"<p>We help homes and food businesses find attractive, reliable ways to store, organise and package what matters.</p>"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Rich text"}]}
{% endschema %}
