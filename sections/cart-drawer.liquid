<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
<div data-cart-drawer-section data-section-id="{{ section.id }}">
  <cart-drawer class="cart-drawer" data-cart-drawer aria-hidden="true">
    <button class="cart-drawer__overlay" type="button" data-cart-close tabindex="-1" aria-label="{{ 'accessibility.close' | t }}"></button>
    <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
      <header class="cart-drawer__header"><h2 id="CartDrawerTitle">Your cart <span class="muted">({{ cart.item_count }})</span></h2><button class="icon-button" type="button" data-cart-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button></header>
      <div class="cart-drawer__content">
        {%- if cart.item_count > 0 -%}<div class="cart-drawer__items">{%- for item in cart.items -%}<article class="cart-drawer__item">{%- if item.image -%}<a href="{{ item.url }}">{{ item.image | image_url: width: 220 | image_tag: width: 88, height: 110, loading: 'lazy', alt: item.image.alt | default: item.product.title }}</a>{%- endif -%}<div><h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>{%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}{%- if item.selling_plan_allocation -%}<p class="muted">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}<div class="quantity" data-drawer-quantity><button type="button" data-cart-change="{{ item.index }}" data-quantity="{{ item.quantity | minus: 1 }}" aria-label="Decrease {{ item.product.title }} quantity">{% render 'icon', icon: 'minus' %}</button><input type="number" value="{{ item.quantity }}" min="0" readonly aria-label="Quantity for {{ item.product.title }}"><button type="button" data-cart-change="{{ item.index }}" data-quantity="{{ item.quantity | plus: 1 }}" aria-label="Increase {{ item.product.title }} quantity">{% render 'icon', icon: 'plus' %}</button></div><button class="link-button" type="button" data-cart-change="{{ item.index }}" data-quantity="0">Remove</button></div><strong class="cart-drawer__item-price">{{ item.final_line_price | money }}</strong></article>{%- endfor -%}</div>
        {%- else -%}<div class="empty-state"><div class="feature__icon" style="margin-inline:auto">{% render 'icon', icon: 'cart' %}</div><h3>Your cart is ready for something useful.</h3><p>Explore jars, storage and packaging for your next shelf or project.</p><a class="button" href="{{ routes.all_products_collection_url }}">Shop storage</a></div>{%- endif -%}
      </div>
      {%- if cart.item_count > 0 -%}<footer class="cart-drawer__footer"><div class="cart-drawer__total"><span>Subtotal</span><strong>{{ cart.total_price | money_with_currency }}</strong></div><p class="muted">Taxes, discounts and shipping are calculated at checkout.</p><div class="cart-drawer__actions"><a class="button button--secondary" href="{{ routes.cart_url }}">View cart</a><form action="{{ routes.cart_url }}" method="post"><button class="button button--full" type="submit" name="checkout">Checkout</button></form></div></footer>{%- endif -%}
    </div>
  </cart-drawer>
  <dialog class="quick-add-dialog" data-quick-add-dialog><button class="icon-button quick-add-dialog__close" type="button" data-quick-add-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button><div data-quick-add-content></div></dialog>
</div>
{% schema %}{"name":"Cart drawer","settings":[]}{% endschema %}
