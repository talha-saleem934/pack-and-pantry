<section class="hero"><div class="page-width"><div class="hero__content hero__content--center"><img src="{{ 'pack-and-pantry-logo.png' | asset_url }}" width="220" height="220" alt="Pack & Pantry" style="margin:0 auto 1.5rem;filter:invert(1)"><p class="eyebrow">Opening soon</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p>{%- form 'storefront_password' -%}{%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="search-form"><label class="visually-hidden" for="Password">Store password</label><input class="input" id="Password" type="password" name="password" placeholder="Store password"><button class="button button--accent" type="submit">Enter store</button></div>{%- endform -%}</div></div></section>
{% schema %}{"name":"Password page","settings":[{"type":"text","id":"heading","label":"Heading","default":"We’re organising something useful"},{"type":"textarea","id":"text","label":"Text","default":"Pack & Pantry is preparing practical storage and packaging solutions for homes and food businesses."}]}{% endschema %}
