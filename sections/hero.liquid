<section class="hero hero--editorial" data-reveal>
  <div class="page-width--wide hero__layout">
    <div class="hero__content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <div class="rte">{{ section.settings.text }}</div>
      <div class="hero__actions">
        {%- if section.settings.primary_label != blank -%}<a class="button button--accent" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label }} <span class="button__icon" aria-hidden="true">→</span></a>{%- endif -%}
        {%- if section.settings.secondary_label != blank -%}<a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="hero__visual" aria-label="{{ section.settings.image_alt | escape }}">
      <span class="hero__shape" aria-hidden="true"></span>
      <div class="hero__visual-frame">
        {%- if section.settings.image != blank -%}
          <picture>{%- if section.settings.mobile_image != blank -%}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{%- endif -%}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '640, 900, 1200, 1500, 1800', sizes: '(min-width:990px) 48vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt | default: section.settings.image.alt }}</picture>
        {%- else -%}
          <img src="{{ 'pantry-hero.jpg' | asset_url }}" width="1800" height="1350" loading="eager" fetchpriority="high" alt="{{ section.settings.image_alt | escape }}">
        {%- endif -%}
      </div>
      {%- if section.settings.stamp != blank -%}<div class="hero__stamp">{{ section.settings.stamp }}</div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Editorial hero","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"image_alt","label":"Image alt text","default":"An organised kitchen shelf with glass storage jars"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Storage with purpose"},{"type":"text","id":"heading","label":"Heading","default":"Good things, neatly kept."},{"type":"richtext","id":"text","label":"Text","default":"<p>Jars, storage and packaging for organised homes and growing food businesses.</p>"},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop storage"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore packaging"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"stamp","label":"Round label","default":"Find your container"}],"presets":[{"name":"Editorial hero"}]}
{% endschema %}
