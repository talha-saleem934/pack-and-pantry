{% render 'breadcrumbs' %}<article class="section page-width"><header class="article__header"><p class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}{% if section.settings.show_author %} · {{ article.author }}{% endif %}</p><h1>{{ article.title }}</h1></header>{%- if article.image -%}{{ article.image | image_url: width: 1800 | image_tag: widths: '750, 1100, 1500, 1800', sizes: 'min(1100px, 100vw)', class: 'article__featured', loading: 'eager', alt: article.image.alt | default: article.title }}{%- endif -%}<div class="article__content rte">{{ article.content }}</div>{%- if blog.previous_article or blog.next_article -%}<nav class="article__content" aria-label="Article navigation" style="display:flex;justify-content:space-between;margin-top:3rem">{%- if blog.previous_article -%}<a href="{{ blog.previous_article.url }}">← {{ blog.previous_article.title }}</a>{%- endif -%}{%- if blog.next_article -%}<a href="{{ blog.next_article.url }}">{{ blog.next_article.title }} →</a>{%- endif -%}</nav>{%- endif -%}</article>
{% schema %}{"name":"Article","settings":[{"type":"checkbox","id":"show_author","label":"Show author","default":false}]}{% endschema %}
