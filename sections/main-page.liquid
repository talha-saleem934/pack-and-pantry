{% render 'breadcrumbs' %}
<section class="section page-width narrow">
  <h1>{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="rte">{{ page.content }}</div>
  {%- elsif request.design_mode -%}
    <p class="muted">Add this page's verified content in Shopify Admin → Online Store → Pages.</p>
  {%- endif -%}
</section>
{% schema %}{"name":"Page","settings":[]}{% endschema %}
