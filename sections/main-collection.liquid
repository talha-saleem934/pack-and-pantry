{% render 'breadcrumbs' %}
<header class="collection-hero"><div class="page-width collection-hero__inner"><div><p class="eyebrow">Pack & Pantry collection</p><h1>{{ collection.title }}</h1>{%- if collection.description != blank -%}<div class="rte muted">{{ collection.description }}</div>{%- endif -%}</div>{%- if collection.image -%}{{ collection.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 38vw, 100vw', class: 'collection-hero__image', loading: 'eager', alt: collection.image.alt | default: collection.title }}{%- endif -%}</div></header>
<section class="section section--compact"><div class="page-width">
  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="collection-toolbar"><div><strong>{{ 'collections.general.items_with_count' | t: count: collection.products_count }}</strong></div><div style="display:flex;gap:.6rem"><button class="button button--secondary mobile-filter-toggle" type="button" data-filter-open>{{ 'collections.general.filter' | t }}</button><label class="visually-hidden" for="SortBy">{{ 'collections.general.sort' | t }}</label><select id="SortBy" data-sort-by><option value="manual"{% if collection.sort_by == 'manual' %} selected{% endif %}>Featured</option><option value="best-selling"{% if collection.sort_by == 'best-selling' %} selected{% endif %}>Best selling</option><option value="title-ascending"{% if collection.sort_by == 'title-ascending' %} selected{% endif %}>Alphabetically, A–Z</option><option value="price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Price, low to high</option><option value="price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Price, high to low</option><option value="created-descending"{% if collection.sort_by == 'created-descending' %} selected{% endif %}>Newest</option></select></div></div>
    <div class="active-facets">{%- for filter in collection.filters -%}{%- for value in filter.active_values -%}<a class="active-facet" href="{{ value.url_to_remove }}">{{ value.label }} ×</a>{%- endfor -%}{%- if filter.type == 'price_range' -%}{%- if filter.min_value.value != nil or filter.max_value.value != nil -%}<a class="active-facet" href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} ×</a>{%- endif -%}{%- endif -%}{%- endfor -%}</div>
    <div class="collection-layout">
      <aside class="facets" data-facets aria-label="Product filters"><div style="display:flex;align-items:center;justify-content:space-between"><h2 style="font-size:1.2rem">{{ 'collections.general.filter' | t }}</h2><button class="icon-button mobile-filter-toggle" type="button" data-filter-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button></div><form action="{{ collection.url }}" method="get">{%- for filter in collection.filters -%}<details class="facets__group" open><summary>{{ filter.label }}</summary><div class="facets__values">{%- case filter.type -%}{%- when 'boolean', 'list' -%}{%- for value in filter.values -%}<label class="facets__value"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}> <span>{{ value.label }} ({{ value.count }})</span></label>{%- endfor -%}{%- when 'price_range' -%}<div class="grid grid--2"><div class="field"><label for="Filter-{{ filter.label | handle }}-GTE">From</label><input class="input" id="Filter-{{ filter.label | handle }}-GTE" name="{{ filter.min_value.param_name }}" type="number" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" placeholder="0" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"></div><div class="field"><label for="Filter-{{ filter.label | handle }}-LTE">To</label><input class="input" id="Filter-{{ filter.label | handle }}-LTE" name="{{ filter.max_value.param_name }}" type="number" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"></div></div>{%- endcase -%}</div></details>{%- endfor -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}"><p><button class="button button--full" type="submit">{{ 'collections.general.apply' | t }}</button></p><a href="{{ collection.url }}">{{ 'collections.general.clear_all' | t }}</a></form></aside>
      <div>{%- if collection.products.size > 0 -%}<div class="product-grid" style="--columns:{{ section.settings.columns }}">{%- for product in collection.products -%}{% render 'product-card', card_product: product %}{%- endfor -%}</div>{% render 'pagination', paginate: paginate %}{%- else -%}<div class="empty-state"><h2>{{ 'collections.general.empty' | t }}</h2><a class="button" href="{{ collection.url }}">{{ 'collections.general.clear_all' | t }}</a></div>{%- endif -%}</div>
    </div>
  {%- endpaginate -%}
</div></section>
{% schema %}
{"name":"Collection products","settings":[{"type":"range","id":"products_per_page","min":8,"max":36,"step":4,"label":"Products per page","default":24},{"type":"range","id":"columns","min":2,"max":4,"step":1,"label":"Desktop columns","default":3}]}
{% endschema %}
