{% render 'breadcrumbs' %}
<section class="section section--compact page-width" data-main-product data-section-id="{{ section.id }}">
  <div class="product">
    <div class="product__media-grid" aria-label="Product media">
      {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
          {%- liquid
            assign media_loading = 'lazy'
            if forloop.first
              assign media_loading = 'eager'
            endif
          -%}
          <div class="product__media-item" data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'image' -%}<button class="product__media-button" type="button" data-media-open data-src="{{ media | image_url: width: 2400 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="Enlarge {{ media.alt | default: product.title | escape }}">{{ media | image_url: width: 1600 | image_tag: widths: '480, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 55vw, 90vw', loading: media_loading, alt: media.alt | default: product.title }}</button>
              {%- when 'video' -%}{{ media | video_tag: controls: true, preload: 'metadata' }}
              {%- when 'external_video' -%}{{ media | external_video_tag }}
              {%- when 'model' -%}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- else -%}<div class="product__media-item placeholder-media">{{ 'product-1' | placeholder_svg_tag }}<span>Product image unavailable</span></div>{%- endif -%}
    </div>
    <div class="product__info">
      {%- form 'product', product, class: 'product__form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when '@app' -%}{% render block %}
              {%- when 'vendor' -%}{%- if product.vendor != blank -%}<p class="eyebrow">{{ product.vendor }}</p>{%- endif -%}
              {%- when 'title' -%}<h1 class="product__title">{{ product.title }}</h1>
              {%- when 'price' -%}<div class="price" aria-live="polite"><span class="price__current" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span>{%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}<s class="price__compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>{%- endif -%}</div>
              {%- when 'sku' -%}<div class="product__meta">{%- if block.settings.show_sku -%}<span>{{ 'products.product.sku' | t }}: <span data-sku>{{ product.selected_or_first_available_variant.sku | default: '—' }}</span></span>{%- endif -%}{%- if block.settings.show_barcode and product.selected_or_first_available_variant.barcode != blank -%}<span>Barcode: {{ product.selected_or_first_available_variant.barcode }}</span>{%- endif -%}</div>
              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}{%- for option in product.options_with_values -%}<fieldset class="variant-group" data-option-group><legend>{{ option.name }}</legend><div class="variant-options">{%- for value in option.values -%}<div class="variant-option"><input type="radio" id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="option-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}><label for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value }}</label></div>{%- endfor -%}</div></fieldset>{%- endfor -%}{%- endunless -%}
              {%- when 'quantity' -%}<label for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label><div class="quantity" data-quantity><button type="button" data-quantity-button="minus" aria-label="Decrease quantity">{% render 'icon', icon: 'minus' %}</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"><button type="button" data-quantity-button="plus" aria-label="Increase quantity">{% render 'icon', icon: 'plus' %}</button></div>
              {%- when 'buy_buttons' -%}<div class="product__buttons"><button class="button button--full" type="submit" name="add" data-add="{{ 'products.product.add_to_cart' | t }}" data-sold="{{ 'products.product.sold_out' | t }}" data-unavailable="{{ 'products.product.unavailable' | t }}"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>{%- if block.settings.dynamic_checkout -%}{{ form | payment_button }}{%- endif -%}</div>
              {%- when 'description' -%}{%- if product.description != blank -%}<div class="rte">{{ product.description }}</div>{%- elsif request.design_mode -%}<p class="muted">Add a verified product description in Shopify Admin.</p>{%- endif -%}
              {%- when 'trust' -%}{%- if block.settings.text != blank -%}<div class="feature"><strong>{{ block.settings.heading }}</strong><p class="muted">{{ block.settings.text }}</p></div>{%- endif -%}
              {%- when 'accordion' -%}{%- if block.settings.page != blank or block.settings.content != blank -%}<div class="product__accordions"><details class="product__accordion"><summary>{{ block.settings.heading }}</summary><div class="product__accordion-content rte">{%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- else -%}{{ block.settings.content }}{%- endif -%}</div></details></div>{%- endif -%}
              {%- when 'bulk' -%}{%- if block.settings.text != blank or block.settings.link != blank -%}<div class="bulk-callout" style="grid-template-columns:1fr;padding:1.5rem"><div><h3>{{ block.settings.heading }}</h3>{%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}</div>{%- if block.settings.label != blank and block.settings.link != blank -%}<a class="button button--accent" href="{{ block.settings.link }}">{{ block.settings.label }}</a>{%- endif -%}</div>{%- endif -%}
              {%- when 'custom_liquid' -%}{{ block.settings.custom_liquid }}\
              {%- comment -%}
  PASTE INTO sections/main-product.liquid (or your product info section)
  inside the {% case block.type %} / when list.
{%- endcomment -%}

{%- when 'curlear_showcase_snippet' -%}
  {% render 'curlear-showcase-snippet',
    heading: block.settings.heading,
    visible_desktop: block.settings.visible_desktop,
    auto_slide_speed: block.settings.auto_slide_speed,
    item_height_desktop: block.settings.item_height_desktop,
    item_height_mobile: block.settings.item_height_mobile,
    wider_desktop: block.settings.wider_desktop,
    media_1_image: block.settings.media_1_image,
    media_1_video: block.settings.media_1_video,
    media_2_image: block.settings.media_2_image,
    media_2_video: block.settings.media_2_video,
    media_3_image: block.settings.media_3_image,
    media_3_video: block.settings.media_3_video,
    media_4_image: block.settings.media_4_image,
    media_4_video: block.settings.media_4_video,
    media_5_image: block.settings.media_5_image,
    media_5_video: block.settings.media_5_video,
    media_6_image: block.settings.media_6_image,
    media_6_video: block.settings.media_6_video,
    media_7_image: block.settings.media_7_image,
    media_7_video: block.settings.media_7_video,
    media_8_image: block.settings.media_8_image,
    media_8_video: block.settings.media_8_video
  %}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      {%- endform -%}
      <script type="application/json" data-variants-json>[{%- for variant in product.variants -%}{"id":{{ variant.id | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"price_formatted":{{ variant.price | money | json }},"options":{{ variant.options | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]</script>
    </div>
  </div>
  {%- if section.settings.sticky_mobile -%}<div class="sticky-atc"><span><strong>{{ product.title | truncate: 24 }}</strong><br>{{ product.selected_or_first_available_variant.price | money }}</span><button class="button" type="button" data-sticky-add{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button></div>{%- endif -%}
  {%- if product.featured_image != blank -%}<dialog class="media-dialog" data-media-dialog><button class="icon-button media-dialog__close" type="button" data-media-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button><img src="{{ product.featured_image | image_url: width: 1600 }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" data-media-dialog-image></dialog>{%- endif -%}
</section>
{% schema %}
{"name":"Product information","settings":[{"type":"checkbox","id":"sticky_mobile","label":"Sticky mobile add to cart","default":true}],"blocks":[{"type":"@app"},{"type":"vendor","name":"Vendor","limit":1},{"type":"title","name":"Title","limit":1},{"type":"price","name":"Price","limit":1},{"type":"sku","name":"SKU and barcode","limit":1,"settings":[{"type":"checkbox","id":"show_sku","label":"Show SKU","default":true},{"type":"checkbox","id":"show_barcode","label":"Show barcode","default":false}]},
{
  "type": "curlear_showcase_snippet",
  "name": "Curlear showcase snippet",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it in action"
    },
    {
      "type": "range",
      "id": "visible_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Items visible on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "auto_slide_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Auto slide speed",
      "default": 4
    },
    {
      "type": "range",
      "id": "item_height_desktop",
      "min": 200,
      "max": 620,
      "step": 10,
      "unit": "px",
      "label": "Desktop media height",
      "default": 300
    },
    {
      "type": "range",
      "id": "item_height_mobile",
      "min": 220,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Mobile media height",
      "default": 320
    },
    {
      "type": "checkbox",
      "id": "wider_desktop",
      "label": "Slightly increase width on desktop",
      "default": false
    },
    { "type": "image_picker", "id": "media_1_image", "label": "Slide 1 image" },
    { "type": "video", "id": "media_1_video", "label": "Slide 1 Shopify video" },
    { "type": "image_picker", "id": "media_2_image", "label": "Slide 2 image" },
    { "type": "video", "id": "media_2_video", "label": "Slide 2 Shopify video" },
    { "type": "image_picker", "id": "media_3_image", "label": "Slide 3 image" },
    { "type": "video", "id": "media_3_video", "label": "Slide 3 Shopify video" },
    { "type": "image_picker", "id": "media_4_image", "label": "Slide 4 image" },
    { "type": "video", "id": "media_4_video", "label": "Slide 4 Shopify video" },
    { "type": "image_picker", "id": "media_5_image", "label": "Slide 5 image" },
    { "type": "video", "id": "media_5_video", "label": "Slide 5 Shopify video" },
    { "type": "image_picker", "id": "media_6_image", "label": "Slide 6 image" },
    { "type": "video", "id": "media_6_video", "label": "Slide 6 Shopify video" },
    { "type": "image_picker", "id": "media_7_image", "label": "Slide 7 image" },
    { "type": "video", "id": "media_7_video", "label": "Slide 7 Shopify video" },
    { "type": "image_picker", "id": "media_8_image", "label": "Slide 8 image" },
    { "type": "video", "id": "media_8_video", "label": "Slide 8 Shopify video" }
  ]
},
{"type":"variant_picker","name":"Variant picker","limit":1},{"type":"quantity","name":"Quantity","limit":1},{"type":"buy_buttons","name":"Buy buttons","limit":1,"settings":[{"type":"checkbox","id":"dynamic_checkout","label":"Show dynamic checkout","default":true}]},{"type":"description","name":"Description","limit":1},{"type":"trust","name":"Trust information","settings":[{"type":"text","id":"heading","label":"Heading","default":"Clear product information"},{"type":"textarea","id":"text","label":"Verified text"}]},{"type":"accordion","name":"Information accordion","settings":[{"type":"text","id":"heading","label":"Heading","default":"Materials & care"},{"type":"richtext","id":"content","label":"Verified content"},{"type":"page","id":"page","label":"Optional page content"}]},{"type":"bulk","name":"Bulk order callout","settings":[{"type":"text","id":"heading","label":"Heading","default":"Need this in larger quantities?"},{"type":"textarea","id":"text","label":"Verified text"},{"type":"text","id":"label","label":"Button label","default":"Request Bulk Information"},{"type":"url","id":"link","label":"Button link"}]},{"type":"custom_liquid","name":"Custom Liquid","settings":[{"type":"liquid","id":"custom_liquid","label":"Custom Liquid"}]}]}
{% endschema %}
