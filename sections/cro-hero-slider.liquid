{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
{{ 'cro-components.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cro-ui.js' | asset_url }}" defer="defer"></script>
{%- liquid
  case s.align
    when 'start'
      assign cro_justify = 'flex-start'
    when 'end'
      assign cro_justify = 'flex-end'
    else
      assign cro_justify = 'center'
  endcase
  assign cro_radius = s.radius | default: 16
  assign cro_btn_radius = s.button_radius | default: 10
-%}
{% style %}
#cro-{{ sid }} {
  --cro-bg: {{ s.bg_color | default: '#F7F1E7' }};
  --cro-heading: {{ s.heading_color | default: '#18231F' }};
  --cro-text: {{ s.text_color | default: '#3F4A45' }};
  --cro-accent: {{ s.accent_color | default: '#D4623D' }};
  --cro-btn-bg: {{ s.button_bg | default: '#173F35' }};
  --cro-btn-text: {{ s.button_text | default: '#FFFDF8' }};
  --cro-btn-hover-bg: {{ s.button_hover_bg | default: '#0F2F27' }};
  --cro-btn-hover-text: {{ s.button_hover_text | default: '#FFFFFF' }};
  --cro-link-hover: {{ s.link_hover_color | default: '#D4623D' }};
  --cro-border: {{ s.border_color | default: '#D7CEC1' }};
  --cro-card-bg: {{ s.card_bg | default: '#FFFDF8' }};
  --cro-icon: {{ s.icon_color | default: '#173F35' }};
  --cro-badge-bg: {{ s.badge_bg | default: '#C64F32' }};
  --cro-badge-text: {{ s.badge_text | default: '#FFFFFF' }};
  --cro-radius: {{ cro_radius }}px;
  --cro-justify: {{ cro_justify }};
  background: var(--cro-bg);
  color: var(--cro-text);
  padding-block: {{ s.padding_top_mobile | default: 40 }}px {{ s.padding_bottom_mobile | default: 40 }}px;
}
#cro-{{ sid }}[hidden] { display: none; }
#cro-{{ sid }} .cro-wrap { box-sizing: border-box; max-inline-size: {% if s.full_width %}none{% else %}{{ s.container_width | default: 1300 }}px{% endif %}; margin-inline: auto; padding-inline: var(--gutter, 16px); }
#cro-{{ sid }} .cro-head { display: flex; flex-direction: column; align-items: {{ cro_justify }}; gap: 8px; margin-block-end: 28px; text-align: {{ s.align | default: 'center' }}; }
#cro-{{ sid }} .cro-head--row { flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; text-align: start; }
#cro-{{ sid }} .cro-eyebrow { margin: 0; color: var(--cro-accent); font-weight: 700; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }
#cro-{{ sid }} .cro-h { margin: 0; color: var(--cro-heading); font-family: var(--font-heading); font-weight: var(--font-heading-weight, 700); font-size: {{ s.heading_size_mobile | default: 28 }}px; line-height: 1.15; }
#cro-{{ sid }} .cro-sub { margin: 0; max-inline-size: 680px; font-size: {{ s.text_size_mobile | default: 15 }}px; line-height: 1.55; }
#cro-{{ sid }} .cro-body { font-size: {{ s.text_size_mobile | default: 15 }}px; line-height: 1.55; }
#cro-{{ sid }} .cro-body > :first-child { margin-block-start: 0; }
#cro-{{ sid }} .cro-body > :last-child { margin-block-end: 0; }
#cro-{{ sid }} .cro-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-sizing: border-box;
  min-block-size: 48px; padding: 0 24px; border: 0; border-radius: {{ cro_btn_radius }}px;
  background: var(--cro-btn-bg); color: var(--cro-btn-text); font: inherit; font-weight: 700; line-height: 1.2;
  text-decoration: none; cursor: pointer; transition: background-color .2s ease, color .2s ease, transform .2s ease;
}
#cro-{{ sid }} .cro-btn:hover { background: var(--cro-btn-hover-bg); color: var(--cro-btn-hover-text); }
#cro-{{ sid }} .cro-btn[disabled] { opacity: .55; cursor: not-allowed; }
#cro-{{ sid }} .cro-btn--ghost { background: transparent; color: var(--cro-heading); box-shadow: inset 0 0 0 2px currentColor; }
#cro-{{ sid }} .cro-btn--ghost:hover { background: var(--cro-btn-bg); color: var(--cro-btn-text); box-shadow: none; }
#cro-{{ sid }} .cro-link { color: var(--cro-heading); text-decoration: underline; text-underline-offset: 4px; }
#cro-{{ sid }} .cro-link:hover { color: var(--cro-link-hover); }
#cro-{{ sid }} .cro-card { background: var(--cro-card-bg); border: 1px solid var(--cro-border); border-radius: var(--cro-radius); }
#cro-{{ sid }} .cro-ico { display: inline-flex; flex: none; align-items: center; justify-content: center; color: var(--cro-icon); }
#cro-{{ sid }} .cro-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; background: var(--cro-badge-bg); color: var(--cro-badge-text); font-size: 12px; font-weight: 700; letter-spacing: .03em; }
#cro-{{ sid }} a:focus-visible, #cro-{{ sid }} button:focus-visible, #cro-{{ sid }} summary:focus-visible, #cro-{{ sid }} input:focus-visible, #cro-{{ sid }} select:focus-visible { outline: 2px solid var(--cro-accent); outline-offset: 2px; }
@media (min-width: 750px) {
  #cro-{{ sid }} { padding-block: {{ s.padding_top_desktop | default: 64 }}px {{ s.padding_bottom_desktop | default: 64 }}px; }
  #cro-{{ sid }} .cro-h { font-size: {{ s.heading_size_desktop | default: 38 }}px; }
  #cro-{{ sid }} .cro-sub, #cro-{{ sid }} .cro-body { font-size: {{ s.text_size_desktop | default: 17 }}px; }
}



#cro-{{ sid }} { padding-block: {{ s.padding_top_mobile }}px {{ s.padding_bottom_mobile }}px; }
#cro-{{ sid }} .cro-hero { position: relative; overflow: hidden; border-radius: {% if s.full_width %}0{% else %}var(--cro-radius){% endif %}; }
#cro-{{ sid }} .cro-hero__slides { display: grid; }
#cro-{{ sid }} .cro-hero__slide { position: relative; grid-area: 1 / 1; display: grid; min-block-size: {{ s.height_mobile }}px; opacity: 0; visibility: hidden; transition: opacity .6s ease, visibility 0s linear .6s; }
#cro-{{ sid }} .cro-hero__slide.is-active { opacity: 1; visibility: visible; transition: opacity .6s ease, visibility 0s; }
#cro-{{ sid }} .cro-hero__media, #cro-{{ sid }} .cro-hero__media img, #cro-{{ sid }} .cro-hero__media video { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
#cro-{{ sid }} .cro-hero__overlay { position: absolute; inset: 0; }
#cro-{{ sid }} .cro-hero__content { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 14px; box-sizing: border-box; inline-size: 100%; max-inline-size: {{ s.container_width }}px; margin-inline: auto; padding: 32px var(--gutter, 16px) 56px; }
#cro-{{ sid }} .cro-hero__inner { display: flex; flex-direction: column; gap: 14px; max-inline-size: {{ s.content_width }}px; }
#cro-{{ sid }} .cro-hero__heading { margin: 0; font-family: var(--font-heading); font-weight: var(--font-heading-weight, 700); font-size: {{ s.heading_size_mobile }}px; line-height: 1.08; }
#cro-{{ sid }} .cro-hero__text { margin: 0; font-size: {{ s.text_size_mobile }}px; line-height: 1.5; }
#cro-{{ sid }} .cro-hero__eyebrow { margin: 0; font-weight: 700; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }
#cro-{{ sid }} .cro-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
#cro-{{ sid }} .cro-hero__ctrl { position: absolute; inset-block-end: 14px; inset-inline: 0; z-index: 2; display: flex; align-items: center; justify-content: center; gap: 6px; pointer-events: none; }
#cro-{{ sid }} .cro-hero__ctrl > * { pointer-events: auto; }
#cro-{{ sid }} .cro-hero__dot { inline-size: 44px; block-size: 44px; padding: 0; border: 0; background: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
#cro-{{ sid }} .cro-hero__dot::before { content: ""; inline-size: 10px; block-size: 10px; border-radius: 50%; background: rgba(255, 255, 255, .55); box-shadow: 0 0 0 1px rgba(0, 0, 0, .2); }
#cro-{{ sid }} .cro-hero__dot[aria-current="true"]::before { background: #fff; inline-size: 26px; border-radius: 6px; }
#cro-{{ sid }} .cro-hero__arrow, #cro-{{ sid }} .cro-hero__pause { display: inline-flex; align-items: center; justify-content: center; inline-size: 44px; block-size: 44px; border: 0; border-radius: 50%; background: rgba(255, 253, 248, .9); color: #18231F; cursor: pointer; }
#cro-{{ sid }} .cro-hero__pause[hidden] { display: none; }
@media (prefers-reduced-motion: reduce) { #cro-{{ sid }} .cro-hero__slide { transition: none; } }
@media (min-width: 750px) {
  #cro-{{ sid }} { padding-block: {{ s.padding_top_desktop }}px {{ s.padding_bottom_desktop }}px; }
  #cro-{{ sid }} .cro-hero__slide { min-block-size: {{ s.height_desktop }}px; }
  #cro-{{ sid }} .cro-hero__heading { font-size: {{ s.heading_size_desktop }}px; }
  #cro-{{ sid }} .cro-hero__text { font-size: {{ s.text_size_desktop }}px; }
  #cro-{{ sid }} .cro-hero__content { padding-block: 56px 72px; }
}
{%- for block in section.blocks -%}
{%- assign b = block.settings -%}
#cro-{{ sid }} .cro-hero__slide--{{ block.id }} { color: {{ b.text_color }}; }
#cro-{{ sid }} .cro-hero__slide--{{ block.id }} .cro-hero__overlay { background: {{ b.overlay_color }}; opacity: {{ b.overlay_opacity | divided_by: 100.0 }}; }
#cro-{{ sid }} .cro-hero__slide--{{ block.id }} .cro-hero__heading { color: {{ b.heading_color }}; }
#cro-{{ sid }} .cro-hero__slide--{{ block.id }} .cro-hero__eyebrow { color: {{ b.eyebrow_color }}; }
#cro-{{ sid }} .cro-hero__slide--{{ block.id }} .cro-hero__content { justify-content: {% case b.v_position %}{% when 'top' %}flex-start{% when 'bottom' %}flex-end{% else %}center{% endcase %}; align-items: {% case b.h_position %}{% when 'start' %}flex-start{% when 'end' %}flex-end{% else %}center{% endcase %}; text-align: {{ b.h_position }}; }
#cro-{{ sid }} .cro-hero__slide--{{ block.id }} .cro-hero__actions { justify-content: {% case b.h_position %}{% when 'start' %}flex-start{% when 'end' %}flex-end{% else %}center{% endcase %}; }
#cro-{{ sid }} .cro-hero__slide--{{ block.id }} .cro-hero__media img { object-position: {{ b.focal_x }}% {{ b.focal_y }}%; }
{%- endfor %}

{% endstyle %}

{%- if section.blocks.size > 0 -%}
<section id="cro-{{ sid }}" class="cro-hero-section" aria-roledescription="carousel" aria-label="{{ s.region_label | escape }}">
  <div class="{% unless s.full_width %}cro-wrap{% endunless %}">
    <div class="cro-hero" data-cro-hero data-autoplay="{{ s.autoplay }}" data-speed="{{ s.speed }}">
      <div class="cro-hero__slides">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="cro-hero__slide cro-hero__slide--{{ block.id }}{% if forloop.first %} is-active{% endif %}" data-cro-hero-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}"{% unless forloop.first %} aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
            <div class="cro-hero__media">
              {%- if b.video != blank -%}
                {{ b.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' }}
              {%- elsif b.image != blank -%}
                <picture>
                  {%- if b.mobile_image != blank -%}<source media="(max-width: 749px)" srcset="{{ b.mobile_image | image_url: width: 750 }} 750w, {{ b.mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">{%- endif -%}
                  {%- if forloop.first -%}
                    {{ b.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: b.alt }}
                  {%- else -%}
                    {{ b.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', loading: 'lazy', alt: b.alt }}
                  {%- endif -%}
                </picture>
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'cro-hero__placeholder' }}
              {%- endif -%}
            </div>
            <span class="cro-hero__overlay" aria-hidden="true"></span>
            <div class="cro-hero__content">
              <div class="cro-hero__inner">
                {%- if b.eyebrow != blank -%}<p class="cro-hero__eyebrow">{{ b.eyebrow | escape }}</p>{%- endif -%}
                {%- if b.heading != blank -%}{% if forloop.first %}<h2 class="cro-hero__heading">{{ b.heading | escape }}</h2>{% else %}<p class="cro-hero__heading">{{ b.heading | escape }}</p>{% endif %}{%- endif -%}
                {%- if b.text != blank -%}<p class="cro-hero__text">{{ b.text | escape }}</p>{%- endif -%}
                {%- if b.button_1_label != blank or b.button_2_label != blank -%}
                  <div class="cro-hero__actions">
                    {%- if b.button_1_label != blank -%}<a class="cro-btn{% if b.button_1_style == 'ghost' %} cro-btn--ghost{% endif %}" href="{{ b.button_1_link | default: routes.all_products_collection_url }}">{{ b.button_1_label | escape }}</a>{%- endif -%}
                    {%- if b.button_2_label != blank -%}<a class="cro-btn{% if b.button_2_style == 'ghost' %} cro-btn--ghost{% endif %}" href="{{ b.button_2_link | default: routes.collections_url }}">{{ b.button_2_label | escape }}</a>{%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="cro-hero__ctrl">
          {%- if s.show_arrows -%}<button class="cro-hero__arrow" type="button" data-cro-hero-prev aria-label="{{ s.prev_label | escape }}">{% render 'cro-icon', icon: 'chevron-left', size: 20 %}</button>{%- endif -%}
          {%- if s.show_dots -%}{%- for block in section.blocks -%}<button class="cro-hero__dot" type="button" data-cro-hero-dot aria-label="{{ s.dot_label | replace: '{n}', forloop.index | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}{%- endif -%}
          {%- if s.show_arrows -%}<button class="cro-hero__arrow" type="button" data-cro-hero-next aria-label="{{ s.next_label | escape }}">{% render 'cro-icon', icon: 'chevron-right', size: 20 %}</button>{%- endif -%}
          <button class="cro-hero__pause" type="button" data-cro-hero-pause aria-label="{{ s.pause_label | escape }}" hidden>❚❚</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CRO hero slider",
  "tag": "div",
  "class": "cro-section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true,
      "info": "Stops on hover/focus and for visitors who prefer reduced motion; a pause button is shown."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Time per slide",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Dots",
      "default": true
    },
    {
      "type": "text",
      "id": "region_label",
      "label": "Screen-reader label",
      "default": "Featured offers"
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous label",
      "default": "Previous slide"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next label",
      "default": "Next slide"
    },
    {
      "type": "text",
      "id": "dot_label",
      "label": "Dot label",
      "default": "Show slide {n}"
    },
    {
      "type": "text",
      "id": "pause_label",
      "label": "Pause label",
      "default": "Pause slideshow"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Content container width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "default": 1300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Text max width",
      "min": 320,
      "max": 900,
      "step": 20,
      "default": 620,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height (desktop)",
      "min": 320,
      "max": 900,
      "step": 20,
      "default": 600,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 280,
      "max": 800,
      "step": 20,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius (boxed)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 88,
      "step": 2,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 56,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text size (desktop)",
      "min": 12,
      "max": 26,
      "step": 1,
      "default": 19,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size (mobile)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Buttons",
      "info": "Keep text at a 4.5:1 contrast ratio or better against its background (WCAG AA)."
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#E8B44A"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button hover background",
      "default": "#D4623D"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button hover text",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Outline button colour",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Focus ring",
      "default": "#E8B44A"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#173F35"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (replaces image)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "range",
          "id": "focal_x",
          "label": "Focal point (horizontal)",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "focal_y",
          "label": "Focal point (vertical)",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 50,
          "unit": "%"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_1_label",
          "label": "Button 1 label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button 1 link"
        },
        {
          "type": "select",
          "id": "button_1_style",
          "label": "Button 1 style",
          "options": [
            {
              "value": "primary",
              "label": "Filled"
            },
            {
              "value": "ghost",
              "label": "Outline"
            }
          ],
          "default": "primary"
        },
        {
          "type": "text",
          "id": "button_2_label",
          "label": "Button 2 label"
