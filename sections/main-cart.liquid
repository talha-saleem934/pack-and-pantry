{% render 'breadcrumbs' %}
<section class="section section--compact page-width"><h1>{{ 'cart.general.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}{%- form 'cart', cart -%}<div class="cart-items">{%- for item in cart.items -%}<article class="cart-item">{%- if item.image -%}<a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: width: 110, height: 110, class: 'cart-item__image', loading: 'lazy', alt: item.image.alt | default: item.product.title }}</a>{%- endif -%}<div class="cart-item__details"><h2 style="font-size:1.1rem"><a href="{{ item.url }}">{{ item.product.title }}</a></h2>{%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}{%- if item.selling_plan_allocation -%}<p class="muted">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}{%- for property in item.properties -%}{%- assign first_character = property.first | slice: 0 -%}{%- unless property.last == blank or first_character == '_' -%}<p class="muted">{{ property.first }}: {{ property.last }}</p>{%- endunless -%}{%- endfor -%}<label for="Updates_{{ item.key }}">{{ 'products.product.quantity' | t }}</label><div class="quantity" data-quantity><button type="button" data-quantity-button="minus" aria-label="Decrease {{ item.product.title }} quantity">{% render 'icon', icon: 'minus' %}</button><input id="Updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><button type="button" data-quantity-button="plus" aria-label="Increase {{ item.product.title }} quantity">{% render 'icon', icon: 'plus' %}</button></div><a href="{{ item.url_to_remove }}" aria-label="{{ 'accessibility.remove' | t: title: item.product.title }}">Remove</a></div><div class="cart-item__price">{%- if item.original_line_price != item.final_line_price -%}<s>{{ item.original_line_price | money }}</s><br>{%- endif -%}<strong>{{ item.final_line_price | money }}</strong>{%- for discount in item.line_level_discount_allocations -%}<p class="muted">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>{%- endfor -%}</div></article>{%- endfor -%}</div><div class="cart-footer"><div class="field">{%- if section.settings.enable_note -%}<label for="CartNote">{{ 'cart.general.note' | t }}</label><textarea id="CartNote" name="note">{{ cart.note }}</textarea>{%- endif -%}</div><div class="cart-summary"><div class="cart-summary__line"><span>{{ 'cart.general.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>{%- for discount in cart.cart_level_discount_applications -%}<p>{{ discount.title }}: −{{ discount.total_allocated_amount | money }}</p>{%- endfor -%}<p class="muted">{{ 'cart.general.shipping_at_checkout' | t }}</p><button class="button button--secondary button--full" type="submit" name="update">{{ 'cart.general.update' | t }}</button><button class="button button--full" type="submit" name="checkout">{{ 'cart.general.checkout' | t }}</button><p class="text-center"><a href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a></p></div></div>{%- endform -%}
  {%- else -%}<div class="empty-state">{% render 'icon', icon: 'cart' %}<h2>{{ 'cart.general.empty' | t }}</h2><p>Explore jars, food storage and packaging solutions for your next shelf or order.</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a></div>{%- endif -%}
</section>
{% schema %}{"name":"Cart","settings":[{"type":"checkbox","id":"enable_note","label":"Enable order note","default":true}]}{% endschema %}
