<section class="section page-width"><header class="search-header"><h1>{% if search.performed %}{{ 'general.search.results_for' | t: terms: search.terms }}{% else %}{{ 'general.search.title' | t }}{% endif %}</h1><form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="visually-hidden" for="MainSearch">{{ 'general.search.title' | t }}</label><input class="input" id="MainSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}"><input type="hidden" name="options[prefix]" value="last"><button class="button" type="submit">{{ 'general.search.submit' | t }}</button></form></header>
  {%- if search.performed -%}{%- paginate search.results by section.settings.results_per_page -%}{%- if search.results_count > 0 -%}<p>{{ search.results_count }} results</p><div class="search-grid">{%- for item in search.results -%}{%- case item.object_type -%}{%- when 'product' -%}{% render 'product-card', card_product: item %}{%- when 'article' -%}<article class="card search-result"><p class="eyebrow">Article</p><h2 style="font-size:1.25rem"><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.excerpt_or_content | strip_html | truncate: 150 }}</p></article>{%- when 'page' -%}<article class="card search-result"><p class="eyebrow">Page</p><h2 style="font-size:1.25rem"><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.content | strip_html | truncate: 150 }}</p></article>{%- endcase -%}{%- endfor -%}</div>{% render 'pagination', paginate: paginate %}{%- else -%}<div class="empty-state"><h2>{{ 'general.search.no_results' | t: terms: search.terms }}</h2><a class="button" href="{{ routes.all_products_collection_url }}">View all products</a></div>{%- endif -%}{%- endpaginate -%}{%- endif -%}
</section>
{% schema %}{"name":"Search results","settings":[{"type":"range","id":"results_per_page","min":6,"max":30,"step":3,"label":"Results per page","default":18}]}{% endschema %}
