{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}
{{ 'cro-components.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cro-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cro-commerce.js' | asset_url }}" defer="defer"></script>
{%- liquid
  case s.align
    when 'start'
      assign cro_justify = 'flex-start'
    when 'end'
      assign cro_justify = 'flex-end'
    else
      assign cro_justify = 'center'
  endcase
  assign cro_radius = s.radius | default: 16
  assign cro_btn_radius = s.button_radius | default: 10
-%}
{% style %}
#cro-{{ sid }} {
  --cro-bg: {{ s.bg_color | default: '#F7F1E7' }};
  --cro-heading: {{ s.heading_color | default: '#18231F' }};
  --cro-text: {{ s.text_color | default: '#3F4A45' }};
  --cro-accent: {{ s.accent_color | default: '#D4623D' }};
  --cro-btn-bg: {{ s.button_bg | default: '#173F35' }};
  --cro-btn-text: {{ s.button_text | default: '#FFFDF8' }};
  --cro-btn-hover-bg: {{ s.button_hover_bg | default: '#0F2F27' }};
  --cro-btn-hover-text: {{ s.button_hover_text | default: '#FFFFFF' }};
  --cro-link-hover: {{ s.link_hover_color | default: '#D4623D' }};
  --cro-border: {{ s.border_color | default: '#D7CEC1' }};
  --cro-card-bg: {{ s.card_bg | default: '#FFFDF8' }};
  --cro-icon: {{ s.icon_color | default: '#173F35' }};
  --cro-badge-bg: {{ s.badge_bg | default: '#C64F32' }};
  --cro-badge-text: {{ s.badge_text | default: '#FFFFFF' }};
  --cro-radius: {{ cro_radius }}px;
  --cro-justify: {{ cro_justify }};
  background: var(--cro-bg);
  color: var(--cro-text);
  padding-block: {{ s.padding_top_mobile | default: 40 }}px {{ s.padding_bottom_mobile | default: 40 }}px;
}
#cro-{{ sid }}[hidden] { display: none; }
#cro-{{ sid }} .cro-wrap { box-sizing: border-box; max-inline-size: {% if s.full_width %}none{% else %}{{ s.container_width | default: 1300 }}px{% endif %}; margin-inline: auto; padding-inline: var(--gutter, 16px); }
#cro-{{ sid }} .cro-head { display: flex; flex-direction: column; align-items: {{ cro_justify }}; gap: 8px; margin-block-end: 28px; text-align: {{ s.align | default: 'center' }}; }
#cro-{{ sid }} .cro-head--row { flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; text-align: start; }
#cro-{{ sid }} .cro-eyebrow { margin: 0; color: var(--cro-accent); font-weight: 700; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; }
#cro-{{ sid }} .cro-h { margin: 0; color: var(--cro-heading); font-family: var(--font-heading); font-weight: var(--font-heading-weight, 700); font-size: {{ s.heading_size_mobile | default: 28 }}px; line-height: 1.15; }
#cro-{{ sid }} .cro-sub { margin: 0; max-inline-size: 680px; font-size: {{ s.text_size_mobile | default: 15 }}px; line-height: 1.55; }
#cro-{{ sid }} .cro-body { font-size: {{ s.text_size_mobile | default: 15 }}px; line-height: 1.55; }
#cro-{{ sid }} .cro-body > :first-child { margin-block-start: 0; }
#cro-{{ sid }} .cro-body > :last-child { margin-block-end: 0; }
#cro-{{ sid }} .cro-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; box-sizing: border-box;
  min-block-size: 48px; padding: 0 24px; border: 0; border-radius: {{ cro_btn_radius }}px;
  background: var(--cro-btn-bg); color: var(--cro-btn-text); font: inherit; font-weight: 700; line-height: 1.2;
  text-decoration: none; cursor: pointer; transition: background-color .2s ease, color .2s ease, transform .2s ease;
}
#cro-{{ sid }} .cro-btn:hover { background: var(--cro-btn-hover-bg); color: var(--cro-btn-hover-text); }
#cro-{{ sid }} .cro-btn[disabled] { opacity: .55; cursor: not-allowed; }
#cro-{{ sid }} .cro-btn--ghost { background: transparent; color: var(--cro-heading); box-shadow: inset 0 0 0 2px currentColor; }
#cro-{{ sid }} .cro-btn--ghost:hover { background: var(--cro-btn-bg); color: var(--cro-btn-text); box-shadow: none; }
#cro-{{ sid }} .cro-link { color: var(--cro-heading); text-decoration: underline; text-underline-offset: 4px; }
#cro-{{ sid }} .cro-link:hover { color: var(--cro-link-hover); }
#cro-{{ sid }} .cro-card { background: var(--cro-card-bg); border: 1px solid var(--cro-border); border-radius: var(--cro-radius); }
#cro-{{ sid }} .cro-ico { display: inline-flex; flex: none; align-items: center; justify-content: center; color: var(--cro-icon); }
#cro-{{ sid }} .cro-badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; background: var(--cro-badge-bg); color: var(--cro-badge-text); font-size: 12px; font-weight: 700; letter-spacing: .03em; }
#cro-{{ sid }} a:focus-visible, #cro-{{ sid }} button:focus-visible, #cro-{{ sid }} summary:focus-visible, #cro-{{ sid }} input:focus-visible, #cro-{{ sid }} select:focus-visible { outline: 2px solid var(--cro-accent); outline-offset: 2px; }
@media (min-width: 750px) {
  #cro-{{ sid }} { padding-block: {{ s.padding_top_desktop | default: 64 }}px {{ s.padding_bottom_desktop | default: 64 }}px; }
  #cro-{{ sid }} .cro-h { font-size: {{ s.heading_size_desktop | default: 38 }}px; }
  #cro-{{ sid }} .cro-sub, #cro-{{ sid }} .cro-body { font-size: {{ s.text_size_desktop | default: 17 }}px; }
}



#cro-{{ sid }} .cro-bundles { display: grid; gap: 20px; }
#cro-{{ sid }} .cro-bundle { display: grid; gap: 14px; padding: 18px; }
#cro-{{ sid }} .cro-bundle__img { inline-size: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: calc(var(--cro-radius) - 4px); }
#cro-{{ sid }} .cro-bundle__name { margin: 0; color: var(--cro-heading); font-family: var(--font-heading); font-size: 22px; }
#cro-{{ sid }} .cro-bundle__items { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
#cro-{{ sid }} .cro-bundle__item { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; align-items: center; gap: 10px; font-size: 14px; }
#cro-{{ sid }} .cro-bundle__item img { inline-size: 48px; block-size: 48px; border-radius: 8px; object-fit: cover; }
#cro-{{ sid }} .cro-bundle__item a { color: var(--cro-heading); font-weight: 700; text-decoration: none; }
#cro-{{ sid }} .cro-bundle__total { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; color: var(--cro-heading); font-size: 20px; font-weight: 700; }
#cro-{{ sid }} .cro-bundle__total s { color: var(--cro-text); font-size: 15px; font-weight: 400; }
@media (min-width: 750px) { #cro-{{ sid }} .cro-bundles { grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 3 }}, minmax(0, 1fr)); } }

{% endstyle %}

{%- if section.blocks.size > 0 -%}
<section id="cro-{{ sid }}" class="cro-bundle-offers" aria-labelledby="CroHeading-{{ sid }}">
  <div class="cro-wrap">
    {%- if s.eyebrow != blank or s.heading != blank or s.subheading != blank -%}
      <div class="cro-head">
        {%- if s.eyebrow != blank -%}<p class="cro-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="cro-h" id="CroHeading-{{ sid }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="cro-sub">{{ s.subheading | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="cro-bundles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign total = 0
          assign compare_total = 0
          assign all_ok = true
          assign items_json = ''
          assign count = 0
        -%}
        <article class="cro-bundle cro-card" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}{{ b.image | image_url: width: 900 | image_tag: class: 'cro-bundle__img', loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 33vw, 100vw', alt: b.image_alt }}{%- endif -%}
          {%- if b.badge != blank -%}<span class="cro-badge">{{ b.badge | escape }}</span>{%- endif -%}
          <h3 class="cro-bundle__name">{{ b.name | escape }}</h3>
          {%- if b.text != blank -%}<p class="cro-body">{{ b.text | escape }}</p>{%- endif -%}
          <ul class="cro-bundle__items" role="list">
            {%- for n in (1..4) -%}
              {%- assign key = 'product_' | append: n -%}
              {%- assign p = b[key] -%}
              {%- if p != blank -%}
                {%- assign v = p.selected_or_first_available_variant -%}
                {%- liquid
                  assign count = count | plus: 1
                  unless v.available
                    assign all_ok = false
                  endunless
                  assign total = total | plus: v.price
                  if v.compare_at_price > v.price
                    assign compare_total = compare_total | plus: v.compare_at_price
                  else
                    assign compare_total = compare_total | plus: v.price
                  endif
                  if items_json != ''
                    assign items_json = items_json | append: ','
                  endif
                  assign items_json = items_json | append: '{"id":' | append: v.id | append: ',"quantity":1}'
                -%}
                <li class="cro-bundle__item">
                  {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}{%- else -%}<span></span>{%- endif -%}
                  <a href="{{ p.url }}">{{ p.title | escape }}</a>
                  <span>{{ v.price | money }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if count > 0 -%}
            <p class="cro-bundle__total">{{ s.total_label | escape }} {{ total | money }}{%- if compare_total > total -%}<s>{{ compare_total | money }}</s>{%- endif -%}</p>
            {%- if b.price_text != blank -%}<p class="cro-body"><strong>{{ b.price_text | escape }}</strong></p>{%- endif -%}
            {%- if b.savings_text != blank -%}<span class="cro-badge">{{ b.savings_text | escape }}</span>{%- endif -%}
            <button class="cro-btn" type="button" data-cro-bundle-add data-source="bundle" data-items="[{{ items_json | escape }}]" data-loading="{{ s.loading_label | escape }}" data-success="{{ s.success_label | escape }}"{% unless all_ok %} disabled{% endunless %}>
              <span data-cro-btn-label>{% if all_ok %}{{ b.button_label | escape }}{% else %}{{ s.unavailable_label | escape }}{% endif %}</span>
            </button>
            <p class="cro-vh" data-cro-error hidden></p>
          {%- elsif request.design_mode -%}<p>{{ s.editor_note | escape }}</p>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "CRO bundle offers",
  "tag": "div",
  "class": "cro-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bundle and save"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready-made sets"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need for a tidy shelf, added in one tap."
    },
    {
      "type": "header",
      "content": "Pricing",
      "info": "The total is calculated from real product prices. To give an actual bundle discount, create a matching automatic discount in Shopify Admin → Discounts and describe it in the block text."
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Set total:"
    },
    {
      "type": "text",
      "id": "loading_label",
      "label": "Adding label",
      "default": "Adding…"
    },
    {
      "type": "text",
      "id": "success_label",
      "label": "Success label",
      "default": "Added to cart"
    },
    {
      "type": "text",
      "id": "unavailable_label",
      "label": "Unavailable label",
      "default": "Currently unavailable"
    },
    {
      "type": "text",
      "id": "editor_note",
      "label": "Theme editor note",
      "default": "Pick products for this bundle."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "default": 1300,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 16,
      "max": 72,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 56,
      "step": 2,
      "default": 26,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Body text size (desktop)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 17,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Body text size (mobile)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px"
