<section class="section" data-reveal>
  <div class="page-width narrow">
    <div class="section-heading"><div class="section-heading__text"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}</div></div>
    <div class="faq-list">{%- for block in section.blocks -%}<details class="faq-item" {{ block.shopify_attributes }}><summary>{{ block.settings.question }} <span aria-hidden="true">+</span></summary><div class="faq-item__content rte">{{ block.settings.answer }}</div></details>{%- endfor -%}</div>
  </div>
</section>
{% schema %}
{"name":"FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Good to know"},{"type":"text","id":"heading","label":"Heading","default":"Storage questions, neatly answered"},{"type":"textarea","id":"text","label":"Introduction","default":"Helpful starting points for choosing and ordering storage."}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How do I choose the right container size?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Use the capacity and dimensions shown on each product page, then contact us if you need help comparing options.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question","settings":{"question":"What materials are available?","answer":"<p>Materials vary by product. Check the verified details on the item you are considering.</p>"}},{"type":"question","settings":{"question":"Can I enquire about a larger order?","answer":"<p>Use the business enquiry form to share the products and quantities you are considering.</p>"}}]}]}
{% endschema %}
