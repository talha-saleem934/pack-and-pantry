<section class="section" data-reveal><div class="page-width narrow text-center"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p>{%- form 'customer', class: 'newsletter-form', style: 'max-width:580px;margin:1.5rem auto 0' -%}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="Newsletter-{{ section.id }}">{{ 'general.newsletter.email' | t }}</label><input class="input" id="Newsletter-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email' | t }}" required><button class="button" type="submit">{{ 'general.newsletter.submit' | t }}</button>{%- if form.posted_successfully? -%}<p class="form-message">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}{%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}{%- endform -%}</div></section>
{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Stay organised"},{"type":"text","id":"heading","label":"Heading","default":"Fresh ideas for shelves and small businesses"},{"type":"textarea","id":"text","label":"Text","default":"Receive product updates and practical storage inspiration. Add your privacy consent wording before publishing."}],"presets":[{"name":"Newsletter"}]}
{% endschema %}
