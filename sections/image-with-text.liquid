<section class="section scheme--{{ section.settings.scheme }}" data-reveal><div class="page-width"><div class="image-text{% if section.settings.layout == 'reverse' %} image-text--reverse{% endif %}"><div class="image-text__media media">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1500 | image_tag: widths: '540, 750, 1000, 1500', sizes: '(min-width:990px) 55vw, 100vw', loading: 'lazy', alt: section.settings.image_alt | default: section.settings.image.alt }}{%- else -%}<img src="{{ 'pantry-editorial.jpg' | asset_url }}" width="1500" height="1200" loading="lazy" alt="{{ section.settings.image_alt | escape }}">{%- endif -%}</div><div class="image-text__content"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.text }}</div>{%- if section.settings.button_label != blank -%}<p><a class="button button--secondary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} <span class="button__icon" aria-hidden="true">→</span></a></p>{%- endif -%}</div></div></div></section>
{% schema %}
{"name":"Image with text","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_alt","label":"Image alt text","default":"Glass jars and containers arranged on kitchen shelving"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Pantry inspiration"},{"type":"text","id":"heading","label":"Heading","default":"Make every shelf easier to manage"},{"type":"richtext","id":"text","label":"Text","default":"<p>Group everyday ingredients, make quantities easier to see and give each item a clear home. Check product pages for verified details before choosing.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Organise your pantry"},{"type":"url","id":"button_link","label":"Button link"},{"type":"select","id":"layout","label":"Image position","default":"normal","options":[{"value":"normal","label":"Left"},{"value":"reverse","label":"Right"}]},{"type":"select","id":"scheme","label":"Colour scheme","default":"cream","options":[{"value":"cream","label":"Oat cream"},{"value":"white","label":"Warm white"},{"value":"sage","label":"Sage"}]}],"presets":[{"name":"Image with text"}]}
{% endschema %}
