<section class="section page-width">
  <div class="section-heading"><div><p class="eyebrow">Browse Pack & Pantry</p><h1>{{ section.settings.heading }}</h1></div></div>
  {%- paginate collections by section.settings.per_page -%}
    <div class="grid grid--3">
      {%- for collection in collections -%}
        <a class="category-card card media" href="{{ collection.url }}">
          {%- if collection.image -%}
            {{ collection.image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: collection.image.alt | default: collection.title }}
          {%- elsif collection.products.first.featured_image -%}
            {{ collection.products.first.featured_image | image_url: width: 1000 | image_tag: widths: '360, 540, 720, 1000', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: collection.title }}
          {%- else -%}
            <div class="collection-placeholder">Collection image unavailable</div>
          {%- endif -%}
          <div class="category-card__content"><h2 style="font-size:1.5rem">{{ collection.title }}</h2><p>{{ collection.products_count }} products</p></div>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>
{% schema %}{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop all collections"},{"type":"range","id":"per_page","min":6,"max":24,"step":3,"label":"Collections per page","default":12}]}{% endschema %}
