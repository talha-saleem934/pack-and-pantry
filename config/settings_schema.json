[
  {
    "name": "theme_info",
    "theme_name": "Pack & Pantry",
    "theme_version": "2.0.0",
    "theme_author": "Pack & Pantry",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Main logo" },
      { "type": "image_picker", "id": "logo_light", "label": "Light logo" },
      { "type": "image_picker", "id": "logo_mobile", "label": "Mobile logo" },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" },
      { "type": "text", "id": "logo_alt", "label": "Logo alt text", "default": "Pack & Pantry" },
      { "type": "range", "id": "logo_width", "min": 100, "max": 280, "step": 10, "unit": "px", "label": "Desktop logo width", "default": 180 },
      { "type": "range", "id": "logo_width_mobile", "min": 90, "max": 220, "step": 10, "unit": "px", "label": "Mobile logo width", "default": 140 }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_primary", "label": "Pantry green", "default": "#173F35" },
      { "type": "color", "id": "color_primary_hover", "label": "Deep green hover", "default": "#0F2F27" },
      { "type": "color", "id": "color_secondary", "label": "Golden oat", "default": "#E8B44A" },
      { "type": "color", "id": "color_accent", "label": "Warm clay accent", "default": "#D4623D" },
      { "type": "color", "id": "color_promotion", "label": "Sale and promotion", "default": "#C64F32" },
      { "type": "color", "id": "color_background", "label": "Oat background", "default": "#F7F1E7" },
      { "type": "color", "id": "color_alternate", "label": "Sage background", "default": "#DCE8D8" },
      { "type": "color", "id": "color_surface", "label": "Warm card surface", "default": "#FFFDF8" },
      { "type": "color", "id": "color_heading", "label": "Heading text", "default": "#18231F" },
      { "type": "color", "id": "color_text", "label": "Body text", "default": "#3F4A45" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#637069" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#D7CEC1" },
      { "type": "color", "id": "color_success", "label": "Success", "default": "#2F6F4E" },
      { "type": "color", "id": "color_warning", "label": "Warning", "default": "#A05A00" },
      { "type": "color", "id": "color_error", "label": "Error", "default": "#A72C2C" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "aleo_n7" },
      { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" }
    ]
  },
  {
    "name": "Layout and product cards",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1100, "max": 1600, "step": 50, "unit": "px", "label": "Page width", "default": 1300 },
      { "type": "range", "id": "card_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Card corner radius", "default": 16 },
      { "type": "range", "id": "section_spacing", "min": 40, "max": 120, "step": 5, "unit": "px", "label": "Desktop section spacing", "default": 90 },
      { "type": "checkbox", "id": "enable_reveal", "label": "Enable subtle section reveals", "default": true },
      { "type": "select", "id": "motion_level", "label": "Animation level", "default": "subtle", "options": [
        { "value": "none", "label": "None" }, { "value": "subtle", "label": "Subtle" }, { "value": "expressive", "label": "Expressive" }
      ] },
      { "type": "select", "id": "product_image_ratio", "label": "Product image ratio", "default": "portrait", "options": [
        { "value": "adapt", "label": "Adapt to image" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }
      ] },
      { "type": "checkbox", "id": "show_second_image", "label": "Show second product image on hover", "default": true },
      { "type": "checkbox", "id": "show_vendor_cards", "label": "Show vendor on product cards", "default": false }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "url", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest URL" }
    ]
  }
]
