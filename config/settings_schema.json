[
  {
    "name": "theme_info",
    "theme_name": "Pack & Pantry",
    "theme_version": "2.0.0",
    "theme_author": "Pack & Pantry",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Main logo" },
      { "type": "image_picker", "id": "logo_light", "label": "Light logo" },
      { "type": "image_picker", "id": "logo_mobile", "label": "Mobile logo" },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" },
      { "type": "text", "id": "logo_alt", "label": "Logo alt text", "default": "Pack & Pantry" },
      { "type": "range", "id": "logo_width", "min": 100, "max": 280, "step": 10, "unit": "px", "label": "Desktop logo width", "default": 180 },
      { "type": "range", "id": "logo_width_mobile", "min": 90, "max": 220, "step": 10, "unit": "px", "label": "Mobile logo width", "default": 140 }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_primary", "label": "Pantry green", "default": "#173F35" },
      { "type": "color", "id": "color_primary_hover", "label": "Deep green hover", "default": "#0F2F27" },
      { "type": "color", "id": "color_secondary", "label": "Golden oat", "default": "#E8B44A" },
      { "type": "color", "id": "color_accent", "label": "Warm clay accent", "default": "#D4623D" },
      { "type": "color", "id": "color_promotion", "label": "Sale and promotion", "default": "#C64F32" },
      { "type": "color", "id": "color_background", "label": "Oat background", "default": "#F7F1E7" },
      { "type": "color", "id": "color_alternate", "label": "Sage background", "default": "#DCE8D8" },
      { "type": "color", "id": "color_surface", "label": "Warm card surface", "default": "#FFFDF8" },
      { "type": "color", "id": "color_heading", "label": "Heading text", "default": "#18231F" },
      { "type": "color", "id": "color_text", "label": "Body text", "default": "#3F4A45" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#637069" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#D7CEC1" },
      { "type": "color", "id": "color_success", "label": "Success", "default": "#2F6F4E" },
      { "type": "color", "id": "color_warning", "label": "Warning", "default": "#A05A00" },
      { "type": "color", "id": "color_error", "label": "Error", "default": "#A72C2C" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "aleo_n7" },
      { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" }
    ]
  },
  {
    "name": "Layout and product cards",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1100, "max": 1600, "step": 50, "unit": "px", "label": "Page width", "default": 1300 },
      { "type": "range", "id": "card_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "Card corner radius", "default": 16 },
      { "type": "range", "id": "section_spacing", "min": 20, "max": 120, "step": 5, "unit": "px", "label": "Desktop section spacing", "default": 90 },
      { "type": "checkbox", "id": "enable_reveal", "label": "Enable subtle section reveals", "default": true },
      { "type": "select", "id": "motion_level", "label": "Animation level", "default": "subtle", "options": [
        { "value": "none", "label": "None" }, { "value": "subtle", "label": "Subtle" }, { "value": "expressive", "label": "Expressive" }
      ] },
      { "type": "select", "id": "product_image_ratio", "label": "Product image ratio", "default": "portrait", "options": [
        { "value": "adapt", "label": "Adapt to image" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }
      ] },
      { "type": "checkbox", "id": "show_second_image", "label": "Show second product image on hover", "default": true },
      { "type": "checkbox", "id": "show_vendor_cards", "label": "Show vendor on product cards", "default": false }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "url", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest URL" }
    ]
  }
  ,
  {
    "name": "CRO & conversion",
    "settings": [
      { "type": "header", "content": "Contact and support", "info": "Defaults for every CRO section. A section can override them in its own settings." },
      { "type": "text", "id": "cro_whatsapp_number", "label": "WhatsApp number", "info": "International format, digits only, e.g. 923001234567." },
      { "type": "textarea", "id": "cro_whatsapp_greeting", "label": "Default WhatsApp message", "default": "Hi Pack & Pantry, I have a question about {product}.", "info": "{product} becomes the product title on product pages (shop name elsewhere); {url} becomes the page link." },
      { "type": "text", "id": "cro_support_phone", "label": "Support phone", "info": "As it should be dialled, e.g. +92 300 1234567." },
      { "type": "text", "id": "cro_support_email", "label": "Support email" },
      { "type": "header", "content": "Delivery and dispatch", "info": "Replace these with your verified delivery policy before enabling any section that shows them." },
      { "type": "number", "id": "cro_free_delivery_threshold", "label": "Free-delivery threshold", "default": 5000, "info": "Plain amount in your store currency, e.g. 5000. 0 turns free-delivery messaging off. Must match your shipping rates." },
      { "type": "number", "id": "cro_delivery_min_days", "label": "Delivery time: minimum working days", "default": 2 },
      { "type": "number", "id": "cro_delivery_max_days", "label": "Delivery time: maximum working days", "default": 5 },
      { "type": "range", "id": "cro_dispatch_cutoff_hour", "label": "Daily dispatch cut-off hour", "min": 0, "max": 23, "step": 1, "default": 14, "info": "24-hour clock in the shop timezone. Used by 'daily dispatch cut-off' countdowns." },
      { "type": "text", "id": "cro_excluded_weekdays", "label": "Non-dispatch weekdays", "default": "Sun", "info": "Comma separated: Mon, Tue, Wed, Thu, Fri, Sat, Sun." },
      { "type": "textarea", "id": "cro_holidays", "label": "Non-dispatch dates", "info": "Public holidays and closures. One per line or comma separated, format YYYY-MM-DD." },
      { "type": "text", "id": "cro_timezone", "label": "Shop timezone", "default": "Asia/Karachi", "info": "IANA timezone name. Countdowns and delivery dates are calculated in this zone." },
      { "type": "header", "content": "Stock and urgency" },
      { "type": "range", "id": "cro_low_stock_threshold", "label": "Low-stock threshold", "min": 1, "max": 50, "step": 1, "default": 5, "info": "Only used for variants whose inventory is tracked and cannot be oversold." },
      { "type": "color", "id": "cro_urgency_color", "label": "Urgency colour", "default": "#C64F32" },
      { "type": "header", "content": "Payment methods", "info": "Turn on only the methods you actually accept. Used by payment-icon strips." },
      { "type": "checkbox", "id": "cro_pay_cod", "label": "Cash on delivery", "default": false },
      { "type": "checkbox", "id": "cro_pay_visa", "label": "Visa", "default": false },
      { "type": "checkbox", "id": "cro_pay_mastercard", "label": "Mastercard", "default": false },
      { "type": "checkbox", "id": "cro_pay_jazzcash", "label": "JazzCash", "default": false },
      { "type": "checkbox", "id": "cro_pay_easypaisa", "label": "Easypaisa", "default": false },
      { "type": "checkbox", "id": "cro_pay_bank", "label": "Bank transfer", "default": false },
      { "type": "header", "content": "Policy pages" },
      { "type": "page", "id": "cro_page_shipping", "label": "Shipping / delivery page" },
      { "type": "page", "id": "cro_page_returns", "label": "Returns and exchanges page" },
      { "type": "page", "id": "cro_page_privacy", "label": "Privacy page" },
      { "type": "header", "content": "Sale countdown (all sections)", "info": "When on, every countdown in every section uses this time instead of its own. Sections whose countdown is set to None stay without one." },
      { "type": "checkbox", "id": "cro_cd_override", "label": "Use one countdown time across the store", "default": false },
      { "type": "select", "id": "cro_cd_mode", "label": "Countdown type", "default": "fixed", "options": [ { "value": "fixed", "label": "Offer ends at a date and time" }, { "value": "daily", "label": "Daily dispatch cut-off" }, { "value": "evergreen", "label": "Per-visitor timer" } ] },
      { "type": "text", "id": "cro_cd_end", "label": "End date and time", "placeholder": "2026-12-02 23:59", "info": "Format YYYY-MM-DD HH:MM in the shop timezone. Set it to when the offer really ends." },
      { "type": "range", "id": "cro_cd_hours", "label": "Per-visitor timer length", "min": 1, "max": 72, "step": 1, "unit": "h", "default": 24 },
      { "type": "text", "id": "cro_cd_fallback", "label": "Text shown before the timer loads", "info": "e.g. 'Sale ends 2 December'." },
      { "type": "header", "content": "Measurement" },
      { "type": "checkbox", "id": "cro_enable_analytics", "label": "Send CRO events to the data layer", "default": false, "info": "Only pushes events when window.dataLayer already exists. No tracking code is added." }
    ]
  }
]
