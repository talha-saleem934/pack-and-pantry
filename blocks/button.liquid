{%- if block.settings.label != blank -%}<a class="button{% if block.settings.style == 'secondary' %} button--secondary{% elsif block.settings.style == 'accent' %} button--accent{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }} <span aria-hidden="true">→</span></a>{%- endif -%}
{% schema %}{"name":"Button","settings":[{"type":"text","id":"label","label":"Label","default":"Shop storage"},{"type":"url","id":"link","label":"Link"},{"type":"select","id":"style","label":"Style","default":"primary","options":[{"value":"primary","label":"Primary"},{"value":"secondary","label":"Secondary"},{"value":"accent","label":"Accent"}]}],"presets":[{"name":"Button"}]}{% endschema %}
