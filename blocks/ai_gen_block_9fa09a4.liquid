      "default": 12
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color",
      "default": "#E8B44A"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "aleo_n7"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Font size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "color",
      "id": "heading_color",
