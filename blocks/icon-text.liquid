<div class="theme-block theme-block--icon-text" {{ block.shopify_attributes }}><span class="theme-block__icon" aria-hidden="true">{{ block.settings.icon }}</span><div>{%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}{%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}</div></div>
{% schema %}{"name":"Icon with text","settings":[{"type":"text","id":"icon","label":"Short icon character","default":"✓"},{"type":"text","id":"heading","label":"Heading","default":"Made easier to compare"},{"type":"textarea","id":"text","label":"Text","default":"Use verified product details to find the right option."}],"presets":[{"name":"Icon with text"}]}{% endschema %}
