{% doc %}
  @prompt
    Create a full-width responsive image-banner hero section using my uploaded image. Add separate desktop and mobile image pickers, focal-point control, adjustable height, optional overlay, alt text and optional button link. Show the desktop image in its natural wide ratio without unnecessary cropping. Add a subtle fade-in animation, reduced-motion support and no slider or extra text by default.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-banner__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.desktop_height }}px;
  }

  .ai-hero-banner__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-hero-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.focal_point_x }}% {{ block.settings.focal_point_y }}%;
    display: block;
  }

  .ai-hero-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #F7F1E7;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-hero-banner__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    font-size: 14px;
    color: #637069;
    text-align: center;
    pointer-events: none;
    font-family: {{ settings.body_font.family }}, sans-serif;
  }

  .ai-hero-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-hero-banner__content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .ai-hero-banner__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 8px;
    font-family: {{ settings.body_font.family }}, sans-serif;
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.3s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .ai-hero-banner__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ai-hero-banner__image-{{ ai_gen_id }} {
      animation: ai-hero-fade-in-{{ ai_gen_id }} 1s ease-out;
    }

    @keyframes ai-hero-fade-in-{{ ai_gen_id }} {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hero-banner__container-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_height }}px;
    }

    .ai-hero-banner__content-{{ ai_gen_id }} {
      bottom: 24px;
    }

    .ai-hero-banner__button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }

    .ai-hero-banner__empty-state-{{ ai_gen_id }} {
      bottom: 24px;
      font-size: 13px;
    }
  }
{% endstyle %}

<hero-banner-{{ ai_gen_id }} class="ai-hero-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-banner__container-{{ ai_gen_id }}">
    <div class="ai-hero-banner__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.desktop_image != blank %}
        <picture>
          {% if block.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                      {{ block.settings.mobile_image | image_url: width: 1500 }} 1500w"
            >
          {% endif %}
          <img
            src="{{ block.settings.desktop_image | image_url: width: 1920 }}"
            srcset="{{ block.settings.desktop_image | image_url: width: 1200 }} 1200w,
                    {{ block.settings.desktop_image | image_url: width: 1600 }} 1600w,
                    {{ block.settings.desktop_image | image_url: width: 1920 }} 1920w,
                    {{ block.settings.desktop_image | image_url: width: 2400 }} 2400w"
            sizes="100vw"
            alt="{{ block.settings.image_alt | escape }}"
            width="{{ block.settings.desktop_image.width }}"
            height="{{ block.settings.desktop_image.height }}"
            loading="eager"
            class="ai-hero-banner__image-{{ ai_gen_id }}"
          >
        </picture>
      {% else %}
        <div class="ai-hero-banner__placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-hero-banner__empty-state-{{ ai_gen_id }}">
            Add your hero image to get started
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.enable_overlay %}
      <div class="ai-hero-banner__overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.button_link != blank and block.settings.button_text != blank %}
      <div class="ai-hero-banner__content-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_link }}" class="ai-hero-banner__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</hero-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('hero-banner-{{ ai_gen_id }}', HeroBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Hero image banner",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Hero banner"
    },
    {
      "type": "header",
      "content": "Focal point"
    },
    {
      "type": "range",
      "id": "focal_point_x",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_point_y",
      "label": "Vertical position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#173F35"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background",
      "default": "#0F2F27"
    }
  ],
  "presets": [
    {
      "name": "Hero image banner"
    }
  ]
}
{% endschema %}
