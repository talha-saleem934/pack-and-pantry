{% doc %}
  @prompt
    Create a full-width responsive image-banner hero section using my uploaded image. Add separate desktop and mobile image pickers, focal-point control, adjustable height, optional overlay, alt text and optional button link. Show the desktop image in its natural wide ratio without unnecessary cropping. Add a subtle fade-in animation, reduced-motion support and no slider or extra text by default.
    Update: add "adapt to image" height option for desktop and mobile, and make it a slider (up to 5 slides) with autoplay, slide time and fade / slide / rotate animation.
{% enddoc %}
{%- liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase

  assign slide_count = 0
  for i in (1..5)
    if i == 1
      assign d_key = 'desktop_image'
      assign m_key = 'mobile_image'
    else
      assign d_key = 'desktop_image_' | append: i
      assign m_key = 'mobile_image_' | append: i
    endif
    if block.settings[d_key] != blank or block.settings[m_key] != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign has_nav = false
  if slide_count > 1
    assign has_nav = true
  endif

  assign autoplay = false
  if block.settings.autoplay and has_nav
    assign autoplay = true
  endif

  assign show_dots = false
  if block.settings.show_dots and has_nav
    assign show_dots = true
  endif

  assign btn_bottom_d = 40
  assign btn_bottom_m = 24
  if show_dots
    assign btn_bottom_d = 56
    assign btn_bottom_m = 44
  endif

  assign anim = block.settings.animation | default: 'fade'
  assign speed = block.settings.transition_speed | default: 800
  assign delay = block.settings.autoplay_speed | default: 5
-%}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
    --hb-speed: {{ speed }}ms;
    --hb-ctrl: {{ block.settings.controls_color }};
    --hb-h-d: {{ block.settings.desktop_height }}px;
    --hb-h-m: {{ block.settings.mobile_height }}px;
    --hb-btn-bottom: {{ btn_bottom_d }}px;
    --hb-pos: {{ block.settings.focal_point_x }}% {{ block.settings.focal_point_y }}%;
  }

  /* Viewport: all slides stack in one grid cell */
  .ai-hero-banner-{{ ai_gen_id }} .hb-viewport {
    display: grid;
    width: 100%;
    overflow: hidden;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-viewport.is-ready {
    transition: height var(--hb-speed) ease;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-slide {
    grid-area: 1 / 1;
    position: relative;
    width: 100%;
    align-self: start;
    visibility: hidden;
    transition: opacity var(--hb-speed) ease, transform var(--hb-speed) ease;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-slide.is-active,
  .ai-hero-banner-{{ ai_gen_id }} .hb-slide.is-leaving,
  .ai-hero-banner-{{ ai_gen_id }} .hb-slide.is-entering {
    visibility: visible;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-slide.is-active {
    z-index: 1;
  }

  /* Default = adapt to image (natural ratio, no cropping) */
  .ai-hero-banner-{{ ai_gen_id }} .hb-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-placeholder {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 6;
    background-color: #F7F1E7;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-placeholder svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-empty {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 24px;
    font-size: 14px;
    color: #637069;
    text-align: center;
    pointer-events: none;
    font-family: {{ settings.body_font.family }}, sans-serif;
  }

  /* Animations */
  .ai-hero-banner-{{ ai_gen_id }}[data-animation="fade"] .hb-slide {
    opacity: 0;
  }
  .ai-hero-banner-{{ ai_gen_id }}[data-animation="fade"] .hb-slide.is-active {
    opacity: 1;
  }

  .ai-hero-banner-{{ ai_gen_id }}[data-animation="rotate"] .hb-slide {
    opacity: 0;
    transform: rotate(-6deg) scale(1.15);
  }
  .ai-hero-banner-{{ ai_gen_id }}[data-animation="rotate"] .hb-slide.is-active {
    opacity: 1;
    transform: none;
  }
  .ai-hero-banner-{{ ai_gen_id }}[data-animation="rotate"] .hb-slide.is-leaving {
    transform: rotate(6deg) scale(0.9);
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-overlay {
    position: absolute;
    inset: 0;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-content {
    position: absolute;
    bottom: var(--hb-btn-bottom);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-button {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: 8px;
    font-family: {{ settings.body_font.family }}, sans-serif;
    font-size: 16px;
    font-weight: 600;
    transition: background-color 0.3s ease, transform 0.2s ease;
    white-space: nowrap;
  }

  .ai-hero-banner-{{ ai_gen_id }} .hb-button:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  /* Controls */
  .ai-hero-banner-{{ ai_gen_id }} .hb-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    color: var(--hb-ctrl);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .ai-hero-banner-{{ ai_gen_id }} .hb-arrow:hover {
    background: rgba(0, 0, 0, 0.6);
  }
  .ai-hero-banner-{{ ai_gen_id }} .hb-arrow--prev { left: 16px; }
  .ai-hero-banner-{{ ai_gen_id }} .hb-arrow--next { right: 16px; }

  .ai-hero-banner-{{ ai_gen_id }} .hb-dots {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .ai-hero-banner-{{ ai_gen_id }} .hb-dot {
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--hb-ctrl);
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .ai-hero-banner-{{ ai_gen_id }} .hb-dot[aria-current="true"] {
    opacity: 1;
    transform: scale(1.2);
  }
  .ai-hero-banner-{{ ai_gen_id }} .hb-arrow:focus-visible,
  .ai-hero-banner-{{ ai_gen_id }} .hb-dot:focus-visible,
  .ai-hero-banner-{{ ai_gen_id }} .hb-button:focus-visible {
    outline: 2px solid var(--hb-ctrl);
    outline-offset: 2px;
  }

  /* Desktop: custom height */
  @media screen and (min-width: 750px) {
    .ai-hero-banner-{{ ai_gen_id }}[data-desktop-fit="custom"] .hb-viewport {
      height: var(--hb-h-d);
    }
    .ai-hero-banner-{{ ai_gen_id }}[data-desktop-fit="custom"] .hb-slide {
      height: 100%;
      align-self: stretch;
    }
    .ai-hero-banner-{{ ai_gen_id }}[data-desktop-fit="custom"] .hb-img,
    .ai-hero-banner-{{ ai_gen_id }}[data-desktop-fit="custom"] .hb-placeholder {
      height: 100%;
      aspect-ratio: auto;
    }
    .ai-hero-banner-{{ ai_gen_id }}[data-desktop-fit="custom"] .hb-img {
      object-fit: cover;
      object-position: var(--hb-pos);
    }
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .ai-hero-banner-{{ ai_gen_id }} {
      --hb-btn-bottom: {{ btn_bottom_m }}px;
    }
    .ai-hero-banner-{{ ai_gen_id }}[data-mobile-fit="custom"] .hb-viewport {
      height: var(--hb-h-m);
    }
    .ai-hero-banner-{{ ai_gen_id }}[data-mobile-fit="custom"] .hb-slide {
      height: 100%;
      align-self: stretch;
    }
    .ai-hero-banner-{{ ai_gen_id }}[data-mobile-fit="custom"] .hb-img,
    .ai-hero-banner-{{ ai_gen_id }}[data-mobile-fit="custom"] .hb-placeholder {
      height: 100%;
      aspect-ratio: auto;
    }
    .ai-hero-banner-{{ ai_gen_id }}[data-mobile-fit="custom"] .hb-img {
      object-fit: cover;
      object-position: var(--hb-pos);
    }
    .ai-hero-banner-{{ ai_gen_id }} .hb-button {
      padding: 12px 24px;
      font-size: 14px;
    }
    .ai-hero-banner-{{ ai_gen_id }} .hb-empty {
      bottom: 24px;
      font-size: 13px;
    }
    .ai-hero-banner-{{ ai_gen_id }} .hb-arrow--prev { left: 8px; }
    .ai-hero-banner-{{ ai_gen_id }} .hb-arrow--next { right: 8px; }
    {%- unless block.settings.show_arrows_mobile %}
    .ai-hero-banner-{{ ai_gen_id }} .hb-arrow { display: none; }
    {%- endunless %}
  }

  @media (prefers-reduced-motion: no-preference) {
    .ai-hero-banner-{{ ai_gen_id }} .hb-viewport {
      animation: ai-hero-fade-in-{{ ai_gen_id }} 1s ease-out;
    }

    @keyframes ai-hero-fade-in-{{ ai_gen_id }} {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-hero-banner-{{ ai_gen_id }} .hb-viewport,
    .ai-hero-banner-{{ ai_gen_id }} .hb-slide,
    .ai-hero-banner-{{ ai_gen_id }} .hb-button,
    .ai-hero-banner-{{ ai_gen_id }} .hb-dot {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstyle %}

<hero-banner-{{ ai_gen_id }}
  class="ai-hero-banner-{{ ai_gen_id }}"
  data-desktop-fit="{{ block.settings.desktop_height_mode | default: 'adapt' }}"
  data-mobile-fit="{{ block.settings.mobile_height_mode | default: 'adapt' }}"
  data-animation="{{ anim }}"
  data-speed="{{ speed }}"
  data-delay="{{ delay }}"
  data-autoplay="{{ autoplay }}"
  data-pause-hover="{{ block.settings.pause_on_hover }}"
  {{ block.shopify_attributes }}
>
  <div class="hb-viewport">
    {%- if slide_count == 0 -%}
      <div class="hb-slide is-active">
        <div class="hb-placeholder">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="hb-empty">Add your hero image to get started</div>
        </div>
      </div>
    {%- else -%}
      {%- assign rendered = 0 -%}
      {%- for i in (1..5) -%}
        {%- liquid
          if i == 1
            assign d_key = 'desktop_image'
            assign m_key = 'mobile_image'
            assign a_key = 'image_alt'
            assign t_key = 'button_text'
            assign l_key = 'button_link'
          else
            assign d_key = 'desktop_image_' | append: i
            assign m_key = 'mobile_image_' | append: i
            assign a_key = 'image_alt_' | append: i
            assign t_key = 'button_text_' | append: i
            assign l_key = 'button_link_' | append: i
          endif
          assign d_img = block.settings[d_key]
          assign m_img = block.settings[m_key]
          assign alt = block.settings[a_key]
          assign btn_text = block.settings[t_key]
          assign btn_link = block.settings[l_key]
          if d_img == blank
            assign d_img = m_img
          endif
          if m_img == blank
            assign m_img = d_img
          endif
        -%}
        {%- if d_img != blank -%}
          {%- assign rendered = rendered | plus: 1 -%}
          <div
            class="hb-slide{% if rendered == 1 %} is-active{% endif %}"
            {% unless rendered == 1 %}aria-hidden="true"{% endunless %}
          >
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="{{ m_img | image_url: width: 750 }} 750w,
                        {{ m_img | image_url: width: 1500 }} 1500w"
                sizes="100vw"
                width="{{ m_img.width }}"
                height="{{ m_img.height }}"
              >
              <img
                class="hb-img"
                src="{{ d_img | image_url: width: 1920 }}"
                srcset="{{ d_img | image_url: width: 1200 }} 1200w,
                        {{ d_img | image_url: width: 1600 }} 1600w,
                        {{ d_img | image_url: width: 1920 }} 1920w,
                        {{ d_img | image_url: width: 2400 }} 2400w"
                sizes="100vw"
                alt="{{ alt | escape }}"
                width="{{ d_img.width }}"
                height="{{ d_img.height }}"
                {% if rendered == 1 %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
              >
            </picture>

            {%- if block.settings.enable_overlay -%}
              <div class="hb-overlay"></div>
            {%- endif -%}

            {%- if btn_link != blank and btn_text != blank -%}
              <div class="hb-content">
                <a href="{{ btn_link }}" class="hb-button">{{ btn_text }}</a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if has_nav -%}
    <button type="button" class="hb-arrow hb-arrow--prev" data-hb-prev aria-label="Previous slide">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" class="hb-arrow hb-arrow--next" data-hb-next aria-label="Next slide">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  {%- endif -%}

  {%- if show_dots -%}
    <div class="hb-dots">
      {%- for i in (1..slide_count) -%}
        <button
          type="button"
          class="hb-dot"
          data-hb-dot="{{ forloop.index0 }}"
          aria-label="Go to slide {{ i }}"
          {% if forloop.first %}aria-current="true"{% endif %}
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</hero-banner-{{ ai_gen_id }}>

<script>
  (function () {
    var tag = 'hero-banner-{{ ai_gen_id }}';
    if (customElements.get(tag)) return;

    customElements.define(tag, class extends HTMLElement {
      connectedCallback() {
        var self = this;
        this.viewport = this.querySelector('.hb-viewport');
        this.slides = Array.prototype.slice.call(this.querySelectorAll('.hb-slide'));
        this.dots = Array.prototype.slice.call(this.querySelectorAll('.hb-dot'));
        this.index = 0;
        this.timer = null;
        this.finishTimer = null;
        this.paused = false;
        this.animation = this.dataset.animation || 'fade';
        this.speed = parseInt(this.dataset.speed, 10) || 800;
        this.delay = (parseInt(this.dataset.delay, 10) || 5) * 1000;
        this.mobileMq = window.matchMedia('(max-width: 749px)');
        this.reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.autoplay = this.dataset.autoplay === 'true' && this.slides.length > 1 && !this.reduceMq.matches;

        this.onResize = function () { self.syncHeight(); };
        window.addEventListener('resize', this.onResize);

        this.slides.forEach(function (slide) {
          var img = slide.querySelector('img');
          if (img && !img.complete) img.addEventListener('load', function () { self.syncHeight(); });
        });

        this.syncHeight();
        requestAnimationFrame(function () { self.viewport.classList.add('is-ready'); });

        if (this.slides.length < 2) return;

        var prev = this.querySelector('[data-hb-prev]');
        var next = this.querySelector('[data-hb-next]');
        if (prev) prev.addEventListener('click', function () { self.prev(); });
        if (next) next.addEventListener('click', function () { self.next(); });
        this.dots.forEach(function (dot) {
          dot.addEventListener('click', function () {
            var to = parseInt(dot.getAttribute('data-hb-dot'), 10);
            self.goTo(to, to > self.index ? 1 : -1);
          });
        });

        // Swipe
        var startX = null;
        this.viewport.addEventListener('touchstart', function (e) { startX = e.touches[0].clientX; }, { passive: true });
        this.viewport.addEventListener('touchend', function (e) {
          if (startX === null) return;
          var dx = e.changedTouches[0].clientX - startX;
          startX = null;
          if (Math.abs(dx) > 50) { dx < 0 ? self.next() : self.prev(); }
        });

        if (this.autoplay) {
          if (this.dataset.pauseHover === 'true') {
            this.addEventListener('mouseenter', function () { self.paused = true; self.stop(); });
            this.addEventListener('mouseleave', function () { self.paused = false; self.start(); });
          }
          this.addEventListener('focusin', function () { self.paused = true; self.stop(); });
          this.addEventListener('focusout', function () { self.paused = false; self.start(); });
          this.onVisibility = function () { document.hidden ? self.stop() : self.start(); };
          document.addEventListener('visibilitychange', this.onVisibility);
          this.start();
        }
      }

      disconnectedCallback() {
        this.stop();
        clearTimeout(this.finishTimer);
        window.removeEventListener('resize', this.onResize);
        if (this.onVisibility) document.removeEventListener('visibilitychange', this.onVisibility);
      }

      syncHeight() {
        var fit = this.mobileMq.matches ? this.dataset.mobileFit : this.dataset.desktopFit;
        var active = this.slides[this.index];
        this.viewport.style.height = (fit !== 'custom' && active) ? active.offsetHeight + 'px' : '';
      }

      start() {
        var self = this;
        this.stop();
        if (!this.autoplay || this.paused) return;
        this.timer = setTimeout(function () { self.next(); }, this.delay);
      }

      stop() {
        clearTimeout(this.timer);
      }

      next() { this.goTo((this.index + 1) % this.slides.length, 1); }
      prev() { this.goTo((this.index - 1 + this.slides.length) % this.slides.length, -1); }

      finish() {
        clearTimeout(this.finishTimer);
        this.slides.forEach(function (s) {
          s.classList.remove('is-leaving', 'is-entering');
          s.style.transform = '';
          s.style.transition = '';
        });
      }

      goTo(to, dir) {
        var self = this;
        if (to === this.index) return;
        this.finish();

        var cur = this.slides[this.index];
        var nxt = this.slides[to];
        var instant = this.reduceMq.matches;

        if (this.animation === 'slide' && !instant) {
          nxt.style.transition = 'none';
          nxt.style.transform = 'translateX(' + (dir * 100) + '%)';
          nxt.classList.add('is-entering');
          void nxt.offsetWidth;
          nxt.style.transition = '';
          nxt.style.transform = 'translateX(0)';
          cur.style.transform = 'translateX(' + (-dir * 100) + '%)';
        }

        cur.classList.remove('is-active');
        cur.classList.add('is-leaving');
        cur.setAttribute('aria-hidden', 'true');
        nxt.classList.add('is-active');
        nxt.removeAttribute('aria-hidden');

        this.index = to;
        this.dots.forEach(function (dot, i) {
          if (i === to) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        this.syncHeight();

        this.finishTimer = setTimeout(function () { self.finish(); }, instant ? 0 : this.speed + 50);
        this.start();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Hero image banner",
  "settings": [
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "select",
      "id": "desktop_height_mode",
      "label": "Desktop height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "custom", "label": "Custom height" }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop custom height",
      "info": "Only used when Desktop height is set to Custom.",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "select",
      "id": "mobile_height_mode",
      "label": "Mobile height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "custom", "label": "Custom height" }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile custom height",
      "info": "Only used when Mobile height is set to Custom.",
      "min": 200,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Focal point (custom height only)"
    },
    {
      "type": "range",
      "id": "focal_point_x",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_point_y",
      "label": "Vertical position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide time",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Slide animation",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Slide" },
        { "value": "rotate", "label": "Rotate" }
      ],
      "default": "fade"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Animation duration",
      "min": 300,
      "max": 1500,
      "step": 100,
      "unit": "ms",
      "default": 800
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
