{%- unless template.name == 'index' -%}
  <nav class="breadcrumbs page-width" aria-label="Breadcrumbs"><ol><li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
    {%- case template.name -%}
      {%- when 'product' -%}{%- if collection -%}<li><a href="{{ collection.url }}">{{ collection.title }}</a></li>{%- endif -%}<li aria-current="page">{{ product.title }}</li>
      {%- when 'collection' -%}<li aria-current="page">{{ collection.title }}</li>
      {%- when 'article' -%}<li><a href="{{ blog.url }}">{{ blog.title }}</a></li><li aria-current="page">{{ article.title }}</li>
      {%- when 'blog' -%}<li aria-current="page">{{ blog.title }}</li>
      {%- when 'page' -%}<li aria-current="page">{{ page.title }}</li>
      {%- when 'cart' -%}<li aria-current="page">{{ 'cart.general.title' | t }}</li>
    {%- endcase -%}</ol></nav>
{%- endunless -%}
