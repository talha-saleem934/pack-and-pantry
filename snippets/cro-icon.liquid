{%- comment -%}
  CRO icon. Priority: uploaded image > text/emoji > built-in SVG.
  Params:
    icon  - built-in name (truck, shield, cash, refresh, lock, star, whatsapp, gift, clock, tag, heart, check,
            phone, box, leaf, award, sparkle, percent, mail, map-pin, thumbs-up, package, camera, play, flame,
            plus utility: close, chevron-left, chevron-right, chevron-up)
    image - image object (optional)
    text  - emoji / short text (optional)
    size  - pixel size, default 24
    class - extra class (optional)
  Always decorative (aria-hidden); give the parent control an accessible name.
{%- endcomment -%}
{%- liquid
  assign cro_icon_size = size | default: 24
  assign cro_icon_class = class | default: ''
-%}
{%- if image != blank -%}
  {{- image | image_url: width: 160 | image_tag: width: cro_icon_size, height: cro_icon_size, loading: 'lazy', alt: '', class: 'cro-icon-img' -}}
{%- elsif text != blank -%}
  <span class="cro-icon-text {{ cro_icon_class }}" style="font-size:{{ cro_icon_size | times: 0.85 | round }}px" aria-hidden="true">{{ text | escape }}</span>
{%- elsif icon != blank and icon != 'none' -%}
  <svg class="cro-icon {{ cro_icon_class }}" width="{{ cro_icon_size }}" height="{{ cro_icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'truck' -%}<path d="M1 4h13v11H1zM14 8h4l3 4v3h-7"/><circle cx="5.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/>
      {%- when 'shield' -%}<path d="M12 2 4 5v6c0 5 3.4 9.2 8 11 4.6-1.8 8-6 8-11V5z"/><path d="m9 12 2 2 4-4"/>
      {%- when 'cash' -%}<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6 10v4M18 10v4"/>
      {%- when 'refresh' -%}<path d="M21 12a9 9 0 0 1-15.5 6.2L3 16M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5M3 21v-5h5"/>
      {%- when 'lock' -%}<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
      {%- when 'star' -%}<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/>
      {%- when 'whatsapp' -%}<path d="M3.5 20.5 4.9 16A8.5 8.5 0 1 1 8.2 19.2z"/><path d="M9.2 8.3c.2-.4.6-.5.9-.3l1 .9c.3.3.3.7.1 1l-.5.6a5.2 5.2 0 0 0 2.8 2.8l.6-.5c.3-.2.7-.2 1 .1l.9 1c.2.3.1.7-.3.9-1 .6-2.3.6-3.6-.1a8 8 0 0 1-3-3c-.7-1.3-.7-2.6-.1-3.6z"/>
      {%- when 'gift' -%}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8S10.5 3 8 4s0 4 4 4zM12 8s1.5-5 4-4 0 4-4 4z"/>
      {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
      {%- when 'tag' -%}<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>
      {%- when 'heart' -%}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8z"/>
      {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
      {%- when 'phone' -%}<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>
      {%- when 'box' -%}<path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5M12 13v8"/>
      {%- when 'leaf' -%}<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.1-6"/>
      {%- when 'award' -%}<circle cx="12" cy="8" r="6"/><path d="M8.2 13.2 7 22l5-3 5 3-1.2-8.8"/>
      {%- when 'sparkle' -%}<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9zM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>
      {%- when 'percent' -%}<path d="M19 5 5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>
      {%- when 'mail' -%}<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>
      {%- when 'map-pin' -%}<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>
      {%- when 'thumbs-up' -%}<path d="M7 10v12M15 5.9 14 10h5.8a2 2 0 0 1 2 2.3l-1.4 8A2 2 0 0 1 18.4 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.8a2 2 0 0 0 1.8-1.1L12 2a3.1 3.1 0 0 1 3 3.9z"/>
      {%- when 'package' -%}<path d="M16.5 9.4 7.5 4.2M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/>
      {%- when 'camera' -%}<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>
      {%- when 'play' -%}<circle cx="12" cy="12" r="10"/><path d="m10 8 6 4-6 4z"/>
      {%- when 'flame' -%}<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.4-.5-2-1-3-1.1-2.1-.2-4 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.2.4-2.3 1-3.3.3 1.7 1.5 2.8 2.5 2.8z"/>
      {%- when 'close' -%}<path d="M18 6 6 18M6 6l12 12"/>
      {%- when 'chevron-left' -%}<path d="m15 18-6-6 6-6"/>
      {%- when 'chevron-right' -%}<path d="m9 18 6-6-6-6"/>
      {%- when 'chevron-up' -%}<path d="m18 15-6-6-6 6"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
